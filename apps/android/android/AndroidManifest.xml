<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode and versionName are the app's version. Bump both for every build that
     leaves the machine; build.sh refuses to build when versionName and Cargo.toml disagree. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.marcusrosado.anibeam"
    android:versionCode="4"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No Java or Kotlin: the whole app is libanibeam.so behind the stock NativeActivity.
         enableOnBackInvokedCallback="false" keeps Back arriving as a key, which the app
         turns into "go to Next up"; with targetSdk 36 the system would finish the
         activity instead. -->
    <application
        android:label="AniBeam"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AniBeam"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="anibeam" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
