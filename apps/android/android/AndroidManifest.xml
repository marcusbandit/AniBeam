<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode and versionName are the app's version. Bump both for every build that
     leaves the machine; build.sh refuses to build when versionName and Cargo.toml disagree. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.marcusrosado.anibeam"
    android:versionCode="39"
    android:versionName="2.4.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi or mobile data: downloads wait for Wi-Fi unless the person allowed data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The download service: a foreground dataSync service and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Casting: finding Chromecasts and TVs on the Wi-Fi with mDNS and SSDP. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- The app is libanibeam.so and libmpv behind the stock NativeActivity, plus a Java
         service and the player's screen calls.
         enableOnBackInvokedCallback="false" keeps Back arriving as a key, which the app
         turns into "go to Next up"; with targetSdk 36 the system would finish the
         activity instead. -->
    <application
        android:label="AniBeam"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AniBeam"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="anibeam" />
        </activity>
        <!-- The launcher icons, one alias each over the activity. More's App icon turns one
             on and the rest off (Icons.java); the name is what it switches by. -->
        <activity-alias
            android:name="com.marcusrosado.anibeam.IconDefault"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.marcusrosado.anibeam.IconDark"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_launcher_dark"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.marcusrosado.anibeam.IconLine"
            android:targetActivity="android.app.NativeActivity"
            android:icon="@mipmap/ic_launcher_line"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- The download service: it only holds a notification so Android keeps the process,
             and the downloads in it, running with the screen off. -->
        <service
            android:name="com.marcusrosado.anibeam.TorrentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
