<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop's icon (apps/linux/assets/icon.svg) as an adaptive icon: the yellow
     ground is the background layer, the glyph sits in the middle 62 of 108 dp, inside the 66 dp every mask keeps. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_ground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
