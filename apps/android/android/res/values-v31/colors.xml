<?xml version="1.0" encoding="utf-8"?>
<!-- The line art icon in the phone's Material You colours, the pair Android's own themed
     icons use. The launcher resolves these when it draws, so the icon follows a new
     wallpaper. -->
<resources>
    <color name="line_ground">@android:color/system_accent1_100</color>
    <color name="line_ink">@android:color/system_neutral2_700</color>
</resources>
