// Airing now on the phone: the desktop's page at phone size. The season, a filter, the
// episodes out in the last two days, and every show on air as a poster. A tap on one offers
// Plan to watch, Get episodes and Not interested; Not interested can be taken back for a
// few seconds, and goes to the computer as well.

import { Theme } from "theme.slint";
import { AppData, Nav } from "data.slint";
import { FindData } from "find.slint";
import { Area, Fold } from "fold.slint";
import { CalendarHead } from "calhead.slint";
import { Leaf, Scroll } from "panes.slint";
import { Button, Chip, EmptyNote, SectionHead, Segmented, TileGrid, TileRow } from "widgets.slint";
import { Tr } from "tr.slint";

// The season picker: any season back to 1940, which the desktop's SeasonPicker lists.
export global AiringPick {
    in-out property <bool> open;
    // The season showing, "Spring 2019", or "" for this one.
    in property <string> showing;
    // The year and quarter this moment is in; the quarter carries a dot.
    in property <int> this-year;
    in property <int> this-quarter;
    // The year the list opens on: the showing season's, else this one.
    in property <int> focus-year;
    // The years to list, newest first.
    in property <[int]> years;
    // A quarter, 0 Winter to 3 Fall, of a year.
    callback picked(int, int);
}

// One filter as a row of the side pane's list, lit when picked.
component FilterRow inherits Rectangle {
    in property <string> text;
    in property <bool> picked;
    callback clicked();
    height: Theme.touch;
    border-radius: self.height / 2;
    background: root.picked ? Theme.accent-soft : touch.pressed ? Theme.pressed : transparent;
    border-width: root.picked ? 1px : 0;
    border-color: Theme.accent-edge;
    Text {
        x: Theme.unit * 5;
        width: parent.width - 2 * self.x;
        text: root.text;
        color: root.picked ? Theme.accent : Theme.text;
        font-family: root.picked ? Theme.strong-face : Theme.face;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The season and the filter. Folded the filters are a row of chips; in a side pane, where
// a row would be cut short, they are a list.
export component AiringControls inherits VerticalLayout {
    in property <bool> listed;
    spacing: Theme.unit * 3;
    Segmented {
        options: AppData.airing-seasons;
        picked: AppData.airing-season;
        pick(i) => {
            if (i == 2) {
                AiringPick.open = true;
            } else {
                AppData.pick-airing-season(i);
            }
        }
    }
    if root.listed: VerticalLayout {
        spacing: Theme.unit;
        for f[i] in AppData.airing-filters: FilterRow {
            text: f;
            picked: i == AppData.airing-filter;
            clicked => { AppData.pick-airing-filter(i); }
        }
    }
    if !root.listed: Rectangle {
        height: chips.preferred-height;
        Flickable {
            content-width: Math.max(self.width, chips.preferred-width);
            interactive: chips.preferred-width > self.width;
            chips := HorizontalLayout {
                spacing: Theme.unit * 1.5;
                alignment: start;
                for f[i] in AppData.airing-filters: Chip {
                    text: f;
                    selected: i == AppData.airing-filter;
                    tappable: true;
                    clicked => { AppData.pick-airing-filter(i); }
                }
            }
        }
    }
    if AppData.airing-line != "": Text {
        text: AppData.airing-line;
        color: Theme.dim;
        font-size: Theme.small;
        wrap: word-wrap;
    }
}

// Out now: the last two days' episodes, newest first. A row folded; in a side pane, with
// the height to spare, a grid.
export component OutNow inherits VerticalLayout {
    in property <bool> grid;
    in property <length> fit-width: self.width;
    spacing: Theme.unit * 3;
    if AppData.airing-out.length > 0: SectionHead {
        title: Tr.t("phone-airing-out-now");
        note: Tr.t("airing-last-two-days");
    }
    if AppData.airing-out.length > 0 && root.grid: TileGrid {
        fit-width: root.fit-width;
        tile-min: 100px;
        tiles: AppData.airing-out;
        open(id) => { AppData.airing-tap(id); }
    }
    if AppData.airing-out.length > 0 && !root.grid: TileRow {
        tiles: AppData.airing-out;
        tile-width: 100px;
        open(id) => { AppData.airing-tap(id); }
    }
}

// Every show on air.
export component AiringGrid inherits VerticalLayout {
    in property <length> fit-width: self.width;
    spacing: Theme.unit * 3;
    if AppData.airing-tiles.length == 0 && AppData.airing-filter == 0: Text {
        text: Tr.t("airing-season-note");
        color: Theme.faint;
        font-size: Theme.small + 1px;
    }
    if AppData.airing-tiles.length > 0: TileGrid {
        fit-width: root.fit-width;
        tiles: AppData.airing-tiles;
        open(id) => { AppData.airing-tap(id); }
        held(id, title) => { AppData.airing-tap(id); }
    }
    if AppData.airing-tiles.length == 0 && AppData.airing-filter > 0: EmptyNote {
        title: AppData.airing-filter == 1 ? Tr.t("airing-none-lists-title") : Tr.t("airing-none-phone-title");
        body: AppData.airing-filter == 1 ? Tr.t("airing-none-lists-body") : Tr.t("airing-none-phone-body");
    }
}

// A line that can be taken back for a few seconds: a show marked not interested, an
// episode mark. Undo shows while `can-undo` is set.
export component UndoBar inherits Rectangle {
    in property <string> text;
    in property <bool> can-undo: true;
    callback undo();
    height: row.preferred-height;
    background: Theme.float;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line-strong;
    TouchArea { }
    row := HorizontalLayout {
        padding: Theme.unit * 3;
        padding-left: Theme.unit * 4;
        spacing: Theme.unit * 3;
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: Theme.small + 0.5px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if root.can-undo: VerticalLayout {
            alignment: center;
            Button {
                text: Tr.t("phone-airing-undo");
                icon: @image-url("icons/rotate-ccw.svg");
                has-icon: true;
                small: true;
                clicked => { root.undo(); }
            }
        }
    }
}

// A show tapped: a sheet from the foot, the same glass as the other sheets.
export component AiringSheet inherits Rectangle {
    in property <length> inset-bottom;
    background: #000000b0;
    TouchArea { clicked => { AppData.airing-close(); } }
    Rectangle {
        x: Fold.sheet-x + Theme.grout;
        width: Fold.sheet-width - 2 * Theme.grout;
        y: parent.height - self.height - root.inset-bottom - Theme.grout;
        height: body.preferred-height;
        background: Theme.float;
        border-radius: Theme.radius + 6px;
        border-width: 1px;
        border-color: Theme.line-strong;
        TouchArea { }
        body := VerticalLayout {
            padding: Theme.pad;
            padding-top: Theme.pad + Theme.unit;
            spacing: Theme.unit * 3;
            Text {
                text: AppData.airing-menu.title;
                color: Theme.text;
                font-size: Theme.section;
                font-family: Theme.display-face;
                wrap: word-wrap;
            }
            Rectangle { height: Theme.unit; }
            if !AppData.airing-menu.listed: Button {
                text: Tr.t("airing-plan");
                icon: @image-url("icons/check-check.svg");
                has-icon: true;
                primary: true;
                clicked => { AppData.airing-plan(AppData.airing-menu.id); }
            }
            Button {
                text: AppData.airing-menu.owned >= 0 ? Tr.t("airing-get-more") : Tr.t("airing-get");
                icon: @image-url("icons/download.svg");
                has-icon: true;
                primary: AppData.airing-menu.listed;
                clicked => {
                    if (AppData.airing-menu.owned >= 0) {
                        FindData.find-series(AppData.airing-menu.owned);
                    } else {
                        AppData.airing-get(AppData.airing-menu.id);
                    }
                    AppData.airing-close();
                    Nav.page = 2;
                }
            }
            Button {
                text: Tr.t("phone-airing-not-interested");
                icon: @image-url("icons/x.svg");
                has-icon: true;
                clicked => { AppData.airing-dismiss(AppData.airing-menu.id); }
            }
            Button {
                text: Tr.t("common-cancel");
                clicked => { AppData.airing-close(); }
            }
        }
    }
}

// Any season: a sheet of years, newest first, each a row of its four quarters. It opens on
// the season showing, or this year, and scrolls all the way back to 1940. The season
// showing is in the accent and the quarter this moment falls in carries a dot.
export component SeasonSheet inherits Rectangle {
    in property <length> inset-bottom;
    background: #000000b0;
    TouchArea { clicked => { AiringPick.open = false; } }
    property <length> row-h: 12 * Theme.unit;
    property <[string]> names: [Tr.t("season-winter"), Tr.t("season-spring"), Tr.t("season-summer"), Tr.t("season-fall")];
    Rectangle {
        x: Fold.sheet-x + Theme.grout;
        width: Fold.sheet-width - 2 * Theme.grout;
        height: Math.min(parent.height - root.inset-bottom - 2 * Theme.grout - 12 * Theme.unit, 120 * Theme.unit);
        y: parent.height - self.height - root.inset-bottom - Theme.grout;
        background: Theme.float;
        border-radius: Theme.radius + 6px;
        border-width: 1px;
        border-color: Theme.line-strong;
        clip: true;
        TouchArea { }
        VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.unit * 2;
            Text {
                text: Tr.t("season-pick");
                color: Theme.text;
                font-size: Theme.section;
                font-family: Theme.display-face;
            }
            Flickable {
                content-height: years-column.preferred-height;
                init => {
                    // Scrolled so the season showing, else this year, is a few rows down.
                    self.content-y = Math.min(0px, 3 * root.row-h - (AiringPick.years.length > 0 ? (AiringPick.years[0] - AiringPick.focus-year) * root.row-h : 0px));
                }
                years-column := VerticalLayout {
                for year in AiringPick.years: Rectangle {
                    height: root.row-h;
                    HorizontalLayout {
                        spacing: Theme.unit;
                        Text {
                            width: 15 * Theme.unit;
                            text: year;
                            color: year == AiringPick.this-year ? Theme.text : Theme.faint;
                            font-family: Theme.figure;
                            font-size: Theme.small + 1px;
                            vertical-alignment: center;
                        }
                        for name[q] in root.names: Rectangle {
                            // seasons.rs words the showing season the same way, so the two read equal.
                            property <bool> on: AiringPick.showing == Tr.s2("season-named", "season", name, "year", "" + year);
                            property <bool> here: year == AiringPick.this-year && q == AiringPick.this-quarter;
                            height: Theme.touch;
                            y: (parent.height - self.height) / 2;
                            border-radius: self.height / 2;
                            background: on ? Theme.accent-soft : cell.pressed ? Theme.pressed : transparent;
                            border-width: on ? 1px : 0;
                            border-color: Theme.accent-edge;
                            if here: Rectangle {
                                x: 2 * Theme.unit;
                                y: (parent.height - self.height) / 2;
                                width: 1.5 * Theme.unit;
                                height: self.width;
                                border-radius: self.width / 2;
                                background: Theme.accent;
                            }
                            Text {
                                text: name;
                                color: on ? Theme.accent : Theme.dim;
                                font-size: Theme.small;
                                font-family: on ? Theme.strong-face : Theme.face;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            cell := TouchArea {
                                clicked => {
                                    AiringPick.open = false;
                                    AiringPick.picked(q, year);
                                }
                            }
                        }
                    }
                }
                }
            }
        }
    }
}

// Folded, one column; open or half folded, the season, filter and Out now pick on the left,
// the shows fill the right.
export component AiringPage inherits Rectangle {
    if !Fold.split: Scroll {
        pad-bottom: Theme.pad * 2 + (AppData.airing-undo != "" ? 20 * Theme.unit : 0);
        CalendarHead { }
        AiringControls { }
        OutNow { }
        AiringGrid { }
    }
    if Fold.split: Leaf {
        area: Fold.pick(0.38);
        Scroll {
            CalendarHead { }
            AiringControls { listed: true; }
            OutNow {
                grid: true;
                fit-width: Fold.inner(Fold.pick(0.38));
            }
        }
    }
    if Fold.split: Leaf {
        area: Fold.show(0.38);
        Scroll {
            pad-bottom: Theme.pad * 2 + (AppData.airing-undo != "" ? 20 * Theme.unit : 0);
            AiringGrid { fit-width: Fold.inner(Fold.show(0.38)); }
        }
    }
    if AppData.airing-undo != "": UndoBar {
        text: Tr.s("airing-marked", "title", AppData.airing-undo);
        undo => { AppData.airing-take-back(); }
        property <Area> area: Fold.show(0.38);
        x: self.area.x + Theme.grout;
        width: self.area.width - 2 * Theme.grout;
        y: parent.height - self.height - Theme.grout;
    }
}
