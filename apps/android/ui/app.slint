import { Theme } from "theme.slint";
import { AppData, Day, EpisodeLine, Hero, RuleRow, SeriesHead, Shelf, Tile, TorrentRow } from "data.slint";
import { Dot, IconButton, NavItem } from "widgets.slint";
import { NextUpPage } from "next_up.slint";
import { CalendarPage } from "calendar.slint";
import { LibraryPage } from "library.slint";
import { DownloadsPage } from "downloads.slint";
import { SeriesPage } from "series.slint";
import { HostPanel, InfoPanel } from "settings.slint";

export { AppData, Day, EpisodeLine, Hero, RuleRow, SeriesHead, Shelf, Tile, TorrentRow }

export component AppWindow inherits Window {
    title: "AniBeam";
    background: Theme.ground;
    default-font-size: Theme.normal;

    // The header line: "banditbox online, synced 1 min ago".
    in property <string> status;
    // 0: online, 1: offline, 2: not known yet.
    in property <int> status-tone: 2;
    in property <bool> syncing;
    // Settings.
    in-out property <string> address;
    in property <string> test-result;
    in property <int> test-tone: 2;
    in property <bool> testing;
    in property <string> sync-info;
    in property <string> anilist-info;
    in property <string> version;

    in-out property <int> page: 0;

    callback refresh();
    callback test-connection(string);
    callback save-and-sync(string);

    property <bool> wide: self.width > self.height;
    property <[{icon: image, label: string}]> destinations: [
        { icon: @image-url("icons/clock.svg"), label: "Next up" },
        { icon: @image-url("icons/calendar.svg"), label: "Calendar" },
        { icon: @image-url("icons/layout-grid.svg"), label: "Library" },
        { icon: @image-url("icons/download.svg"), label: "Downloads" },
        { icon: @image-url("icons/settings.svg"), label: "Settings" },
    ];

    // The system bars draw over the window; keep touch targets out from under them.
    property <length> inset-top: self.safe-area-insets.top;
    property <length> inset-bottom: self.safe-area-insets.bottom;
    property <length> inset-left: self.safe-area-insets.left;
    property <length> inset-right: self.safe-area-insets.right;

    // The bottom bar in portrait turns into a rail down the left in landscape.
    property <length> bar-height: 18 * Theme.unit;
    property <length> rail-width: 24 * Theme.unit;
    property <length> rail-item: 16 * Theme.unit;
    property <length> content-x: self.wide ? self.inset-left + self.rail-width : self.inset-left;
    property <length> content-width: self.width - self.content-x - self.inset-right;
    property <length> content-bottom: self.wide ? self.inset-bottom : self.inset-bottom + self.bar-height;

    forward-focus: keys;

    function go(to: int) {
        AppData.close-series();
        root.page = to;
        keys.focus();
    }

    keys := FocusScope {
        // Back closes a series page, then goes to Next up, and only leaves the app from there.
        key-pressed(event) => {
            if (event.text == Key.Back && AppData.series-open) {
                AppData.close-series();
                return accept;
            }
            if (event.text == Key.Back && root.page != 0) {
                root.page = 0;
                return accept;
            }
            reject
        }

        // Header: the page's name (and a way back from a series), the host status line, and
        // a sync button.
        header := Rectangle {
            x: root.content-x;
            y: root.inset-top;
            width: root.content-width;
            height: 20 * Theme.unit;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                padding-top: Theme.unit * 2;
                spacing: Theme.gap;
                if AppData.series-open: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/arrow-left.svg");
                        clicked => { AppData.close-series(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.unit;
                    Text {
                        text: root.destinations[root.page].label;
                        color: Theme.text;
                        font-size: Theme.large;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: Theme.unit * 2;
                        alignment: start;
                        Dot {
                            y: (parent.height - self.height) / 2;
                            tone: root.status-tone == 0 ? Theme.ok : root.status-tone == 1 ? Theme.warn : Theme.faint;
                        }
                        Text {
                            text: root.status;
                            color: Theme.dim;
                            font-size: Theme.small;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/refresh-cw.svg");
                        spinning: root.syncing;
                        clicked => { root.refresh(); }
                    }
                }
            }
        }

        body := Rectangle {
            x: root.content-x;
            y: header.y + header.height;
            width: root.content-width;
            height: root.height - self.y - root.content-bottom;
            clip: true;

            NextUpPage {
                visible: root.page == 0;
            }
            CalendarPage {
                visible: root.page == 1;
                wide: root.wide;
            }
            LibraryPage {
                visible: root.page == 2;
            }
            DownloadsPage {
                visible: root.page == 3;
                wide: root.wide;
            }
            settings-view := Flickable {
                visible: root.page == 4;
                content-height: settings-content.height;
                settings-content := Rectangle {
                    width: settings-view.width;
                    property <length> inner: self.width - 2 * Theme.pad;
                    property <length> half: root.wide ? (self.inner - Theme.gap) / 2 : self.inner;
                    height: Math.max(host.y + host.height, info.y + info.height) + Theme.pad;
                    host := HostPanel {
                        x: Theme.pad;
                        y: Theme.unit * 2;
                        width: parent.half;
                        address <=> root.address;
                        result: root.test-result;
                        result-tone: root.test-tone;
                        busy: root.testing;
                        test-connection(text) => { root.test-connection(text); }
                        save-and-sync(text) => { root.save-and-sync(text); }
                    }
                    info := InfoPanel {
                        x: root.wide ? Theme.pad + parent.half + Theme.gap : Theme.pad;
                        y: root.wide ? host.y : host.y + host.height + Theme.gap;
                        width: parent.half;
                        sync-info: root.sync-info;
                        anilist-info: root.anilist-info;
                        version: root.version;
                    }
                }
            }
            if AppData.series-open: SeriesPage { }
        }

        // Navigation: along the bottom, or down the left when the screen is wide.
        nav := Rectangle {
            x: 0;
            y: root.wide ? 0 : root.height - root.bar-height - root.inset-bottom;
            width: root.wide ? root.inset-left + root.rail-width : root.width;
            height: root.wide ? root.height : root.bar-height + root.inset-bottom;
            background: Theme.surface;
            Rectangle {
                x: root.wide ? parent.width - 1px : 0;
                y: 0;
                width: root.wide ? 1px : parent.width;
                height: root.wide ? parent.height : 1px;
                background: Theme.line;
            }
            property <length> item-width: root.wide ? root.rail-width : (self.width - root.inset-left - root.inset-right) / root.destinations.length;
            property <length> item-height: root.wide ? root.rail-item : root.bar-height;
            // In the rail, the destinations sit in the middle of the height.
            property <length> rail-top: (self.height - root.destinations.length * self.item-height) / 2;
            for destination[i] in root.destinations: NavItem {
                x: root.wide ? root.inset-left : root.inset-left + i * parent.item-width;
                y: root.wide ? parent.rail-top + i * parent.item-height : 0;
                width: parent.item-width;
                height: parent.item-height;
                icon: destination.icon;
                label: destination.label;
                active: root.page == i;
                clicked => { root.go(i); }
            }
        }
    }
}
