import { Theme } from "theme.slint";
import { AppData, Day, DownloadRow, EpisodeLine, Hero, ResultRow, SeriesHead, Shelf, SourceRow, Tile } from "data.slint";
import { Button, IconButton, NavItem, TextButton } from "widgets.slint";
import { HomePage } from "home.slint";
import { LibraryPage } from "library.slint";
import { Ask, MorePage } from "more.slint";
import { SeriesPage } from "series.slint";
import { Onboarding } from "onboarding.slint";
import { SearchPage } from "search.slint";

export { AppData, Day, DownloadRow, EpisodeLine, Hero, ResultRow, SeriesHead, Shelf, SourceRow, Tile }

// "Download over mobile data?": asked before Wi-Fi only goes off, from More or onboarding.
component MobileDataQuestion inherits Rectangle {
    background: #000000a8;
    TouchArea { clicked => { Ask.mobile = false; } }
    card := Rectangle {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        y: (parent.height - self.height) / 2;
        height: body.preferred-height;
        background: Theme.raised;
        border-radius: Theme.radius-large;
        TouchArea { }
        body := VerticalLayout {
            padding: Theme.pad * 1.5;
            spacing: Theme.unit * 3;
            Text {
                text: "Download over mobile data?";
                color: Theme.text;
                font-size: Theme.heading + 2px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: "One episode is often 1 to 2 GB. On a capped plan that can use up a month of data in an evening.";
                color: Theme.dim;
                wrap: word-wrap;
            }
            Button {
                text: "Keep Wi-Fi only";
                primary: true;
                clicked => { Ask.mobile = false; }
            }
            TextButton {
                text: "Yes, use mobile data too";
                clicked => {
                    Ask.mobile = false;
                    AppData.set-wifi-only(false);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "AniBeam";
    background: Theme.ground;
    default-font-size: Theme.normal;
    default-font-family: Theme.face;

    in-out property <int> page: 0;

    property <bool> wide: self.width > self.height;
    property <[{icon: image, label: string}]> destinations: [
        { icon: @image-url("icons/house.svg"), label: "Home" },
        { icon: @image-url("icons/layers.svg"), label: "Library" },
        { icon: @image-url("icons/ellipsis.svg"), label: "More" },
    ];

    // The system bars draw over the window; keep touch targets out from under them.
    property <length> inset-top: self.safe-area-insets.top;
    property <length> inset-bottom: self.safe-area-insets.bottom;
    property <length> inset-left: self.safe-area-insets.left;
    property <length> inset-right: self.safe-area-insets.right;

    // The bottom bar in portrait turns into a rail down the left in landscape.
    property <length> bar-height: 18 * Theme.unit;
    property <length> rail-width: 24 * Theme.unit;
    property <length> rail-item: 18 * Theme.unit;
    property <length> content-x: self.wide ? self.inset-left + self.rail-width : self.inset-left;
    property <length> content-width: self.width - self.content-x - self.inset-right;
    property <length> content-bottom: self.wide ? self.inset-bottom : self.inset-bottom + self.bar-height;

    forward-focus: keys;

    function go(to: int) {
        AppData.close-series();
        root.page = to;
        keys.focus();
    }

    keys := FocusScope {
        // Back closes a question, then a series page, then goes Home, and only leaves the
        // app from there. During onboarding it steps back.
        key-pressed(event) => {
            if (event.text != Key.Back) {
                return reject;
            }
            if (Ask.mobile) {
                Ask.mobile = false;
                return accept;
            }
            if (AppData.onboarding && AppData.step > 0) {
                AppData.step -= 1;
                return accept;
            }
            if (AppData.series-open) {
                AppData.close-series();
                return accept;
            }
            if (AppData.search-open) {
                AppData.close-search();
                return accept;
            }
            if (root.page != 0) {
                root.page = 0;
                return accept;
            }
            reject
        }

        body := Rectangle {
            x: root.content-x;
            y: root.inset-top;
            width: root.content-width;
            height: root.height - self.y - root.content-bottom;
            clip: true;

            HomePage {
                visible: root.page == 0;
            }
            LibraryPage {
                visible: root.page == 1;
            }
            MorePage {
                visible: root.page == 2;
            }
            if AppData.search-open: SearchPage { }
            if AppData.series-open: Rectangle {
                background: Theme.ground;
                TouchArea { }
                SeriesPage {
                    y: back.height;
                    height: parent.height - self.y;
                }
                back := Rectangle {
                    y: 0;
                    height: 14 * Theme.unit;
                    background: Theme.ground;
                    IconButton {
                        x: Theme.pad;
                        icon: @image-url("icons/arrow-left.svg");
                        clicked => { AppData.close-series(); }
                    }
                }
            }
        }

        // Navigation: along the bottom, or down the left when the screen is wide.
        nav := Rectangle {
            x: 0;
            y: root.wide ? 0 : root.height - root.bar-height - root.inset-bottom;
            width: root.wide ? root.inset-left + root.rail-width : root.width;
            height: root.wide ? root.height : root.bar-height + root.inset-bottom;
            background: Theme.surface;
            Rectangle {
                x: root.wide ? parent.width - 1px : 0;
                y: 0;
                width: root.wide ? 1px : parent.width;
                height: root.wide ? parent.height : 1px;
                background: Theme.line;
            }
            property <length> item-width: root.wide ? root.rail-width : (self.width - root.inset-left - root.inset-right) / root.destinations.length;
            property <length> item-height: root.wide ? root.rail-item : root.bar-height;
            property <length> rail-top: (self.height - root.destinations.length * self.item-height) / 2;
            for destination[i] in root.destinations: NavItem {
                x: root.wide ? root.inset-left : root.inset-left + i * parent.item-width;
                y: root.wide ? parent.rail-top + i * parent.item-height : 0;
                width: parent.item-width;
                height: parent.item-height;
                icon: destination.icon;
                label: destination.label;
                active: root.page == i;
                clicked => { root.go(i); }
            }
        }

        if AppData.onboarding: Onboarding {
            x: root.inset-left;
            y: root.inset-top;
            width: root.width - root.inset-left - root.inset-right;
            height: root.height - root.inset-top - root.inset-bottom;
        }

        if Ask.mobile: MobileDataQuestion { }
    }
}
