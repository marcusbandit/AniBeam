import { Theme } from "theme.slint";
import { AppData, CheckRow, Day, DownloadRow, EpisodeLine, Hero, Nav, SeriesHead, Shelf, SourceRow, Tile } from "data.slint";
import { Button, NavItem, Pane } from "widgets.slint";
import { HomePage } from "home.slint";
import { LibraryPage } from "library.slint";
import { Ask, MorePage } from "more.slint";
import { SeriesPage } from "series.slint";
import { Onboarding } from "onboarding.slint";
import { FindData, GridRow, GroupChip, ReleaseRow, SourceChip, Suggestion } from "find.slint";
import { DownloadsPage } from "downloads.slint";
import { Band, PickRow, PlayerData, PlayerPage } from "player.slint";

export { AppData, Band, CheckRow, Day, DownloadRow, EpisodeLine, FindData, GridRow, GroupChip, Hero, PickRow, PlayerData, ReleaseRow, SeriesHead, Shelf, SourceChip, SourceRow, Suggestion, Tile }

// "Download over mobile data?": asked before Wi-Fi only goes off, from More or onboarding.
// A sheet from the foot, the floating glass of the desktop's sheets.
component MobileDataQuestion inherits Rectangle {
    in property <length> inset-bottom;
    background: #000000b0;
    TouchArea { clicked => { Ask.mobile = false; } }
    sheet := Rectangle {
        x: Theme.grout;
        width: parent.width - 2 * Theme.grout;
        y: parent.height - self.height - root.inset-bottom - Theme.grout;
        height: body.preferred-height;
        background: Theme.float;
        border-radius: Theme.radius + 6px;
        border-width: 1px;
        border-color: Theme.line-strong;
        TouchArea { }
        body := VerticalLayout {
            padding: Theme.pad;
            padding-top: Theme.pad + Theme.unit;
            spacing: Theme.unit * 3;
            Text {
                text: "Download over mobile data?";
                color: Theme.text;
                font-size: Theme.section;
                font-family: Theme.display-face;
                wrap: word-wrap;
            }
            Text {
                text: "One episode is often 1 to 2 GB. On a capped plan that can use up a month of data in an evening.";
                color: Theme.dim;
                font-size: Theme.small + 1px;
                wrap: word-wrap;
            }
            Rectangle { height: Theme.unit; }
            Button {
                text: "Keep Wi-Fi only";
                primary: true;
                clicked => { Ask.mobile = false; }
            }
            Button {
                text: "Use mobile data too";
                clicked => {
                    Ask.mobile = false;
                    AppData.set-wifi-only(false);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "AniBeam";
    background: Theme.ground;
    default-font-size: Theme.normal;
    default-font-family: Theme.face;

    property <int> page: Nav.page;

    property <bool> wide: self.width > self.height;
    property <[{icon: image, label: string}]> destinations: [
        { icon: @image-url("icons/house.svg"), label: "Home" },
        { icon: @image-url("icons/layers.svg"), label: "Library" },
        { icon: @image-url("icons/download.svg"), label: "Downloads" },
        { icon: @image-url("icons/ellipsis.svg"), label: "More" },
    ];

    // The system bars draw over the window; keep touch targets out from under them.
    property <length> inset-top: self.safe-area-insets.top;
    property <length> inset-bottom: self.safe-area-insets.bottom;
    property <length> inset-left: self.safe-area-insets.left;
    property <length> inset-right: self.safe-area-insets.right;

    // The bottom bar in portrait turns into a rail down the left in landscape.
    property <length> bar-height: 18 * Theme.unit;
    property <length> rail-width: 24 * Theme.unit;
    property <length> rail-item: 18 * Theme.unit;
    property <length> content-x: self.wide ? self.inset-left + self.rail-width : self.inset-left;
    property <length> content-width: self.width - self.content-x - self.inset-right;
    property <length> content-bottom: self.wide ? self.inset-bottom : self.inset-bottom + self.bar-height;

    forward-focus: keys;

    // A view that goes away can take the focused field with it (the search field when a show
    // opens), and with no focus left Back goes to Android and closes the app. Whenever the
    // view changes, the window takes the keys back.
    property <int> find-view: FindData.view;
    property <bool> series-shown: AppData.series-open;
    property <bool> player-shown: PlayerData.open;
    changed find-view => { keys.focus(); }
    changed series-shown => { keys.focus(); }
    changed player-shown => { keys.focus(); }

    function go(to: int) {
        AppData.close-series();
        // Downloads opens on its lenses; a show or a list left open stays as it was.
        if (to == 2 && !FindData.shown) {
            FindData.open("");
        }
        Nav.page = to;
        keys.focus();
    }

    keys := FocusScope {
        // Back closes a question, then a series page, then goes Home, and only leaves the
        // app from there. During onboarding it steps back.
        key-pressed(event) => {
            if (event.text != Key.Back) {
                return reject;
            }
            if (PlayerData.open && PlayerData.picker != 0) {
                PlayerData.close-picker();
                return accept;
            }
            if (PlayerData.open) {
                PlayerData.back();
                return accept;
            }
            if (Ask.mobile) {
                Ask.mobile = false;
                return accept;
            }
            if (AppData.onboarding && AppData.step > 0) {
                AppData.step -= 1;
                return accept;
            }
            if (AppData.series-open) {
                AppData.close-series();
                return accept;
            }
            if (root.page == 2 && FindData.shown && FindData.view > 0) {
                FindData.back();
                return accept;
            }
            if (root.page != 0) {
                Nav.page = 0;
                return accept;
            }
            reject
        }

        body := Rectangle {
            x: root.content-x;
            y: root.inset-top;
            width: root.content-width;
            height: root.height - self.y - root.content-bottom;
            clip: true;

            HomePage {
                visible: root.page == 0;
            }
            LibraryPage {
                visible: root.page == 1;
            }
            DownloadsPage {
                visible: root.page == 2;
            }
            MorePage {
                visible: root.page == 3;
            }
            if AppData.series-open: Rectangle {
                background: Theme.ground;
                TouchArea { }
                SeriesPage { }
            }
        }

        // Navigation: along the bottom, or down the left when the screen is wide.
        nav := Rectangle {
            x: 0;
            y: root.wide ? 0 : root.height - root.bar-height - root.inset-bottom;
            width: root.wide ? root.inset-left + root.rail-width : root.width;
            height: root.wide ? root.height : root.bar-height + root.inset-bottom;
            background: Theme.ground;
            Rectangle {
                x: root.wide ? parent.width - 1px : 0;
                y: 0;
                width: root.wide ? 1px : parent.width;
                height: root.wide ? parent.height : 1px;
                background: Theme.line;
            }
            property <length> item-width: root.wide ? root.rail-width : (self.width - root.inset-left - root.inset-right) / root.destinations.length;
            property <length> item-height: root.wide ? root.rail-item : root.bar-height;
            property <length> rail-top: (self.height - root.destinations.length * self.item-height) / 2;
            for destination[i] in root.destinations: NavItem {
                x: root.wide ? root.inset-left : root.inset-left + i * parent.item-width;
                y: root.wide ? parent.rail-top + i * parent.item-height : 0;
                width: parent.item-width;
                height: parent.item-height;
                icon: destination.icon;
                label: destination.label;
                active: root.page == i;
                clicked => { root.go(i); }
            }
        }

        if AppData.onboarding: Onboarding {
            x: root.inset-left;
            y: root.inset-top;
            width: root.width - root.inset-left - root.inset-right;
            height: root.height - root.inset-top - root.inset-bottom;
        }

        if Ask.mobile: MobileDataQuestion {
            inset-bottom: root.inset-bottom;
        }

        // The player covers everything, the bars included: Android hides them while it plays.
        if PlayerData.open: PlayerPage {
            width: root.width;
            height: root.height;
            inset-left: root.inset-left;
            inset-right: root.inset-right;
            inset-top: root.inset-top;
            inset-bottom: root.inset-bottom;
        }
    }
}
