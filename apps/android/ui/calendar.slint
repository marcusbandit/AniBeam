import { Theme } from "theme.slint";
import { AppData } from "data.slint";
import { IconButton, TileGrid } from "widgets.slint";

// One day in the week strip: weekday, date, and how many episodes it has.
component DayCell inherits Rectangle {
    in property <string> weekday;
    in property <string> date;
    in property <int> count;
    in property <bool> today;
    in property <bool> selected;
    callback picked();
    border-radius: Theme.radius;
    background: root.selected ? Theme.pressed : touch.pressed ? Theme.raised : transparent;
    animate background { duration: 120ms; }
    VerticalLayout {
        alignment: center;
        spacing: Theme.unit / 2;
        Text {
            text: root.weekday;
            color: root.today ? Theme.accent : Theme.dim;
            font-size: Theme.small;
            font-weight: root.today ? 700 : 400;
            horizontal-alignment: center;
        }
        Text {
            text: root.date;
            color: root.today ? Theme.accent : Theme.text;
            font-family: Theme.mono;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.count > 0 ? "\{root.count}" : " ";
            color: root.selected ? Theme.text : Theme.faint;
            font-size: Theme.small;
            font-family: Theme.mono;
            horizontal-alignment: center;
        }
    }
    // Today keeps an accent bar under it, picked or not.
    if root.today: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Theme.unit;
        width: Theme.unit * 5;
        height: Theme.unit * 0.75;
        border-radius: self.height / 2;
        background: Theme.accent;
    }
    touch := TouchArea {
        clicked => { root.picked(); }
    }
}

// The seven days of the shown week.
component DayStrip inherits Rectangle {
    height: Theme.unit * 18;
    property <length> cell: self.width / Math.max(1, AppData.days.length);
    for day[i] in AppData.days: DayCell {
        x: i * root.cell;
        width: root.cell;
        height: root.height;
        weekday: day.weekday;
        date: day.date;
        count: day.count;
        today: day.today;
        selected: AppData.day == i;
        picked => { AppData.pick-day(i); }
    }
}

export component CalendarPage inherits Rectangle {
    // Sideways there is little height, so the arrows, the week and its days share a row.
    in property <bool> wide;

    // The week and its days stay put; the picked day's episodes scroll under them.
    head := VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        padding-top: Theme.unit * 2;
        spacing: Theme.unit * 2;
        HorizontalLayout {
            spacing: Theme.gap;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("icons/chevron-left.svg");
                    clicked => { AppData.shift-week(-1); }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: root.wide ? 0 : 1;
                min-width: root.wide ? Theme.unit * 32 : 0;
                Text {
                    text: AppData.week-label;
                    color: Theme.text;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: AppData.week-note;
                    color: AppData.week-is-current ? Theme.accent : Theme.dim;
                    font-size: Theme.small;
                    horizontal-alignment: center;
                }
            }
            if root.wide: DayStrip {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("icons/chevron-right.svg");
                    clicked => { AppData.shift-week(1); }
                }
            }
        }
        if !root.wide: DayStrip { }
        if !AppData.week-is-current: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: back-label.preferred-width + Theme.unit * 8;
                height: Theme.unit * 8;
                border-radius: self.height / 2;
                border-width: 1px;
                border-color: Theme.line-strong;
                background: back-touch.pressed ? Theme.pressed : transparent;
                back-label := Text {
                    text: "Back to this week";
                    color: Theme.text;
                    font-size: Theme.small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                back-touch := TouchArea {
                    clicked => { AppData.shift-week(0); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
    }

    Flickable {
        y: head.preferred-height;
        height: parent.height - self.y;
        VerticalLayout {
            alignment: start;
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: Theme.gap;
            padding-bottom: Theme.pad * 2;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: Theme.unit * 2;
                Text {
                    text: AppData.day-title;
                    color: Theme.text;
                    font-size: Theme.large;
                    font-weight: 700;
                }
                Text {
                    text: AppData.day-note;
                    color: Theme.faint;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                }
            }
            TileGrid {
                tiles: AppData.day-tiles;
                open(id) => { AppData.open-series(id); }
            }
            if AppData.day-tiles.length == 0: Text {
                text: "Nothing airs this day.";
                color: Theme.dim;
                horizontal-alignment: center;
            }
        }
    }
}
