// Everything the pages show, set from Rust, and the actions they send back.

// One poster in a grid: Home's shelves, the calendar's day and the library all use it.
export struct Tile {
    // The series it opens; -1 for none.
    id: int,
    title: string,
    poster: image,
    has-poster: bool,
    initials: string,
    // Top-left on the poster: an episode code or an air time.
    badge: string,
    // Top-right: a download's share, "42%". Empty for none.
    flag: string,
    // Under the title: "in 2d 4h", "3 on phone".
    ledger: string,
    // 0: quiet, 1: accent, 2: warning, 3: good.
    ledger-tone: int,
    // One code per episode (Theme.cube); empty for no cube row.
    cubes: [int],
}

// A titled run of tiles.
export struct Shelf {
    title: string,
    count: string,
    tiles: [Tile],
}

// The next episode to air, at the top of Home.
export struct Hero {
    show: bool,
    id: int,
    title: string,
    poster: image,
    has-poster: bool,
    initials: string,
    // "E12  Tomorrow 05:00".
    episode: string,
    countdown: string,
    // The poster's own hue, darkened for the band and lightened for the ink.
    band: color,
    ink: color,
}

// One episode on the calendar.
export struct CalItem {
    id: int,
    title: string,
    poster: image,
    has-poster: bool,
    initials: string,
    // "17:30".
    time: string,
    // "Episode 5", "Episodes 5 to 7".
    episode: string,
    // "in 3h 20m", "Tue in 2d 4h", "On the phone", "Out 2h ago".
    when: string,
    // 0 still to air, 1 out and on the phone, 2 out and not on the phone.
    state: int,
    // The next episode to air of all of them.
    soonest: bool,
    // The computer's show: a tap opens it from there.
    remote: bool,
}

// One day of the calendar, from three days back to a week ahead.
export struct CalDay {
    // "Mon", "3".
    weekday: string,
    date: string,
    // "Today", "Tomorrow", "Yesterday", "Thursday".
    title: string,
    // "Thursday 5 November".
    full: string,
    today: bool,
    past: bool,
    count: int,
    items: [CalItem],
    // The next day after this one with something on it, for an empty day's way on; -1 none.
    next: int,
}

// A series page, the head of it.
export struct SeriesHead {
    id: int,
    title: string,
    alt-title: string,
    // "TV  Fall 2026  Airing  12 episodes".
    facts: string,
    poster: image,
    has-poster: bool,
    initials: string,
    band: color,
    ink: color,
    // "Episode 8 airs in 1d 22h", or empty.
    next: string,
    // "6 of 12 watched, 3 on this phone".
    progress-text: string,
    cubes: [int],
    synopsis: string,
    // The episode Play opens, the next one up, and what the button says: "Resume episode
    // 5". Zero when nothing on the phone is next.
    play-file: int,
    play-label: string,
    // play-file is the other device's, streamed from it.
    play-remote: bool,
}

// One episode row on a series page.
export struct EpisodeLine {
    code: string,
    title: string,
    // "17 Oct", "in 2d 4h", "predicted for Mon 3 Nov".
    date: string,
    // "Next up", "Missing", "Downloading 34%", or empty.
    note: string,
    // Theme.cube's code.
    cube: int,
    // The file a tap plays; zero for an episode that is not whole on the phone.
    file: int,
    // Picked for deleting.
    picked: bool,
    // file is the other device's: a tap streams it from there.
    remote: bool,
}

// One download on this phone, the desktop's Downloading panel.
export struct DownloadRow {
    hash: string,
    name: string,
    // "Downloading", "Paused", "Waiting for Wi-Fi", "Done".
    state: string,
    // "420 MB of 1.4 GB, 3.2 MB/s, 5m left".
    facts: string,
    progress: float,
    paused: bool,
    done: bool,
    // "21%".
    percent: string,
    // "Episode 5", "Episodes 1 to 12", or empty.
    what: string,
    // "420 MB of 1.4 GB".
    amount: string,
    // "3.2 MB/s, 5m left", or empty.
    speed: string,
    // "SubsPlease, 1080p", or empty.
    release: string,
    // The folder it saves to, its last part.
    folder: string,
    // One cube per file of a batch (Theme.cube's codes: 2 done, 6 coming, 4 not started).
    cubes: [int],
    // The state's dot: 0 moving, 1 paused, 2 waiting, 3 trouble, 4 done.
    tone: int,
    // The library show it fills, for the poster and a tap: -1 and empty when none.
    series: int,
    show: string,
    poster: image,
    has-poster: bool,
    initials: string,
}

// One line of the connection check.
export struct CheckRow {
    name: string,
    detail: string,
    ok: bool,
}

// One place the phone searches.
export struct SourceRow {
    name: string,
    url: string,
    enabled: bool,
}

// One row of What's new, read top to bottom: a version, a section of it, one change, or
// the line under what is new since the version this phone had.
export struct NoteLine {
    // 0 a version (text, and its day in note), 1 a section's name, 2 a change, 3 the line.
    kind: int,
    text: string,
    note: string,
    // Read brighter: above the line, new since the version this phone came from, or every
    // version when there is no line.
    lit: bool,
}

// A show on Airing now, tapped: what can be done to it.
export struct AiringMenu {
    show: bool,
    // AniList's id.
    id: int,
    title: string,
    // On a list on a connected tracker already.
    listed: bool,
    // The library series that carries it on this phone; -1 for none.
    owned: int,
}

// Which tab is up: 0 Home, 1 Library, 2 Downloads, 3 More, 4 Calendar. A page can send you
// to another.
export global Nav {
    in-out property <int> page;
}

export global AppData {
    // Home.
    in property <Hero> hero;
    // The next few episodes to air, for Home.
    in property <[CalItem]> coming;

    // The calendar, and the day picked on it; Rust picks today when the days first come.
    in property <[CalDay]> calendar;
    in-out property <int> cal-day: 2;
    // Airing now, the Calendar tab's other view: this season's shows from AniList, or the
    // next season's, with the ones marked not interested left out.
    in-out property <bool> airing-view;
    // The Calendar's switch: the devices, then Airing now.
    in property <[string]> cal-views: ["This phone", "Airing now"];
    in property <[string]> airing-seasons: ["This season", "Next season"];
    in property <int> airing-season;
    // "Everything 48", "On my lists 6", "In my library 3".
    in property <[string]> airing-filters;
    in property <int> airing-filter;
    in property <[Tile]> airing-tiles;
    // The episodes out in the last two days.
    in property <[Tile]> airing-out;
    // What the page says under its head: how many, a refresh under way, or what failed.
    in property <string> airing-line;
    in property <AiringMenu> airing-menu;
    // The show just marked not interested, while it can still be taken back.
    in property <string> airing-undo;
    callback open-airing();
    callback pick-airing-season(int);
    callback pick-airing-filter(int);
    callback airing-tap(int);
    callback airing-close();
    callback airing-plan(int);
    callback airing-dismiss(int);
    callback airing-take-back();

    // Whose calendar: 0 this phone, 1 the computer, as in Library's devices.
    in property <int> cal-device;
    callback pick-cal-device(int);
    in property <string> cal-note;
    in property <[Shelf]> home-shelves;
    in property <string> home-note;
    // How many shows the phone has.
    in property <int> phone-shows;

    // Library: the devices it can show (this phone first), the one picked, and its tiles.
    in property <[string]> devices;
    in-out property <int> device;
    in-out property <string> query;
    in property <string> library-note;
    in property <[Tile]> library;
    in property <string> library-empty;

    // More.
    in property <bool> wifi-only: true;
    in property <bool> limit-on;
    // The limit in GB, set with a slider from 1 GB to the whole of the phone's storage.
    in-out property <float> limit-gb: 18;
    in property <float> disk-gb: 128;
    // "18 GB", "31.5 GB".
    in property <string> limit-label: "18 GB";
    in property <string> storage-line;
    // The same as figures: what AniBeam's episodes take, and what the phone has free.
    in property <string> used-figure;
    in property <string> free-figure;
    in property <string> free-line;
    in property <string> trackers-line;
    in property <string> version;
    // Devices: the host address and what the last test said.
    in-out property <string> host-address;
    in property <string> host-result;
    in property <int> host-tone: 2;

    // Onboarding, over everything until it is done.
    in property <bool> onboarding;
    // The phone's library has been read once: until then an empty list means nothing yet.
    in property <bool> ready;
    in-out property <int> step;
    in property <string> anilist-state;
    in property <string> mal-state;
    // The last sign-in to AniList or MAL failed.
    in property <bool> sign-in-failed;

    // Downloads and sources, on More.
    in property <[DownloadRow]> downloads;
    in property <string> downloads-note;
    // The rates across every download, "3.2 MB/s".
    in property <string> rate-down: "0 B/s";
    in property <string> rate-up: "0 B/s";
    // Not finished, whatever their state; and of those, the ones actually moving.
    in property <int> downloading-count;
    in property <int> moving-count;
    in property <int> finished-count;
    in property <[SourceRow]> sources;
    // What a search tries, in order: these and the endpoints installed from repos.
    in property <[SourceRow]> search-sources;
    // The connection check: its lines, and whether it is running.
    in property <[CheckRow]> checks;
    in property <bool> checking;
    in property <string> check-summary;
    // How many steps of the last check failed.
    in property <int> check-failed;

    // What's new, over everything: opens by itself once after an update, and from More.
    in property <bool> notes-open;
    // "2.0.4 → 2.1.0", "Updated to 2.1.0" or "Version 2.1.0".
    in property <string> notes-note;
    in property <[NoteLine]> notes;
    callback open-notes();
    // Got it or Back: the notes count as read.
    callback close-notes();

    // The series page, over whichever page opened it.
    in property <bool> series-open;
    // The open series is the other device's, opened from its library: it streams from there.
    in property <bool> series-remote;
    in property <SeriesHead> series;
    in property <[EpisodeLine]> episodes;

    callback open-series(int);
    // A series from the other device's library, played from there.
    callback open-remote(int);
    callback close-series();
    // Deleting episodes from the series page: pick them, then confirm.
    in property <bool> deleting;
    // The open series has an episode on this phone.
    in property <bool> series-has-files;
    in property <int> delete-count;
    in property <bool> delete-busy;
    in property <string> delete-error;
    callback start-delete();
    callback toggle-delete(int);
    callback cancel-delete();
    callback confirm-delete();
    // Opens the player on a file of this phone's.
    callback play(int);
    // Opens the player on a file of the other device's, streamed.
    callback play-remote(int);
    // How a stream from the other device plays: Auto, Original, 1080p, 720p, 480p.
    in property <int> stream-quality;
    in property <[string]> stream-qualities;
    callback set-stream-quality(int);
    callback pick-device(int);
    callback search(string);
    callback set-wifi-only(bool);
    // On or off, and the amount in GB.
    callback set-limit(bool, float);
    callback connect-tracker(int);
    callback finish-onboarding();
    callback restart-onboarding();
    callback test-host(string);
    callback save-host(string);
    callback refresh();
    // 0 pause, 1 resume, 2 cancel and delete, 3 take a finished one off the list.
    callback torrent-action(string, int);
    callback remove-source(int);
    callback run-check();
    callback copy-check();
}
