// Everything the pages show, set from Rust, and the actions they send back.

// One poster in a grid: Next up, the calendar and the library all use it.
export struct Tile {
    // The series it opens; -1 for none.
    id: int,
    title: string,
    poster: image,
    has-poster: bool,
    initials: string,
    // Top-left on the poster: an episode code or an air time.
    badge: string,
    // Under the title: "in 2d 4h", "6 of 12 watched".
    ledger: string,
    // 0: quiet, 1: accent, 2: warning, 3: good.
    ledger-tone: int,
    // 0 to 1 along the foot; below 0 for no strip.
    progress: float,
}

// A titled run of tiles.
export struct Shelf {
    title: string,
    count: string,
    // 0: plain, 1: accent, 2: warning.
    tone: int,
    tiles: [Tile],
}

// The next episode to air, at the top of Next up.
export struct Hero {
    show: bool,
    id: int,
    title: string,
    poster: image,
    has-poster: bool,
    initials: string,
    // "Episode 8  Today 17:56".
    episode: string,
    countdown: string,
    // The poster's own hue, darkened for the band and lightened for the ink.
    band: color,
    ink: color,
    subscribed: bool,
}

// One day in the calendar's week strip.
export struct Day {
    weekday: string,
    date: string,
    count: int,
    today: bool,
}

// A series page, the head of it.
export struct SeriesHead {
    id: int,
    title: string,
    alt-title: string,
    // "TV  Fall 2026  Airing  12 episodes".
    facts: string,
    poster: image,
    has-poster: bool,
    initials: string,
    band: color,
    ink: color,
    // "Episode 8 airs in 1d 22h 05m 07s", or empty.
    next: string,
    // "6 of 12 watched".
    progress-text: string,
    progress: float,
    // "Subscribed: Sousou no Frieren 1080p [SubsPlease]", or empty.
    rule: string,
    // "2 aired episodes not found yet", or empty.
    rule-note: string,
}

// One episode row on a series page.
export struct EpisodeLine {
    code: string,
    title: string,
    // "17 Oct", "in 2d 4h".
    date: string,
    // 0: watched, 1: on disk, 2: still to air, 3: aired and not on disk.
    state: int,
}

export struct TorrentRow {
    name: string,
    // "Downloading", "Seeding", "Stalled", ...
    state: string,
    // "1.2 GB of 4.5 GB, 3.4 MB/s, 12m left".
    facts: string,
    progress: float,
    // 0: moving, 1: quiet, 2: stuck or broken.
    tone: int,
}

// One anirss subscription on Downloads.
export struct RuleRow {
    id: int,
    title: string,
    // "Airing", "Complete", "Paused".
    state: string,
    // "7 files  next E08 in 1d 22h".
    facts: string,
    // 0: plain, 1: accent, 2: warning.
    tone: int,
}

export global AppData {
    // Next up.
    in property <Hero> hero;
    in property <[Shelf]> next-shelves;
    in property <bool> has-data;
    // Calendar.
    in property <string> week-label;
    in property <string> week-note;
    in property <bool> week-is-current: true;
    in property <[Day]> days;
    in property <int> day;
    in property <string> day-title;
    in property <string> day-note;
    in property <[Tile]> day-tiles;
    // Library.
    in property <[Shelf]> library;
    // Downloads.
    in property <[TorrentRow]> torrents;
    in property <bool> torrents-known: true;
    in property <[RuleRow]> rules;
    in property <[string]> problems;
    in property <string> freshness;
    in property <bool> live;
    // The series page, over whichever page opened it.
    in property <bool> series-open;
    in property <SeriesHead> series;
    in property <[EpisodeLine]> episodes;

    callback open-series(int);
    callback close-series();
    // -1 and +1 move a week; 0 goes back to this week.
    callback shift-week(int);
    callback pick-day(int);
}
