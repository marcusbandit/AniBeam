// Downloads: the desktop's Downloads page at phone size. The head names the page and says
// how downloads stand in figures, then one wide field: typing lists shows, Return searches
// release names. The sources sit under the field as chips. What is moving comes next, a card
// per download with its show's poster, then what finished, then the lenses.

import { Theme } from "theme.slint";
import { AppData, DownloadRow, Nav } from "data.slint";
import { FindData, Lenses, ReleaseList, ShowView, Suggestions } from "find.slint";
import { Settings } from "more.slint";
import { Button, Chip, ClampedText, Cubes, Figure, IconButton, PageTitle, Poster, ProgressLine, SearchField, SectionHead } from "widgets.slint";
import { Fold } from "fold.slint";
import { Leaf, Scroll } from "panes.slint";

// The colour of a download's state dot: moving, paused, waiting, trouble, done.
component StateDot inherits Rectangle {
    in property <int> tone;
    width: 2.5 * Theme.unit;
    height: self.width;
    border-radius: self.width / 2;
    background: root.tone == 0 ? Theme.purple : root.tone == 2 ? Theme.yellow : root.tone == 3 ? Theme.bad : root.tone == 4 ? Theme.ok : Theme.dim;
}

// One download that is not finished: the show's poster, which episodes and how far, the bar
// or a cube per file, the figures, and Pause and Cancel as round buttons at the side. A tap
// opens the show. A batch, many episodes in one download, is a stack of cards with a Batch
// tag, the way the show view draws one.
component DownloadCard inherits Rectangle {
    in property <DownloadRow> data;
    property <color> fill: root.data.tone == 0 ? Theme.purple : root.data.tone == 2 ? Theme.yellow : root.data.tone == 3 ? Theme.bad : Theme.dim;
    property <bool> failed: root.data.state == "Stopped by an error";
    property <length> card-height: Math.max(row.preferred-height, 20 * Theme.unit);
    height: self.card-height + (root.data.batch ? 2 * Theme.unit : 0);
    if root.data.batch: Rectangle {
        x: 4 * Theme.unit;
        y: 2 * Theme.unit;
        width: parent.width - 8 * Theme.unit;
        height: root.card-height;
        border-radius: Theme.radius;
        background: Theme.ground;
        border-width: 1px;
        border-color: Theme.line;
    }
    if root.data.batch: Rectangle {
        x: 2 * Theme.unit;
        y: Theme.unit;
        width: parent.width - 4 * Theme.unit;
        height: root.card-height;
        border-radius: Theme.radius;
        background: Theme.ground;
        border-width: 1px;
        border-color: Theme.line;
    }
    // The card's glass is see-through; ground under it hides the stack behind.
    if root.data.batch: Rectangle {
        y: 0;
        height: root.card-height;
        border-radius: Theme.radius;
        background: Theme.ground;
    }
    Rectangle {
        y: 0;
        height: root.card-height;
        border-radius: Theme.radius;
        background: touch.pressed && root.data.series >= 0 ? Theme.raised : Theme.surface;
        border-width: 1px;
        border-color: Theme.line;
    }
    touch := TouchArea {
        y: 0;
        height: root.card-height;
        clicked => {
            if (root.data.series >= 0) {
                AppData.open-series(root.data.series);
            }
        }
    }
    row := HorizontalLayout {
        y: 0;
        height: root.card-height;
        padding: Theme.unit * 3;
        spacing: Theme.unit * 3.5;
        Poster {
            width: 12 * Theme.unit;
            height: self.width * Theme.poster-ratio;
            y: (parent.height - self.height) / 2;
            source: root.data.poster;
            has-image: root.data.has-poster;
            initials: root.data.initials;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.unit * 1.5;
            if root.data.batch: HorizontalLayout {
                alignment: start;
                Chip {
                    text: root.data.cubes.length > 1 ? "Batch, " + root.data.cubes.length + " files" : "Batch";
                    small: true;
                    selected: true;
                    has-icon: true;
                    icon: @image-url("icons/layers.svg");
                }
            }
            ClampedText {
                text: root.data.show != "" ? root.data.show : root.data.name;
                face: root.data.show != "" ? Theme.title-face : Theme.face;
                font-size: root.data.show != "" ? Theme.normal + 1px : Theme.small + 0.5px;
                lines: 2;
            }
            HorizontalLayout {
                spacing: Theme.unit * 2;
                Text {
                    text: root.data.percent;
                    color: root.fill;
                    font-family: Theme.figure;
                    font-size: Theme.small + 0.5px;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.data.state == "Downloading" ? root.data.what : root.data.what != "" ? root.data.state + ", " + root.data.what : root.data.state;
                    color: Theme.dim;
                    font-size: Theme.small + 0.5px;
                    overflow: elide;
                }
            }
            if root.data.cubes.length > 0: Cubes {
                codes: root.data.cubes;
                size: 16px;
                spacing: 4px;
            }
            if root.data.cubes.length == 0: ProgressLine {
                height: 4px;
                progress: root.data.progress;
                fill: root.fill;
            }
            // The speed and time left first: on a narrow card they are what is read.
            if root.data.speed != "": Text {
                text: root.data.speed;
                color: Theme.dim;
                font-size: Theme.small - 0.5px;
                font-family: Theme.figure;
                overflow: elide;
            }
            Text {
                text: root.data.release != "" ? root.data.amount + ", " + root.data.release : root.data.amount;
                color: Theme.faint;
                font-size: Theme.small - 0.5px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.unit * 2;
            // Held for Wi-Fi, nothing restarts it, so there is nothing to press.
            if root.data.state != "Waiting for Wi-Fi": IconButton {
                icon: root.failed ? @image-url("icons/refresh-cw.svg") : root.data.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                primary: root.data.paused || root.failed;
                clicked => { AppData.torrent-action(root.data.hash, root.data.paused || root.failed ? 1 : 0); }
            }
            // Cancel deletes what the download had written so far.
            IconButton {
                icon: @image-url("icons/x.svg");
                danger: true;
                clicked => { AppData.torrent-action(root.data.hash, 2); }
            }
        }
    }
}

// A finished download: the poster, the show and the episode, its size, and taking it off the
// list (the episode stays). A tap opens the show.
component FinishedRow inherits Rectangle {
    in property <DownloadRow> data;
    height: row.preferred-height;
    touch := TouchArea {
        clicked => {
            if (root.data.series >= 0) {
                AppData.open-series(root.data.series);
            }
        }
    }
    row := HorizontalLayout {
        padding-top: Theme.unit * 2.5;
        padding-bottom: Theme.unit * 2.5;
        spacing: Theme.unit * 3;
        Poster {
            width: 8 * Theme.unit;
            height: self.width * Theme.poster-ratio;
            source: root.data.poster;
            has-image: root.data.has-poster;
            initials: root.data.initials;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.unit;
            Text {
                text: root.data.show != "" ? root.data.show : root.data.what != "" ? root.data.what : root.data.name;
                color: Theme.text;
                font-family: Theme.strong-face;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Theme.unit * 1.5;
                StateDot {
                    y: (parent.height - self.height) / 2;
                    tone: 4;
                }
                Text {
                    horizontal-stretch: 1;
                    text: (root.data.show != "" && root.data.what != "" ? root.data.what + ", " : "") + root.data.amount;
                    color: Theme.dim;
                    font-size: Theme.small;
                    overflow: elide;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Clear";
                clicked => { AppData.torrent-action(root.data.hash, 3); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

// The head: how downloads stand, in three figures. The rate only while something moves; the
// phone never seeds, so there is no upload to show.
component Head inherits VerticalLayout {
    spacing: Theme.unit * 4;
    PageTitle {
        title: "Downloads";
        note: AppData.wifi-only ? "Wi-Fi only" : "Wi-Fi and mobile data";
    }
    HorizontalLayout {
        spacing: Theme.unit * 8;
        alignment: start;
        if AppData.moving-count > 0: Figure {
            value: AppData.rate-down;
            caption: AppData.moving-count == 1 ? "1 downloading" : AppData.moving-count + " downloading";
        }
        Figure {
            value: AppData.free-figure;
            caption: "free on the phone";
        }
    }
}

// What the last search or fetch said, and why it failed when it did.
component Said inherits VerticalLayout {
    spacing: Theme.unit * 4;
    if FindData.line != "": Text {
        text: FindData.line;
        color: Theme.dim;
        font-size: Theme.small;
        wrap: word-wrap;
    }
    if FindData.error != "": Rectangle {
        height: error-text.preferred-height + 6 * Theme.unit;
        border-radius: Theme.radius;
        background: Theme.bad-soft;
        border-width: 1px;
        border-color: Theme.bad-edge;
        error-text := Text {
            x: Theme.unit * 4;
            width: parent.width - 8 * Theme.unit;
            text: FindData.error;
            color: Theme.text;
            font-size: Theme.small + 0.5px;
            wrap: word-wrap;
        }
    }
}

// Where to look: the field, the sources, what the search said, and the shows as you type.
component Finder inherits VerticalLayout {
    callback typed(string);
    callback accepted(string);
    spacing: Theme.unit * 4;
    SearchField {
        placeholder: "A show, or a release name";
        text <=> FindData.text;
        edited(t) => { root.typed(t); }
        accepted(t) => { root.accepted(t); }
    }
    if AppData.search-sources.length > 0: Rectangle {
        height: chips.preferred-height;
        Flickable {
            content-width: Math.max(self.width, chips.preferred-width);
            interactive: chips.preferred-width > self.width;
            chips := HorizontalLayout {
                spacing: Theme.unit * 1.5;
                alignment: start;
                Text {
                    text: "Sources";
                    color: Theme.dim;
                    font-size: Theme.small + 0.5px;
                    vertical-alignment: center;
                }
                for s in AppData.search-sources: Chip {
                    text: s.name;
                    small: true;
                    dimmed: !s.enabled;
                    tappable: true;
                    clicked => {
                        Settings.open(3, "");
                        Nav.page = 3;
                    }
                }
            }
        }
    }
    Said { }
    if FindData.view == 0 && FindData.text != "": Suggestions { }
}

// What is moving and what finished.
component Queue inherits VerticalLayout {
    spacing: Theme.unit * 4;
    // Spacing 0: a finished download is an empty item here, and spacing between empty items
    // would stack up as gaps. Each card brings its own space under it.
    if AppData.downloading-count > 0: VerticalLayout {
        spacing: 0;
        SectionHead {
            title: "Downloading";
            note: AppData.downloads-note != "" ? AppData.downloads-note : AppData.downloading-count == 1 ? "1 episode" : AppData.downloading-count + " downloads";
        }
        Rectangle { height: Theme.unit * 3; }
        for row in AppData.downloads: VerticalLayout {
            padding-bottom: row.done ? 0 : Theme.unit * 2.5;
            if !row.done: DownloadCard { data: row; }
        }
    }
    if AppData.finished-count > 0: VerticalLayout {
        spacing: 0;
        SectionHead {
            title: "Finished";
            note: AppData.finished-count == 1 ? "1 download, in your library" : AppData.finished-count + " downloads, in your library";
        }
        Rectangle { height: Theme.unit; }
        for row in AppData.downloads: VerticalLayout {
            if row.done: FinishedRow { data: row; }
        }
    }
}

// The show view's plan, kept in view at the foot of its pane while the grid scrolls, as the
// desktop keeps its plan pane beside the table.
component PlanBar inherits Rectangle {
    height: bar-row.preferred-height;
    background: Theme.float;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line-strong;
    TouchArea { }
    bar-row := HorizontalLayout {
        padding: Theme.unit * 3;
        padding-left: Theme.unit * 4;
        spacing: Theme.unit * 3;
        Text {
            horizontal-stretch: 1;
            text: FindData.plan;
            color: Theme.text;
            font-size: Theme.small + 0.5px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: FindData.can-go ? "Get" : "Pick";
                icon: @image-url("icons/download.svg");
                has-icon: true;
                primary: true;
                enabled: FindData.can-go && !FindData.busy;
                clicked => { FindData.go(); }
            }
        }
    }
}

// A show or a release list, with the plan at its foot.
component Picked inherits Rectangle {
    property <bool> planning: FindData.view == 1 && FindData.rows.length > 0;
    Scroll {
        pad-bottom: Theme.pad * 2 + (root.planning ? plan.height + Theme.grout : 0);
        if !Fold.split: Said { }
        if FindData.view == 1: ShowView { }
        if FindData.view == 2: ReleaseList { }
    }
    plan := PlanBar {
        visible: root.planning;
        x: Theme.grout;
        width: parent.width - 2 * Theme.grout;
        y: parent.height - self.height - Theme.grout;
    }
}

// Folded, the page is one column, and a show or a release list takes it over until Back.
// Open and half folded, finding and the queue keep the narrow side, or the bottom half stood
// up, and the other side shows what to get, or the show picked, with its plan.
export component DownloadsPage inherits Rectangle {
    // The search a few hundred milliseconds after the last key, so AniList is asked once
    // per pause in typing rather than once per letter.
    property <string> pending;
    debounce := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            FindData.suggest(root.pending);
        }
    }
    // Return searches now, and the suggestion still waiting on the pause is dropped.
    function accepted(t: string) {
        debounce.running = false;
        FindData.search(t);
    }
    function typed(t: string) {
        FindData.suggest-done = false;
        root.pending = t;
        debounce.running = false;
        debounce.running = true;
    }
    property <bool> typing: FindData.view == 0 && FindData.text != "";

    if !Fold.split && FindData.view == 0: Scroll {
        Head { }
        Finder {
            typed(t) => { root.typed(t); }
            accepted(t) => { root.accepted(t); }
        }
        if !root.typing: Queue { }
        if !root.typing: Lenses { }
    }
    if !Fold.split && FindData.view != 0: Picked { }

    if Fold.split: Leaf {
        area: Fold.pick(0.46);
        Scroll {
            Head { }
            Finder {
                typed(t) => { root.typed(t); }
                accepted(t) => { root.accepted(t); }
            }
            if !root.typing: Queue { }
        }
    }
    if Fold.split: Leaf {
        area: Fold.show(0.46);
        if FindData.view == 0: Scroll {
            Lenses { fit-width: Fold.inner(Fold.show(0.46)); }
        }
        if FindData.view != 0: Picked { }
    }
}
