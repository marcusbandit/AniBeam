import { Theme } from "theme.slint";
import { AppData, RuleRow, TorrentRow } from "data.slint";
import { ClampedText, Dot, ProgressLine, ShelfHead } from "widgets.slint";

component TorrentCard inherits Rectangle {
    in property <TorrentRow> data;
    background: Theme.surface;
    border-radius: Theme.radius-large;
    height: body.preferred-height;
    body := VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.unit * 2;
        ClampedText {
            text: root.data.name;
            font-size: Theme.small;
        }
        HorizontalLayout {
            spacing: Theme.gap;
            Text {
                text: root.data.state;
                color: root.data.tone == 0 ? Theme.accent : root.data.tone == 2 ? Theme.warn : Theme.dim;
                font-size: Theme.small;
                font-weight: 700;
                horizontal-stretch: 1;
            }
            Text {
                text: Math.round(root.data.progress * 100) + "%";
                color: Theme.dim;
                font-size: Theme.small;
                font-family: Theme.mono;
            }
        }
        Text {
            text: root.data.facts;
            color: Theme.dim;
            font-size: Theme.small;
            font-family: Theme.mono;
            wrap: word-wrap;
        }
        ProgressLine {
            progress: root.data.progress;
            fill: root.data.tone == 2 ? Theme.warn : root.data.tone == 0 ? Theme.accent : Theme.dim;
        }
    }
}

component RuleItem inherits Rectangle {
    in property <RuleRow> data;
    background: touch.pressed ? Theme.raised : Theme.surface;
    border-radius: Theme.radius;
    height: body.preferred-height;
    body := HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;
        VerticalLayout {
            spacing: Theme.unit;
            horizontal-stretch: 1;
            ClampedText {
                text: root.data.title;
                font-weight: 700;
                lines: 1;
            }
            Text {
                text: root.data.facts;
                color: Theme.dim;
                font-size: Theme.small;
                font-family: Theme.mono;
                overflow: elide;
            }
        }
        Text {
            text: root.data.state;
            color: root.data.tone == 1 ? Theme.accent : root.data.tone == 2 ? Theme.warn : Theme.dim;
            font-size: Theme.small;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.data.id >= 0;
        clicked => { AppData.open-series(root.data.id); }
    }
}

component TorrentList inherits VerticalLayout {
    spacing: Theme.gap;
    ShelfHead {
        title: "Torrents";
        count: AppData.torrents.length;
    }
    for row in AppData.torrents: TorrentCard { data: row; }
    if !AppData.torrents-known: Text {
        text: "The host could not read its torrent client at the last sync.";
        color: Theme.dim;
        wrap: word-wrap;
    }
    if AppData.torrents-known && AppData.torrents.length == 0: Text {
        text: "No torrents.";
        color: Theme.dim;
    }
}

component RuleList inherits VerticalLayout {
    spacing: Theme.unit * 2;
    ShelfHead {
        title: "Subscriptions";
        count: AppData.rules.length;
    }
    for row in AppData.rules: RuleItem { data: row; }
    if AppData.rules.length == 0: Text {
        text: "No anirss subscriptions.";
        color: Theme.dim;
    }
}

// The torrents and the subscriptions that fill them, under a line saying how fresh this is.
export component DownloadsPage inherits Rectangle {
    in property <bool> wide;
    flick := Flickable {
        content-height: content.height;
        content := Rectangle {
            width: flick.width;
            property <length> inner: self.width - 2 * Theme.pad;
            property <length> left-width: root.wide ? (self.inner - Theme.gap) / 2 : self.inner;
            property <length> columns-y: banner.y + banner.height + Theme.pad;
            height: Math.max(rules.y + rules.height, torrents.y + torrents.height) + Theme.pad * 2;

            banner := Rectangle {
                x: Theme.pad;
                y: Theme.unit * 2;
                width: parent.inner;
                height: banner-body.preferred-height;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: AppData.live ? Theme.line-strong : Theme.warn;
                banner-body := VerticalLayout {
                    padding: Theme.gap;
                    spacing: Theme.unit;
                    HorizontalLayout {
                        spacing: Theme.unit * 2;
                        Dot {
                            y: (parent.height - self.height) / 2;
                            tone: AppData.live ? Theme.ok : Theme.warn;
                        }
                        Text {
                            text: AppData.freshness;
                            color: Theme.text;
                            font-size: Theme.small;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    for problem in AppData.problems: Text {
                        text: problem;
                        color: Theme.warn;
                        font-size: Theme.small;
                        wrap: word-wrap;
                    }
                }
            }
            rules := RuleList {
                x: Theme.pad;
                y: parent.columns-y;
                width: parent.left-width;
                height: self.preferred-height;
            }
            torrents := TorrentList {
                x: root.wide ? Theme.pad + parent.left-width + Theme.gap : Theme.pad;
                y: root.wide ? parent.columns-y : rules.y + rules.height + Theme.pad;
                width: root.wide ? parent.inner - parent.left-width - Theme.gap : parent.inner;
                height: self.preferred-height;
            }
        }
    }
}
