// Find: the desktop's Downloads flow on the phone. With nothing searched, four lenses into
// what there is to get: Gaps, Airing, Following, Downloaded. A show opens the show view
// (the desktop's GetShow): its sources, a tap fetches what one has, its releases as rows of
// episode cubes under the library's own row, and a plan that says what Get and Follow will
// do. Typed text opens the release list with the desktop's refine steps.

import { Theme } from "theme.slint";
import { Tile } from "data.slint";
import { Button, Chip, EmptyNote, IconButton, PageTitle, Poster, Segmented, SearchField, ShelfHead, Switch, TextButton, TileGrid } from "widgets.slint";

// One source in the show view: its name and what asking it gave.
export struct SourceChip {
    name: string,
    // "idle", "searching", "done", "error".
    state: string,
    // "12 releases", "Searching 3s", "Not answering".
    line: string,
}

// One row of the show view's grid.
export struct GridRow {
    // "SubsPlease 1080p", "Judas 1080p batch 1-12".
    label: string,
    // "12 episodes  1.2k seeds  16 GB".
    meta: string,
    // 0 none, 1 there to take, 2 picked, 3 the library has it, 4 on its way.
    cubes: [int],
    chosen: bool,
}

// One release in the release list.
export struct ReleaseRow {
    title: string,
    // "SubsPlease  1080p  E05  1.4 GB  120 seeds".
    facts: string,
    best: bool,
    on-disk: bool,
    // 0 plain, 2 no seeders.
    tone: int,
}

// One refine chip: a token group that splits the results.
export struct GroupChip {
    label: string,
    count: int,
}

export global FindData {
    // Which view: 0 lenses, 1 show view, 2 release list.
    in property <bool> shown;
    in property <int> view;
    in-out property <string> text;
    in property <bool> busy;
    in property <string> line;
    in property <string> error;

    // The lenses.
    in property <[string]> lenses;
    in-out property <int> lens;
    in property <string> lens-line;
    in property <[Tile]> lens-tiles;

    // The show view.
    in property <string> show-title;
    in property <string> show-facts;
    in property <image> show-poster;
    in property <bool> show-has-poster;
    in property <[SourceChip]> sources;
    in property <int> source;
    in property <[int]> library;
    in property <[GridRow]> rows;
    in property <string> dropped;
    in property <string> plan;
    in property <string> plan-detail;
    in property <string> go-text;
    in property <bool> can-go;
    in property <bool> can-follow;
    in-out property <bool> follow;
    in-out property <bool> replace;
    in property <bool> has-had;

    // The release list.
    in property <[ReleaseRow]> releases;
    in property <[GroupChip]> groups;
    in property <bool> best-fit;
    in property <string> best-fit-line;
    in property <bool> can-undo;
    in-out property <string> narrow;

    callback open(string);
    callback close();
    callback back();
    callback search(string);
    callback pick-lens(int);
    callback open-tile(int);
    callback fetch(int);
    callback pick-row(int);
    callback toggle-cube(int, int);
    callback set-follow(bool);
    callback set-replace(bool);
    callback go();
    callback list-all();
    callback apply-group(int);
    callback apply-best-fit();
    callback apply-narrow(string);
    callback undo();
    callback download-release(int);
    callback download-all();
    callback subscribe();
}

// A cube row that answers taps: the grid's rows.
component TapCubes inherits Rectangle {
    in property <[int]> codes;
    in property <length> size: 13px;
    in property <length> spacing: 3px;
    callback tapped(int);
    property <int> per-row: Math.max(1, Math.floor((self.width + self.spacing) / (self.size + self.spacing)));
    height: self.codes.length == 0 ? 0 : Math.ceil(self.codes.length / self.per-row) * (self.size + self.spacing) - self.spacing;
    for code[i] in root.codes: Rectangle {
        x: Math.mod(i, root.per-row) * (root.size + root.spacing);
        y: Math.floor(i / root.per-row) * (root.size + root.spacing);
        width: root.size;
        height: root.size;
        border-radius: 3px;
        background: code == 2 ? Theme.accent : code == 1 ? Theme.track : code == 3 ? #8cc58a59 : code == 4 ? Theme.purple : transparent;
        border-width: code == 0 ? 1px : 0;
        border-color: Theme.line;
        TouchArea {
            enabled: code != 0;
            clicked => { root.tapped(i); }
        }
    }
}

// The library's own row, the cube colours of the rest of the app.
component LibraryCubes inherits Rectangle {
    in property <[int]> codes;
    property <length> size: 13px;
    property <length> spacing: 3px;
    property <int> per-row: Math.max(1, Math.floor((self.width + self.spacing) / (self.size + self.spacing)));
    height: self.codes.length == 0 ? 0 : Math.ceil(self.codes.length / self.per-row) * (self.size + self.spacing) - self.spacing;
    for code[i] in root.codes: Rectangle {
        x: Math.mod(i, root.per-row) * (root.size + root.spacing);
        y: Math.floor(i / root.per-row) * (root.size + root.spacing);
        width: root.size;
        height: root.size;
        border-radius: 3px;
        background: code == 5 ? transparent : Theme.cube(code);
        border-width: code == 5 ? 1px : 0;
        border-color: Theme.line-strong;
    }
}

component SourceButton inherits Rectangle {
    in property <SourceChip> data;
    in property <bool> active;
    callback clicked();
    height: 13 * Theme.unit;
    width: Math.max(26 * Theme.unit, column.preferred-width + 6 * Theme.unit);
    border-radius: Theme.radius-row;
    background: root.active ? Theme.raised : Theme.surface;
    border-width: root.active ? 1px : 0;
    border-color: Theme.line-strong;
    column := VerticalLayout {
        x: Theme.unit * 3;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.data.name;
            color: Theme.text;
            font-weight: 600;
        }
        Text {
            text: root.data.line;
            color: root.data.state == "error" ? Theme.warn : Theme.dim;
            font-size: Theme.small - 1px;
            font-family: Theme.figure;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component ShowView inherits VerticalLayout {
    spacing: Theme.unit * 3;
    HorizontalLayout {
        spacing: Theme.unit * 3;
        Poster {
            width: 20 * Theme.unit;
            height: self.width * Theme.poster-ratio;
            source: FindData.show-poster;
            has-image: FindData.show-has-poster;
            initials: "";
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.unit;
            Text {
                text: FindData.show-title;
                color: Theme.text;
                font-size: Theme.large;
                font-weight: 300;
                wrap: word-wrap;
            }
            Text {
                text: FindData.show-facts;
                color: Theme.dim;
                font-size: Theme.small - 1px;
                font-family: Theme.figure;
                wrap: word-wrap;
            }
        }
    }
    ShelfHead { title: "Available sources"; }
    Rectangle {
        height: 13 * Theme.unit;
        Flickable {
            content-width: chips.preferred-width;
            chips := HorizontalLayout {
                spacing: Theme.gap;
                for chip[i] in FindData.sources: SourceButton {
                    data: chip;
                    active: i == FindData.source;
                    clicked => { FindData.fetch(i); }
                }
            }
        }
    }
    if FindData.rows.length > 0 || FindData.library.length > 0: VerticalLayout {
        spacing: Theme.unit * 2;
        Text {
            text: "In your library";
            color: Theme.dim;
            font-size: Theme.small;
        }
        LibraryCubes { codes: FindData.library; }
    }
    if FindData.dropped != "": Text {
        text: FindData.dropped;
        color: Theme.faint;
        font-size: Theme.small - 1px;
        wrap: word-wrap;
    }
    for row[r] in FindData.rows: Rectangle {
        height: row-column.preferred-height + 5 * Theme.unit;
        border-radius: Theme.radius-row;
        background: row.chosen ? Theme.raised : Theme.surface;
        border-width: row.chosen ? 1px : 0;
        border-color: Theme.line-strong;
        row-column := VerticalLayout {
            x: Theme.unit * 3;
            y: Theme.unit * 2.5;
            width: parent.width - Theme.unit * 6;
            spacing: Theme.unit * 1.5;
            Rectangle {
                height: label.preferred-height;
                label := Text {
                    width: parent.width;
                    text: row.label;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                TouchArea { clicked => { FindData.pick-row(r); } }
            }
            Text {
                text: row.meta;
                color: Theme.dim;
                font-size: Theme.small - 1px;
                font-family: Theme.figure;
            }
            TapCubes {
                codes: row.cubes;
                tapped(n) => { FindData.toggle-cube(r, n); }
            }
        }
    }
    if FindData.rows.length > 0: Rectangle {
        height: plan-column.preferred-height + 6 * Theme.unit;
        border-radius: Theme.radius;
        background: Theme.surface;
        plan-column := VerticalLayout {
            x: Theme.pad;
            y: Theme.unit * 3;
            width: parent.width - 2 * Theme.pad;
            spacing: Theme.unit * 2;
            Text {
                text: FindData.plan;
                color: Theme.text;
                wrap: word-wrap;
            }
            if FindData.plan-detail != "": Text {
                text: FindData.plan-detail;
                color: Theme.dim;
                font-size: Theme.small;
                wrap: word-wrap;
            }
            if FindData.can-follow: HorizontalLayout {
                spacing: Theme.gap;
                Text {
                    text: "Follow new episodes";
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Switch {
                    on: FindData.follow;
                    toggled => { FindData.set-follow(!FindData.follow); }
                }
            }
            if FindData.has-had: HorizontalLayout {
                spacing: Theme.gap;
                Text {
                    text: "Replace current episodes";
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Switch {
                    on: FindData.replace;
                    toggled => { FindData.set-replace(!FindData.replace); }
                }
            }
            Button {
                text: FindData.go-text;
                primary: true;
                enabled: FindData.can-go && !FindData.busy;
                clicked => { FindData.go(); }
            }
            TextButton {
                text: "See every release from this source";
                clicked => { FindData.list-all(); }
            }
        }
    }
}

component ReleaseItem inherits Rectangle {
    in property <ReleaseRow> data;
    callback download();
    height: column.preferred-height + 5 * Theme.unit;
    border-radius: Theme.radius-row;
    background: root.data.best ? Theme.raised : Theme.surface;
    border-width: root.data.best ? 1px : 0;
    border-color: Theme.line-strong;
    column := VerticalLayout {
        x: Theme.unit * 3;
        y: Theme.unit * 2.5;
        width: parent.width - Theme.unit * 6;
        spacing: Theme.unit;
        if root.data.best || root.data.on-disk: HorizontalLayout {
            spacing: Theme.gap;
            alignment: start;
            if root.data.best: Text {
                text: "BEST FIT";
                color: Theme.accent;
                font-size: Theme.small - 2px;
                font-family: Theme.figure;
                letter-spacing: 1.2px;
            }
            if root.data.on-disk: Text {
                text: "ON DISK";
                color: Theme.ok;
                font-size: Theme.small - 2px;
                font-family: Theme.figure;
                letter-spacing: 1.2px;
            }
        }
        Text {
            text: root.data.title;
            color: Theme.text;
            font-size: Theme.small + 1px;
            wrap: word-wrap;
        }
        Text {
            text: root.data.facts;
            color: root.data.tone == 2 ? Theme.bad : Theme.dim;
            font-size: Theme.small - 1px;
            font-family: Theme.figure;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            TextButton {
                text: "Download";
                clicked => { root.download(); }
            }
        }
    }
}

component ReleaseList inherits VerticalLayout {
    spacing: Theme.unit * 3;
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        if FindData.best-fit: Button {
            text: "Try best fit";
            clicked => { FindData.apply-best-fit(); }
        }
        if FindData.can-undo: Button {
            text: "Back a step";
            clicked => { FindData.undo(); }
        }
    }
    if FindData.best-fit-line != "": Text {
        text: FindData.best-fit-line;
        color: Theme.faint;
        font-size: Theme.small - 1px;
        wrap: word-wrap;
    }
    if FindData.groups.length > 0: Rectangle {
        height: 9 * Theme.unit;
        Flickable {
            content-width: group-row.preferred-width;
            group-row := HorizontalLayout {
                spacing: Theme.unit * 1.5;
                for g[i] in FindData.groups: Rectangle {
                    height: 9 * Theme.unit;
                    width: chip-text.preferred-width + 6 * Theme.unit;
                    border-radius: self.height / 2;
                    background: touch.pressed ? Theme.pressed : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.line;
                    chip-text := Text {
                        text: g.label + "  " + g.count;
                        color: Theme.text;
                        font-size: Theme.small;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    touch := TouchArea { clicked => { FindData.apply-group(i); } }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        SearchField {
            placeholder: "Narrow, or -word to leave out";
            text <=> FindData.narrow;
            accepted(t) => { FindData.apply-narrow(t); }
        }
    }
    for row[i] in FindData.releases: ReleaseItem {
        data: row;
        download => { FindData.download-release(i); }
    }
    if FindData.releases.length > 0: HorizontalLayout {
        spacing: Theme.gap;
        Button {
            text: "Download all " + FindData.releases.length;
            clicked => { FindData.download-all(); }
        }
        Button {
            text: "Subscribe";
            primary: true;
            clicked => { FindData.subscribe(); }
        }
    }
}

export component FindPage inherits Rectangle {
    background: Theme.ground;
    TouchArea { }
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: Theme.unit * 2;
            padding-bottom: Theme.pad * 2;
            spacing: Theme.unit * 3;
            HorizontalLayout {
                spacing: Theme.unit * 3;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/arrow-left.svg");
                        clicked => { FindData.back(); }
                    }
                }
                PageTitle { title: "Downloads"; }
            }
            SearchField {
                placeholder: "A show, or a release name";
                text <=> FindData.text;
                accepted(t) => { FindData.search(t); }
            }
            if FindData.line != "": Text {
                text: FindData.line;
                color: Theme.dim;
                font-size: Theme.small;
                wrap: word-wrap;
            }
            if FindData.error != "": Text {
                text: FindData.error;
                color: Theme.warn;
                font-size: Theme.small;
                wrap: word-wrap;
            }
            if FindData.view == 0: VerticalLayout {
                spacing: Theme.unit * 3;
                Segmented {
                    options: FindData.lenses;
                    picked: FindData.lens;
                    pick(i) => { FindData.pick-lens(i); }
                }
                if FindData.lens-line != "": Text {
                    text: FindData.lens-line;
                    color: Theme.dim;
                    font-size: Theme.small;
                    wrap: word-wrap;
                }
                TileGrid {
                    tiles: FindData.lens-tiles;
                    open(i) => { FindData.open-tile(i); }
                }
            }
            if FindData.view == 1: ShowView { }
            if FindData.view == 2: ReleaseList { }
        }
    }
}
