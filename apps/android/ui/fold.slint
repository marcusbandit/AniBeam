// How the screen is folded, and where that puts the panes. Three postures, one rule set:
//
//   folded    the phone: one column and the bar along the bottom.
//   open      flat and wide: a rail down the left and two columns, parted by a hairline.
//   half      bent under 170 degrees and held like a book: the same two columns, moved so
//             the crease falls in the gutter between them and nothing lies on it.
//
// Stood up like a laptop, with the crease across the screen, the pages keep the open layout
// and only the player splits: the picture above the crease, the controls below it. A
// clamshell (a flip phone) is that way up at rotation 0, so the crease's place and direction
// come from the phone's own report where it gives one, and are only guessed as a book
// fold's, down the middle and turning with the display, where it does not.
//
// A change of posture moves the panes and the rail to their new places over `settle` rather
// than jumping. Rust sets the hinge from the sensor; the window sets its size and insets.
// Panes are in the coordinates of the body, the area the pages draw in.

import { Theme } from "theme.slint";

export struct Area {
    x: length,
    y: length,
    width: length,
    height: length,
}

export global Fold {
    // The hinge in degrees, 180 flat. A phone with no hinge stays at 180.
    in property <float> hinge: 180;
    // The crease runs from left to right: a clamshell's upright, a book fold's turned.
    in property <bool> crease-across;
    // The phone reported where its crease is (Android's FoldingFeature). Otherwise the
    // layout takes it for a book fold's, down the middle of the window.
    in property <bool> crease-known;
    // The phone reports itself half open, for one with no hinge sensor to read.
    in property <bool> crease-half;
    // Where the reported crease starts and ends across the axis it crosses, in window
    // coordinates: its top and bottom when it runs across, its left and right otherwise.
    in property <length> crease-start;
    in property <length> crease-end;

    in-out property <length> width;
    in-out property <length> height;
    in-out property <length> inset-top;
    in-out property <length> inset-bottom;
    in-out property <length> inset-left;
    in-out property <length> inset-right;

    // A phone held upright is narrow; an unfolded inner screen or a phone on its side is wide.
    out property <bool> wide: self.width >= 600px || self.width > self.height;
    // The screen with the crease in it. The outer screen of a book foldable is a phone's,
    // under 600 across its short side whichever way it is turned; the inner one is not.
    // Opened a little while the outer screen is still the one lit, the hinge bends but no
    // crease runs through the picture, so nothing splits.
    // A clamshell's inner screen is a phone's width, so a reported crease counts on its own.
    out property <bool> creased: self.crease-known || Math.min(self.width, self.height) >= 600px;
    // Under 30 degrees the phone is shut and shows its outer screen, which turned on its side
    // is wide too: that is a phone in landscape, not a bent inner screen.
    property <bool> bent: self.creased && ((self.hinge < 170 && self.hinge > 30) || self.crease-half);
    out property <bool> half: self.bent && !self.crease-across;
    // Stood up like a laptop, for the player.
    out property <bool> stood: self.bent && self.crease-across;
    // 0 folded, 1 open, 2 half as a book.
    out property <int> posture: !self.wide ? 0 : self.half ? 2 : 1;
    // Two panes side by side.
    out property <bool> split: self.posture != 0;
    // How long a change of posture takes to move things into place. Only a bend glides: a
    // fold or unfold swaps the whole screen, and the window clears `still` while it resizes.
    in-out property <bool> still: true;
    out property <duration> settle: self.still ? 340ms : 0ms;
    // Set by the window while a bend moves things, so what glides then (a grid's tiles)
    // does not glide when it changes for any other reason.
    in-out property <bool> moving;
    out property <duration> glide: self.moving ? self.settle : 0ms;

    // The navigation: a bar along the bottom when folded, a rail otherwise.
    out property <bool> rail: self.posture != 0;
    out property <length> bar-height: 72px;
    out property <length> rail-width: self.posture == 2 ? 84px : 104px;

    // The body, in window coordinates.
    out property <length> body-x: self.inset-left + (self.rail ? self.rail-width : 0);
    out property <length> body-y: self.inset-top;
    out property <length> body-width: self.width - self.body-x - self.inset-right;
    out property <length> body-height: self.height - self.body-y - self.inset-bottom - (self.rail ? 0 : self.bar-height);

    // The crease's middle in window coordinates: where the phone says, or the window's middle.
    out property <length> crease-mid-x: self.crease-known && !self.crease-across ? (self.crease-start + self.crease-end) / 2 : self.width / 2;
    out property <length> crease-mid-y: self.crease-known && self.crease-across ? (self.crease-start + self.crease-end) / 2 : self.height / 2;
    // The crease, in body coordinates, and the ground kept clear around it, wider for a
    // hinge with a gap of its own.
    out property <length> gutter: Math.max(40px, self.crease-end - self.crease-start + 16px);
    out property <length> crease-x: self.crease-mid-x - self.body-x;
    out property <length> crease-y: self.crease-mid-y - self.body-y;

    // A sheet or a question, in window coordinates: the whole width folded, the right page
    // as a book, and a column in the middle otherwise.
    out property <length> sheet-x: self.posture == 0 ? self.inset-left
        : self.posture == 2 ? self.crease-mid-x + self.gutter / 2
        : (self.width - self.sheet-width) / 2;
    out property <length> sheet-width: self.posture == 0 ? self.width - self.inset-left - self.inset-right
        : self.posture == 2 ? self.width - self.crease-mid-x - self.gutter / 2 - self.inset-right
        : Math.min(560px, self.width - self.inset-left - self.inset-right);

    // The pane that picks and the pane that shows. `share` is the picking pane's part of an
    // open screen: a page with a grid to pick from gives it more, one with a short list less.
    // Half folded the crease decides instead. Folded, both are the whole body.
    public pure function pick(share: float) -> Area {
        if (self.posture == 1) {
            return { x: 0, y: 0, width: self.body-width * share - 0.5px, height: self.body-height };
        }
        if (self.posture == 2) {
            return { x: 0, y: 0, width: self.crease-x - self.gutter / 2, height: self.body-height };
        }
        return { x: 0, y: 0, width: self.body-width, height: self.body-height };
    }

    public pure function show(share: float) -> Area {
        if (self.posture == 1) {
            return { x: self.body-width * share + 0.5px, y: 0, width: self.body-width * (1 - share) - 0.5px, height: self.body-height };
        }
        if (self.posture == 2) {
            return { x: self.crease-x + self.gutter / 2, y: 0, width: self.body-width - self.crease-x - self.gutter / 2, height: self.body-height };
        }
        return { x: 0, y: 0, width: self.body-width, height: self.body-height };
    }

    // A pane's width without the page margins a Scroll gives it: what a grid in it lays
    // out for.
    public pure function inner(area: Area) -> length {
        return area.width - 2 * (Theme.grout + Theme.unit);
    }
}
