import { Theme } from "theme.slint";
import { Ask } from "more.slint";
import { AppData } from "data.slint";
import { ClampedText, EmptyNote, PageTitle, Poster, SectionHead, TileGrid, TileRow } from "widgets.slint";

// The next episode to air, set like the head of the desktop's show view: the poster, the
// title in the display cut, the episode, and the countdown as a figure in the poster's ink.
component NextUp inherits Rectangle {
    height: body.preferred-height;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.raised : Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    body := HorizontalLayout {
        padding: Theme.unit * 3;
        spacing: Theme.unit * 4;
        Poster {
            width: 24 * Theme.unit;
            height: self.width * Theme.poster-ratio;
            source: AppData.hero.poster;
            has-image: AppData.hero.has-poster;
            initials: AppData.hero.initials;
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.unit * 2;
            Text {
                text: "Next to air";
                color: Theme.dim;
                font-size: Theme.small;
            }
            ClampedText {
                text: AppData.hero.title;
                font-size: Theme.section - 2px;
                face: Theme.display-face;
                lines: 3;
                leading: 1.05;
            }
            Text {
                text: AppData.hero.episode;
                color: Theme.dim;
                font-size: Theme.small;
                font-family: Theme.figure;
                wrap: word-wrap;
            }
            Text {
                text: AppData.hero.countdown;
                color: AppData.hero.ink;
                font-size: Theme.large + 2px;
                font-family: Theme.figure;
            }
        }
    }
    touch := TouchArea {
        clicked => { AppData.open-series(AppData.hero.id); }
    }
}

// Seven days from Monday, the desktop's segmented idiom: the picked day carried by the soft
// accent with its edge, today ringed, a dot under a day something airs on.
component WeekStrip inherits Rectangle {
    height: 17 * Theme.unit;
    property <length> cell: (self.width - 6 * Theme.unit) / 7;
    for day[i] in AppData.days: Rectangle {
        x: i * (root.cell + Theme.unit);
        width: root.cell;
        height: parent.height;
        border-radius: self.width / 2;
        background: i == AppData.day ? Theme.accent-soft : touch.pressed ? Theme.pressed : Theme.surface;
        border-width: 1px;
        border-color: i == AppData.day ? Theme.accent-edge : day.today ? Theme.line-strong : Theme.line;
        animate background { duration: 120ms; }
        VerticalLayout {
            alignment: center;
            spacing: Theme.unit;
            Text {
                text: day.weekday;
                color: i == AppData.day ? Theme.accent : Theme.dim;
                font-size: Theme.small - 1.5px;
                horizontal-alignment: center;
            }
            Text {
                text: day.date;
                color: i == AppData.day ? Theme.accent : Theme.text;
                font-size: Theme.normal + 1px;
                font-family: Theme.figure;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 5px;
                Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: day.count == 0 ? transparent : i == AppData.day ? Theme.accent : Theme.dim;
                }
            }
        }
        touch := TouchArea { clicked => { AppData.pick-day(i); } }
    }
}

export component HomePage inherits Rectangle {
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.grout + Theme.unit;
            padding-right: Theme.grout + Theme.unit;
            padding-top: Theme.unit * 4;
            padding-bottom: Theme.pad * 2;
            spacing: Theme.unit * 4;
            PageTitle {
                title: "Home";
                note: AppData.home-note;
            }
            if AppData.hero.show: NextUp { }
            SectionHead {
                title: "This week";
                note: AppData.day-title;
            }
            WeekStrip { }
            if AppData.day-tiles.length > 0: TileGrid {
                tiles: AppData.day-tiles;
                holdable: true;
                open(id) => { AppData.open-series(id); }
                held(id, title) => {
                    Ask.menu-id = id;
                    Ask.menu-title = title;
                }
            }
            for shelf in AppData.home-shelves: VerticalLayout {
                spacing: Theme.unit * 3;
                SectionHead {
                    title: shelf.title;
                    note: shelf.count;
                }
                TileRow {
                    tiles: shelf.tiles;
                    holdable: true;
                    open(id) => { AppData.open-series(id); }
                    held(id, title) => {
                        Ask.menu-id = id;
                        Ask.menu-title = title;
                    }
                }
            }
            if AppData.ready && !AppData.hero.show && AppData.home-shelves.length == 0: EmptyNote {
                title: "Nothing on this phone yet";
                body: "Shows you download here, and what airs for them, show up on Home. Find one in Downloads.";
            }
        }
    }
}
