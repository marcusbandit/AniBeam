import { Theme } from "theme.slint";
import { AppData } from "data.slint";
import { Button, EmptyNote, PageTitle, SearchField, Segmented, TileGrid } from "widgets.slint";

// Everything on this phone, or, picked above, what another AniBeam on the tailnet has.
export component LibraryPage inherits Rectangle {
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: Theme.unit * 2;
            padding-bottom: Theme.pad * 2;
            spacing: Theme.unit * 3;
            PageTitle {
                title: "Library";
                note: AppData.library-note;
            }
            if AppData.devices.length > 1: Segmented {
                options: AppData.devices;
                picked: AppData.device;
                pick(i) => { AppData.pick-device(i); }
            }
            SearchField {
                placeholder: AppData.device == 0 ? "Search this phone" : "Search " + AppData.devices[AppData.device];
                text <=> AppData.query;
                edited(text) => { AppData.search(text); }
            }
            if AppData.device == 0 && AppData.query != "": Button {
                text: "Find \"" + AppData.query + "\" to download";
                clicked => { AppData.open-search(AppData.query); }
            }
            if AppData.library.length > 0: TileGrid {
                tiles: AppData.library;
                open(id) => {
                    if (AppData.device == 0) {
                        AppData.open-series(id);
                    } else {
                        AppData.open-remote(id);
                    }
                }
            }
            if AppData.library.length == 0: EmptyNote {
                title: AppData.library-empty;
                body: AppData.device == 0 && AppData.query == ""
                    ? "Episodes you download on this phone land here. Find something to download in More."
                    : "";
            }
        }
    }
}
