import { Theme } from "theme.slint";
import { Ask } from "more.slint";
import { FindData } from "find.slint";
import { AppData, Nav } from "data.slint";
import { Button, EmptyNote, PageTitle, SearchField, Segmented, TileGrid } from "widgets.slint";

// Everything on this phone, or, picked above, what another AniBeam on the tailnet has.
export component LibraryPage inherits Rectangle {
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.grout + Theme.unit;
            padding-right: Theme.grout + Theme.unit;
            padding-top: Theme.unit * 4;
            padding-bottom: Theme.pad * 2;
            spacing: Theme.unit * 4;
            PageTitle {
                title: "Library";
                note: AppData.library-note;
            }
            if AppData.devices.length > 1: Segmented {
                options: AppData.devices;
                picked: AppData.device;
                pick(i) => { AppData.pick-device(i); }
            }
            // The other device's library comes once a minute; this asks for it now.
            if AppData.device != 0: HorizontalLayout {
                alignment: start;
                Button {
                    text: "Refresh";
                    icon: @image-url("icons/refresh-cw.svg");
                    has-icon: true;
                    small: true;
                    clicked => { AppData.refresh(); }
                }
            }
            SearchField {
                placeholder: AppData.device == 0 ? "Search this phone" : "Search " + AppData.devices[AppData.device];
                text <=> AppData.query;
                edited(text) => { AppData.search(text); }
            }
            // Not here: the same words in Downloads, which looks for the show itself.
            if AppData.device == 0 && AppData.query != "": HorizontalLayout {
                alignment: start;
                Button {
                    text: "Find \"" + AppData.query + "\" in Downloads";
                    widest: root.width - 2 * (Theme.grout + Theme.unit);
                    icon: @image-url("icons/download.svg");
                    has-icon: true;
                    small: true;
                    clicked => {
                        FindData.open("");
                        FindData.text = AppData.query;
                        FindData.suggest(AppData.query);
                        Nav.page = 2;
                    }
                }
            }
            if AppData.library.length > 0: TileGrid {
                tiles: AppData.library;
                // The menu's Get and Delete are for this phone's shows.
                held(id, title) => {
                    if (AppData.device == 0) {
                        Ask.menu-id = id;
                        Ask.menu-title = title;
                    }
                }
                open(id) => {
                    if (AppData.device == 0) {
                        AppData.open-series(id);
                    } else {
                        AppData.open-remote(id);
                    }
                }
            }
            if AppData.ready && AppData.library.length == 0: EmptyNote {
                title: AppData.library-empty;
                body: AppData.device == 0 && AppData.query == ""
                    ? "Episodes you download on this phone land here. Find a show in Downloads."
                    : "";
            }
        }
    }
}
