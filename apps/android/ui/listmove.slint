// Moving the list kept on this phone up to a tracker (#749), the desktop's sheet. It opens by
// itself once a tracker has connected and its list has been read, when there is anything to
// move, and from More, Accounts after that. It shows every show it would change, what is
// kept here beside what the tracker has now, and moves nothing until Move is pressed.

import { Theme } from "theme.slint";
import { Button, ListGroup, ListRow } from "widgets.slint";
import { Sheet } from "sheet.slint";
import { Tr } from "tr.slint";

export struct MoveLine {
    title: string,
    here: string,
    there: string,
}

export global MoveData {
    // The sheet is up.
    in property <bool> open;
    // "AniList" or "MyAnimeList", the tracker the sheet moves to.
    in property <string> site;
    in property <[MoveLine]> rows;
    // The sheet's own lines, worded in Rust so the count reads right.
    in property <string> lead;
    in property <string> move-label;
    // How many shows wait on this phone for the tracker named in `waiting-site`; the row in
    // Accounts shows when it is above 0.
    in property <int> waiting;
    in property <string> waiting-line;
    // How the last move went.
    in property <string> note;
    // Accounts' row: open the sheet for what waits.
    callback review();
    callback move();
    callback later();
    // Accounts opened: count what waits.
    callback read();
}

// The row in Accounts that opens the sheet once there is something to move.
export component MoveWaiting inherits VerticalLayout {
    spacing: Theme.unit * 3;
    if MoveData.waiting > 0: ListGroup {
        ListRow {
            label: Tr.t("move-lists-label");
            helper: MoveData.waiting-line;
            tappable: true;
            chevron: true;
            last: true;
            clicked => { MoveData.review(); }
        }
    }
    if MoveData.note != "": Text {
        text: MoveData.note;
        color: Theme.dim;
        font-size: Theme.small;
        wrap: word-wrap;
    }
}

export component MoveSheet inherits Sheet {
    dismissed => { MoveData.later(); }
    Text {
        text: Tr.s("move-title", "site", MoveData.site);
        color: Theme.text;
        font-size: Theme.section;
        font-family: Theme.display-face;
        wrap: word-wrap;
    }
    Text {
        text: MoveData.lead;
        color: Theme.dim;
        font-size: Theme.small + 1px;
        wrap: word-wrap;
    }
    Rectangle {
        height: Math.min(lines.preferred-height, 70 * Theme.unit);
        clip: true;
        Flickable {
            interactive: lines.preferred-height > parent.height;
            content-height: lines.preferred-height;
            lines := VerticalLayout {
                width: parent.width;
                for row[i] in MoveData.rows: Rectangle {
                    height: texts.preferred-height + 5 * Theme.unit;
                    texts := VerticalLayout {
                        y: 2.5 * Theme.unit;
                        height: self.preferred-height;
                        alignment: start;
                        spacing: Theme.unit / 2;
                        Text {
                            text: row.title;
                            color: Theme.text;
                            font-family: Theme.strong-face;
                            overflow: elide;
                        }
                        Text {
                            text: Tr.s("move-here", "list", row.here);
                            color: Theme.text;
                            font-size: Theme.small;
                            overflow: elide;
                        }
                        Text {
                            text: Tr.s2("move-there", "site", MoveData.site, "list", row.there);
                            color: Theme.dim;
                            font-size: Theme.small;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }
            }
        }
    }
    Text {
        text: Tr.t("move-later-hint");
        color: Theme.faint;
        font-size: Theme.small;
    }
    Button {
        text: MoveData.move-label;
        primary: true;
        clicked => { MoveData.move(); }
    }
    Button {
        text: Tr.t("move-not-now");
        clicked => { MoveData.later(); }
    }
}
