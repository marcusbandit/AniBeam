import { Theme } from "theme.slint";
import { AppData } from "data.slint";
import { Tr } from "tr.slint";
import { Ask, HostField } from "more.slint";
import { Button, Figure, ListGroup, ListRow, Slider, TextButton } from "widgets.slint";
import { RepoPanes } from "repos.slint";
import { NotifyPreview, NotifyRow } from "notify.slint";
import { LangList } from "lang.slint";

// The first run, one question a step: the language, who you are on AniList and MAL, Wi-Fi or mobile data,
// how much room the phone gives Anibeam, whether downloads show in the notifications,
// which endpoint repo it searches, and which computer's Anibeam it reaches, if any. Shown once; More can run it again. Each step
// is a page in the desktop's idiom: the step's title in the display cut, a dim line, the
// one pane it asks about, and the buttons at the foot where a thumb is.
export component Onboarding inherits Rectangle {
    background: Theme.ground;
    property <int> steps: 8;
    property <[{title: string, note: string}]> pages: [
        { title: Tr.t("onb-welcome-title"), note: Tr.t("onb-welcome-note") },
        { title: Tr.t("onb-language-title"), note: Tr.t("onb-language-note") },
        { title: Tr.t("onb-lists-title"), note: Tr.t("onb-lists-note") },
        { title: Tr.t("onb-wifi-title"), note: Tr.t("onb-wifi-note") },
        { title: Tr.t("onb-storage-title"), note: Tr.t("onb-storage-note") },
        { title: Tr.t("onb-notify-title"), note: Tr.t("onb-notify-note") },
        { title: Tr.t("onb-sites-title"), note: Tr.t("onb-sites-note") },
        { title: Tr.t("onb-computer-title"), note: Tr.t("onb-computer-note") },
    ];

    TouchArea { }

    // Where you are: one segment a step, the ones done in the accent.
    HorizontalLayout {
        x: Theme.pad;
        y: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        height: 3px;
        spacing: Theme.unit * 1.5;
        for i in root.steps: Rectangle {
            border-radius: 1.5px;
            background: i <= AppData.step ? Theme.accent : Theme.pressed;
            animate background { duration: 200ms; }
        }
    }

    Flickable {
        y: Theme.pad + 3px;
        height: foot.y - self.y;
        VerticalLayout {
            alignment: start;
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: Theme.pad * 2;
            padding-bottom: Theme.pad;
            spacing: Theme.unit * 4;

            if AppData.step == 0: Image {
                height: 20 * Theme.unit;
                width: self.height;
                source: @image-url("icons/app.png");
            }
            Text {
                text: root.pages[AppData.step].title;
                color: Theme.text;
                font-size: AppData.step == 0 ? 72px : Theme.page + 6px;
                font-family: Theme.display-face;
                wrap: word-wrap;
            }
            Text {
                text: root.pages[AppData.step].note;
                color: Theme.dim;
                font-size: Theme.normal + 1px;
                wrap: word-wrap;
            }
            Rectangle { height: Theme.unit * 2; }

            if AppData.step == 1: LangList { }

            if AppData.step == 2: ListGroup {
                ListRow {
                    label: Tr.t("tracker-anilist");
                    helper: AppData.anilist-state;
                    tappable: true;
                    chevron: true;
                    clicked => { AppData.connect-tracker(0); }
                }
                ListRow {
                    label: Tr.t("tracker-mal");
                    helper: AppData.mal-state;
                    tappable: true;
                    chevron: true;
                    last: true;
                    clicked => { AppData.connect-tracker(1); }
                }
            }

            if AppData.step == 3: ListGroup {
                ListRow {
                    label: Tr.t("onb-wifi-only");
                    helper: AppData.wifi-only ? Tr.t("onb-wifi-on") : Tr.t("onb-wifi-off");
                    last: true;
                    switch: true;
                    on: AppData.wifi-only;
                    toggled => {
                        if (AppData.wifi-only) {
                            Ask.mobile = true;
                        } else {
                            AppData.set-wifi-only(true);
                        }
                    }
                }
            }

            if AppData.step == 4: VerticalLayout {
                spacing: Theme.unit * 4;
                Figure {
                    value: AppData.limit-label;
                    caption: Tr.t("onb-storage-caption");
                }
                Slider {
                    minimum: 1;
                    maximum: AppData.disk-gb;
                    value: AppData.limit-gb;
                    moved(gb) => { AppData.set-limit(AppData.limit-on, gb); }
                }
                if AppData.free-line != "": Text {
                    text: AppData.free-line;
                    color: Theme.dim;
                    font-size: Theme.small;
                    wrap: word-wrap;
                }
                ListGroup {
                    ListRow {
                        label: Tr.t("onb-use-cap");
                        helper: AppData.limit-on
                            ? Tr.s("onb-cap-on", "cap", AppData.limit-label)
                            : Tr.t("onb-cap-off");
                        last: true;
                        switch: true;
                        on: AppData.limit-on;
                        toggled => { AppData.set-limit(!AppData.limit-on, AppData.limit-gb); }
                    }
                }
            }

            if AppData.step == 5: VerticalLayout {
                spacing: Theme.unit * 4;
                NotifyPreview { }
                ListGroup {
                    NotifyRow { last: true; }
                }
            }

            if AppData.step == 6: VerticalLayout {
                spacing: Theme.unit * 4;
                RepoPanes { }
            }

            if AppData.step == 7: HostField { }
        }
    }

    foot := VerticalLayout {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        y: parent.height - self.preferred-height;
        padding-bottom: Theme.pad;
        spacing: Theme.unit;
        Button {
            text: AppData.step == root.steps - 1 ? Tr.t("onb-start") : Tr.t("onb-continue");
            primary: true;
            clicked => {
                if (AppData.step >= root.steps - 1) {
                    // A computer typed in counts as saved; one that does not read stays
                    // here with its error.
                    if (AppData.host-address != "") {
                        AppData.save-host(AppData.host-address);
                    }
                    if (AppData.host-address == "" || AppData.host-tone != 1) {
                        AppData.finish-onboarding();
                    }
                } else {
                    AppData.step += 1;
                }
            }
        }
        TextButton {
            text: AppData.step > 0 ? Tr.t("onb-back") : "";
            clicked => {
                if (AppData.step > 0) {
                    AppData.step -= 1;
                }
            }
        }
    }
}
