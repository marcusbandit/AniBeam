// The two pieces every page is built from in the fold layouts: a Leaf is one pane at an
// Area of Fold's, a Scroll is a page's column of content.

import { Theme } from "theme.slint";
import { Area, Fold } from "fold.slint";

// One pane. A change of posture slides it to its new place. Open, the right one is parted
// from the left by a hairline; half folded the crease parts them, so the line fades out.
export component Leaf inherits Rectangle {
    in property <Area> area;
    x: root.area.x;
    y: root.area.y;
    width: root.area.width;
    height: root.area.height;
    animate x, y, width, height { duration: Fold.settle; easing: ease-in-out; }
    clip: true;
    if root.x > 0: Rectangle {
        x: 0;
        width: 1px;
        background: Theme.line;
        opacity: Fold.posture == 1 ? 1 : 0;
        animate opacity { duration: Fold.settle; }
    }
    @children
}

// A page's content as one scrolling column, with the page margins. Content that fits does
// not move under a finger.
export component Scroll inherits Flickable {
    in property <length> pad-bottom: Theme.pad * 2;
    // Only ever as wide as the pane: nothing in a page scrolls sideways as a whole.
    content-width: self.width;
    content-height: column.preferred-height;
    interactive: self.content-height > self.height + 1px;
    // Content that shrinks to fit comes back into view rather than staying scrolled away.
    changed interactive => {
        if (!self.interactive) {
            self.content-y = 0;
        }
    }
    column := VerticalLayout {
        width: root.width;
        alignment: start;
        padding-left: Theme.grout + Theme.unit;
        padding-right: Theme.grout + Theme.unit;
        padding-top: Theme.unit * 4;
        padding-bottom: root.pad-bottom;
        spacing: Theme.unit * 4;
        @children
    }
}
