import { Theme } from "theme.slint";
import { AppData, EpisodeLine } from "data.slint";
import { ClampedText, Cubes, Poster, ShelfHead } from "widgets.slint";

// One episode, the desktop's row: its cube, the code, the title and a state word, and when
// it aired or airs at the right.
component EpisodeItem inherits Rectangle {
    in property <EpisodeLine> data;
    // Episodes still to air are quieter.
    property <bool> later: root.data.cube == 5;
    height: Math.max(Theme.unit * 11, texts.preferred-height + 3 * Theme.unit);
    border-radius: Theme.radius-row;
    background: root.data.note == "Next up" ? Theme.surface : transparent;
    Rectangle {
        x: Theme.unit * 3;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: root.later ? transparent : Theme.cube(root.data.cube);
        border-width: root.later ? 1px : 0;
        border-color: Theme.line-strong;
    }
    texts := VerticalLayout {
        x: Theme.unit * 8;
        width: parent.width - self.x - date.width - Theme.unit * 5;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: Theme.unit * 2;
            Text {
                text: root.data.code;
                color: root.later ? Theme.faint : Theme.dim;
                font-size: Theme.small;
                font-family: Theme.figure;
                vertical-alignment: center;
            }
            Text {
                text: root.data.title;
                color: root.later ? Theme.faint : Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        if root.data.note != "": Text {
            text: root.data.note;
            color: root.data.note == "Next up" ? Theme.accent : root.data.note == "Missing" ? Theme.yellow : Theme.purple;
            font-size: Theme.small - 1px;
            font-weight: root.data.note == "Next up" ? 600 : 400;
        }
    }
    date := Text {
        x: parent.width - self.width - Theme.unit * 3;
        height: parent.height;
        text: root.data.date;
        color: root.later ? Theme.dim : Theme.faint;
        font-size: Theme.small - 1px;
        font-family: Theme.figure;
        vertical-alignment: center;
    }
}

// The band at the top of a series page, in the poster's hue.
component SeriesBand inherits Rectangle {
    background: AppData.series.band;
    border-radius: Theme.radius-large;
    height: body.preferred-height;
    body := VerticalLayout {
        padding: Theme.unit * 3;
        spacing: Theme.unit * 3;
        HorizontalLayout {
            spacing: Theme.unit * 3;
            Poster {
                width: 26 * Theme.unit;
                height: self.width * Theme.poster-ratio;
                source: AppData.series.poster;
                has-image: AppData.series.has-poster;
                initials: AppData.series.initials;
            }
            VerticalLayout {
                alignment: center;
                spacing: Theme.unit * 1.5;
                ClampedText {
                    text: AppData.series.title;
                    font-size: Theme.large;
                    font-weight: 300;
                    lines: 4;
                }
                if AppData.series.alt-title != "": ClampedText {
                    text: AppData.series.alt-title;
                    font-size: Theme.small;
                    ink: Theme.dim;
                }
                Text {
                    text: AppData.series.facts;
                    color: Theme.dim;
                    font-size: Theme.small - 1px;
                    font-family: Theme.figure;
                    wrap: word-wrap;
                }
                if AppData.series.next != "": Text {
                    text: AppData.series.next;
                    color: AppData.series.ink;
                    font-size: Theme.small;
                    font-family: Theme.figure;
                    wrap: word-wrap;
                }
            }
        }
        if AppData.series.cubes.length > 0: Cubes {
            codes: AppData.series.cubes;
            size: 9px;
            spacing: 3px;
        }
        if AppData.series.progress-text != "": Text {
            text: AppData.series.progress-text;
            color: Theme.text;
            font-size: Theme.small;
        }
    }
}

export component SeriesPage inherits Rectangle {
    background: Theme.ground;
    // Swallow touches so nothing under the page reacts.
    TouchArea { }
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: Theme.unit * 2;
            padding-bottom: Theme.pad * 2;
            spacing: Theme.unit * 2;
            SeriesBand { }
            if AppData.series.synopsis != "": ClampedText {
                text: AppData.series.synopsis;
                font-size: Theme.small;
                ink: Theme.dim;
                lines: 5;
            }
            ShelfHead {
                title: "Episodes";
                count: AppData.episodes.length > 0 ? "" + AppData.episodes.length : "";
            }
            for line in AppData.episodes: EpisodeItem { data: line; }
            if AppData.episodes.length == 0: Text {
                text: "No episodes on this phone and none scheduled.";
                color: Theme.dim;
                font-size: Theme.small;
            }
        }
    }
}
