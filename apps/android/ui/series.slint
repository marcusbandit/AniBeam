import { Theme } from "theme.slint";
import { AppData, EpisodeLine, Nav } from "data.slint";
import { FindData } from "find.slint";
import { Button, ClampedText, Cubes, PageTitle, Poster, SectionHead } from "widgets.slint";

// One episode, the desktop's row: its cube, the code, the title and a state word, and when
// it aired or airs at the right. The next one up sits on a lit row.
component EpisodeItem inherits Rectangle {
    in property <EpisodeLine> data;
    // Episodes still to air are quieter.
    property <bool> later: root.data.cube == 5;
    property <bool> next: root.data.note == "Next up";
    height: Math.max(Theme.unit * 13, texts.preferred-height + 4 * Theme.unit);
    border-radius: Theme.radius-row + 4px;
    background: touch.pressed && root.data.file != 0 ? Theme.pressed : root.data.picked ? Theme.bad-soft : root.next && !AppData.deleting ? Theme.raised : transparent;
    border-width: root.next ? 1px : 0;
    border-color: Theme.line-strong;
    if !AppData.deleting || root.data.file == 0: Rectangle {
        x: Theme.unit * 3;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: root.later ? transparent : Theme.cube(root.data.cube);
        border-width: root.later ? 1px : 0;
        border-color: Theme.line-strong;
        opacity: AppData.deleting ? 0.4 : 1;
    }
    // While deleting, an episode on the phone shows whether it is picked.
    if AppData.deleting && root.data.file != 0: Rectangle {
        x: Theme.unit * 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.data.picked ? Theme.bad : transparent;
        border-width: root.data.picked ? 0 : 1.5px;
        border-color: Theme.line-strong;
    }
    code := Text {
        x: Theme.unit * 8;
        width: Theme.unit * 10;
        height: parent.height;
        text: root.data.code;
        color: root.later ? Theme.faint : Theme.dim;
        font-size: Theme.small;
        font-family: Theme.figure;
        vertical-alignment: center;
    }
    texts := VerticalLayout {
        x: code.x + code.width;
        width: parent.width - self.x - date.width - Theme.unit * 6;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.data.title;
            color: root.later ? Theme.faint : Theme.text;
            font-family: root.next ? Theme.strong-face : Theme.face;
            overflow: elide;
        }
        if root.data.note != "": Text {
            text: root.data.note;
            color: root.next ? Theme.accent : root.data.note == "Missing" ? Theme.yellow : Theme.purple;
            font-size: Theme.small - 0.5px;
        }
    }
    date := Text {
        x: parent.width - self.width - Theme.unit * 3;
        height: parent.height;
        text: root.data.date;
        color: root.later ? Theme.dim : Theme.faint;
        font-size: Theme.small - 1px;
        font-family: Theme.figure;
        vertical-alignment: center;
    }
    // A whole episode on the phone plays at a tap, or is picked while deleting.
    touch := TouchArea {
        enabled: root.data.file != 0;
        clicked => {
            if (AppData.deleting) {
                AppData.toggle-delete(root.data.file);
            } else {
                AppData.play(root.data.file);
            }
        }
    }
}

// While deleting: how many are picked, what deleting does, and Delete or Cancel.
component DeleteBar inherits Rectangle {
    height: col.preferred-height + 7 * Theme.unit;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    col := VerticalLayout {
        x: Theme.pad;
        y: 3.5 * Theme.unit;
        width: parent.width - 2 * Theme.pad;
        height: self.preferred-height;
        spacing: Theme.unit * 3;
        Text {
            text: AppData.delete-count == 0 ? "Tap the episodes to delete."
                : AppData.delete-count == 1 ? "1 episode picked." : AppData.delete-count + " episodes picked.";
            color: Theme.text;
            font-family: Theme.strong-face;
        }
        Text {
            text: "Their files are deleted from this phone. What you watched stays tracked.";
            color: Theme.dim;
            font-size: Theme.small;
            wrap: word-wrap;
        }
        if AppData.delete-error != "": Text {
            text: AppData.delete-error;
            color: Theme.bad;
            font-size: Theme.small;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.gap;
            alignment: start;
            Button {
                text: AppData.delete-count == 1 ? "Delete 1 episode" : "Delete " + AppData.delete-count + " episodes";
                small: true;
                danger: true;
                enabled: AppData.delete-count > 0;
                clicked => { AppData.confirm-delete(); }
            }
            Button {
                text: "Cancel";
                small: true;
                clicked => { AppData.cancel-delete(); }
            }
        }
    }
}

// The head of a series, the desktop show view's: the poster, the title in the display cut,
// its other name, the facts, when the next one airs, and the cubes with the progress.
component SeriesHeadView inherits VerticalLayout {
    spacing: Theme.unit * 4;
    HorizontalLayout {
        spacing: Theme.unit * 4;
        Poster {
            width: 30 * Theme.unit;
            height: self.width * Theme.poster-ratio;
            source: AppData.series.poster;
            has-image: AppData.series.has-poster;
            initials: AppData.series.initials;
        }
        VerticalLayout {
            alignment: end;
            spacing: Theme.unit * 2;
            ClampedText {
                text: AppData.series.title;
                font-size: Theme.page - 8px;
                face: Theme.display-face;
                lines: 4;
                leading: 1.05;
            }
            if AppData.series.alt-title != "": ClampedText {
                text: AppData.series.alt-title;
                font-size: Theme.small;
                ink: Theme.dim;
            }
            Text {
                text: AppData.series.facts;
                color: Theme.dim;
                font-size: Theme.small;
                wrap: word-wrap;
            }
        }
    }
    if AppData.series.next != "": Text {
        text: AppData.series.next;
        color: AppData.series.ink;
        font-size: Theme.normal;
        font-family: Theme.figure;
        wrap: word-wrap;
    }
    if AppData.series.cubes.length > 0: Cubes {
        codes: AppData.series.cubes;
        size: 11px;
        spacing: 3px;
    }
    if AppData.series.progress-text != "": Text {
        text: AppData.series.progress-text;
        color: Theme.text;
        font-size: Theme.small + 0.5px;
    }
}

export component SeriesPage inherits Rectangle {
    background: Theme.ground;

    // Swallow touches so nothing under the page reacts.
    TouchArea { }
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: Theme.grout + Theme.unit;
            padding-right: Theme.grout + Theme.unit;
            padding-top: Theme.unit * 4;
            padding-bottom: Theme.pad * 2;
            spacing: Theme.unit * 4;
            PageTitle {
                back: Nav.page == 0 ? "Home" : Nav.page == 1 ? "Library" : Nav.page == 2 ? "Downloads" : "Back";
                title: "";
                go-back => { AppData.close-series(); }
            }
            SeriesHeadView { }
            // A series of this phone's goes straight to who has it; another device's is
            // read only.
            if AppData.device == 0 || Nav.page == 0: HorizontalLayout {
                alignment: start;
                spacing: Theme.unit * 2;
                if AppData.series.play-file != 0: Button {
                    text: AppData.series.play-label;
                    icon: @image-url("icons/play.svg");
                    has-icon: true;
                    primary: true;
                    clicked => { AppData.play(AppData.series.play-file); }
                }
                Button {
                    text: "Get episodes";
                    icon: @image-url("icons/download.svg");
                    has-icon: true;
                    primary: AppData.series.play-file == 0;
                    clicked => {
                        FindData.find-series(AppData.series.id);
                        AppData.close-series();
                        Nav.page = 2;
                    }
                }
            }
            if AppData.series.synopsis != "": ClampedText {
                text: AppData.series.synopsis;
                font-size: Theme.small + 1px;
                ink: Theme.dim;
                lines: 6;
                leading: 1.4;
            }
            SectionHead {
                title: "Episodes";
                note: AppData.episodes.length > 0 ? "" + AppData.episodes.length : "";
            }
            // Deleting: off, a button to start; on, what it will do and the two ways out.
            if (AppData.device == 0 || Nav.page == 0) && !AppData.deleting && AppData.series-has-files: HorizontalLayout {
                alignment: start;
                Button {
                    text: "Delete episodes";
                    small: true;
                    danger: true;
                    clicked => { AppData.start-delete(); }
                }
            }
            if AppData.deleting: DeleteBar { }
            VerticalLayout {
                spacing: Theme.unit;
                for line in AppData.episodes: EpisodeItem { data: line; }
            }
            if AppData.episodes.length == 0: Text {
                text: "No episodes on this phone and none scheduled.";
                color: Theme.dim;
                font-size: Theme.small;
            }
        }
    }
}
