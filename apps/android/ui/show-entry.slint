// A related or recommended show this phone does not hold: Get its episodes, or read about it
// on AniList. One it does hold opens its own page instead, without this sheet.

import { Theme } from "theme.slint";
import { AppData, Nav } from "data.slint";
import { Button } from "widgets.slint";
import { FindData } from "find.slint";
import { ShowData, ShowSheet } from "show.slint";

export component EntrySheet inherits ShowSheet {
    title: ShowData.entry.title;
    line: ShowData.entry.line + (ShowData.entry.line != "" && ShowData.entry.status != "" ? ", " : "") + ShowData.entry.status;
    dismissed => { ShowData.close(); }
    Button {
        text: "Get episodes";
        icon: @image-url("icons/download.svg");
        has-icon: true;
        primary: true;
        clicked => {
            FindData.open("");
            FindData.text = ShowData.entry.title;
            FindData.suggest(ShowData.entry.title);
            ShowData.close();
            AppData.close-series();
            Nav.page = 2;
        }
    }
    Button {
        text: "Open on AniList";
        icon: @image-url("icons/globe.svg");
        has-icon: true;
        clicked => {
            ShowData.open-link(ShowData.entry.url);
            ShowData.close();
        }
    }
    Button {
        text: "Cancel";
        clicked => { ShowData.close(); }
    }
}
