// Fixes, the desktop's menu of the same name: the things a show can need put right. Episodes
// and dates, the match and rescan are here; each fix opens its own sheet.

import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { Button } from "widgets.slint";
import { MatchData } from "show-match.slint";
import { ShowData, ShowSheet } from "show.slint";
import { Tr } from "tr.slint";

export component FixesSheet inherits ShowSheet {
    title: Tr.t("show-fixes");
    line: ShowData.series-title;
    dismissed => { ShowData.close(); }
    if !ShowData.movie: Button {
        text: Tr.t("dates-title");
        icon: @image-url("icons/calendar-days.svg");
        has-icon: true;
        clicked => { ShowData.open-dates(); }
    }
    Button {
        text: ShowData.matched ? Tr.t("show-fix-match") : Tr.t("show-fix-find-match");
        icon: @image-url("icons/search.svg");
        has-icon: true;
        clicked => {
            MatchData.begin();
            ShowData.sheet = 6;
        }
    }
    Button {
        text: Tr.t("show-fix-rescan");
        icon: @image-url("icons/refresh-cw.svg");
        has-icon: true;
        clicked => {
            ShowData.rescan();
            ShowData.close();
        }
    }
    Button {
        text: Tr.t("common-cancel");
        clicked => { ShowData.close(); }
    }
}
