// The list status and the score of a show, the desktop's status menu and score picker as
// two foot sheets.

import { Theme } from "theme.slint";
import { Button, Slider } from "widgets.slint";
import { ShowData, ShowSheet } from "show.slint";
import { Tr } from "tr.slint";

// One list the show can move to. The one it is on is marked and cannot be picked again.
component ListChoice inherits Rectangle {
    // The status's index, as `ShowData.status-index` counts them.
    in property <int> slot;
    in property <string> label;
    in property <image> icon;
    Button {
        width: parent.width;
        text: ShowData.status-index == root.slot ? Tr.s("show-status-now", "label", root.label) : root.label;
        icon: root.icon;
        has-icon: true;
        primary: ShowData.status-index == root.slot;
        enabled: ShowData.status-index != root.slot;
        clicked => {
            ShowData.set-status(root.slot);
            ShowData.close();
        }
    }
    height: Theme.control;
}

export component StatusSheet inherits ShowSheet {
    title: ShowData.series-title;
    line: ShowData.home;
    dismissed => { ShowData.close(); }
    ListChoice { slot: 0; label: Tr.t("show-status-watching"); icon: @image-url("icons/play.svg"); }
    ListChoice { slot: 1; label: Tr.t("show-status-planning"); icon: @image-url("icons/bookmark.svg"); }
    ListChoice { slot: 2; label: Tr.t("show-status-completed"); icon: @image-url("icons/circle-check.svg"); }
    ListChoice { slot: 3; label: Tr.t("show-status-paused"); icon: @image-url("icons/pause.svg"); }
    ListChoice { slot: 4; label: Tr.t("show-status-dropped"); icon: @image-url("icons/ban.svg"); }
    Button {
        text: Tr.t("common-cancel");
        clicked => { ShowData.close(); }
    }
}

// 0.0 to 10.0 in tenths: a big readout, a slider for the point and a step each way for the
// tenth, Save, and Clear when a score exists.
export component ScoreSheet inherits ShowSheet {
    title: ShowData.series-title;
    line: ShowData.home;
    dismissed => { ShowData.close(); }
    Text {
        text: Math.floor(ShowData.draft / 10) + "." + Math.mod(ShowData.draft, 10);
        color: Theme.text;
        font-size: Theme.page;
        font-family: Theme.figure;
        horizontal-alignment: center;
    }
    Slider {
        minimum: 0;
        maximum: 100;
        value: ShowData.draft;
        moved(v) => { ShowData.draft = Math.round(v); }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: center;
        Button {
            text: "-0.1";
            enabled: ShowData.draft > 0;
            clicked => { ShowData.draft = Math.max(0, ShowData.draft - 1); }
        }
        Button {
            text: "+0.1";
            enabled: ShowData.draft < 100;
            clicked => { ShowData.draft = Math.min(100, ShowData.draft + 1); }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        Button {
            text: Tr.t("common-save");
            primary: true;
            clicked => {
                ShowData.set-score(ShowData.draft);
                ShowData.close();
            }
        }
        if ShowData.score >= 0: Button {
            text: Tr.t("common-clear");
            danger: true;
            clicked => {
                ShowData.set-score(-1);
                ShowData.close();
            }
        }
        Button {
            text: Tr.t("common-cancel");
            clicked => { ShowData.close(); }
        }
    }
}
