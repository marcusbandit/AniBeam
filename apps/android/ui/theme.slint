// The one token file. The look is the desktop's Downloads page (apps/linux/qml/Tokens.qml,
// tesserae-dark) at phone scale: flat glass panes on a near-black ground, hairline edges,
// pills for every control, the tall condensed display cut for page and section titles with
// a dim line of fact beside them, and B612 for figures.

import "fonts/Archivo-Display.ttf";
import "fonts/Archivo-Title.ttf";
import "fonts/Archivo-Ledger.ttf";
import "fonts/Archivo-UI.ttf";
import "fonts/Archivo-UI-Strong.ttf";
import "fonts/B612-Regular.ttf";

export global Theme {
    // The look is More's Appearance (#754): the theme, the accent and the text size set the
    // `in` properties below from Rust, and everything else follows. The defaults are the
    // Graphite Glass dark theme, so a phone that has chosen nothing looks as it always did.
    in property <color> ground: #0e1013;
    // The glass tint: white over a dark ground, the text colour over a light one.
    in property <color> ink: #ffffff;
    in property <bool> dark: true;
    // Menus and sheets that float over the page: the ground lifted, opaque.
    in property <color> float: #1a1c20;

    // Ink.
    in property <color> text: #eef2f5;
    in property <color> dim: #9aa3ad;
    in property <color> faint: #646c75;
    // The accent is near white, as on the desktop: the primary pill is white with ground ink.
    in property <color> accent: #f2f4f6;
    in property <color> on-accent: #0e1013;

    // The few hues, each with one job.
    in property <color> ok: #8cc58a;
    in property <color> warn: #e0b25a;
    in property <color> bad: #ff7a4d;
    in property <color> cyan: #6cc4c0;
    in property <color> purple: #b49be0;
    in property <color> yellow: #e0b25a;

    // A pane is the ink at a low alpha over the ground, so panes nest.
    out property <color> surface: self.ink.with-alpha(self.dark ? 0.035 : 0.045);
    out property <color> raised: self.ink.with-alpha(self.dark ? 0.063 : 0.075);
    out property <color> pressed: self.ink.with-alpha(self.dark ? 0.11 : 0.13);
    out property <color> sunken: self.dark ? #00000047 : self.ink.with-alpha(0.07);
    out property <color> field: self.dark ? #00000047 : self.ink.with-alpha(0.07);
    out property <color> line: self.ink.with-alpha(self.dark ? 0.063 : 0.1);
    out property <color> line-strong: self.ink.with-alpha(self.dark ? 0.15 : 0.2);
    out property <color> accent-soft: self.accent.with-alpha(self.dark ? 0.17 : 0.14);
    out property <color> accent-edge: self.accent.with-alpha(0.5);
    // A primary pill while a finger is on it.
    out property <color> accent-pressed: self.accent.darker(0.2);
    out property <color> bad-soft: self.bad.with-alpha(0.14);
    out property <color> bad-edge: self.bad.with-alpha(0.33);

    // Faces, one per role, cut from Archivo's axes by scripts/cut-fonts.py.
    // display: page and section titles, tall and light. title: names of shows. ui: body and
    // controls. strong: a button's label, a row's name. ledger: small facts. figure: B612,
    // for sizes, rates, times and counts.
    out property <string> display-face: "Archivo Display";
    out property <string> title-face: "Archivo Title";
    out property <string> face: "Archivo UI";
    out property <string> strong-face: "Archivo UI Strong";
    out property <string> ledger-face: "Archivo Ledger";
    out property <string> figure: "B612";

    // The type ramp. The display sizes are the desktop's page (4x) and heading (2.2x) at a
    // phone's body size.
    // Text size multiplies every step: 0.875 to 1.5, as the desktop's.
    in property <float> text-scale: 1;
    out property <length> page: 46px * self.text-scale;
    out property <length> display: 46px * self.text-scale;
    out property <length> section: 31px * self.text-scale;
    out property <length> large: 22px * self.text-scale;
    out property <length> heading: 17px * self.text-scale;
    out property <length> normal: 15px * self.text-scale;
    out property <length> small: 12.5px * self.text-scale;

    // Space comes in steps of one unit; the grout is also the page margin.
    out property <length> unit: 4px;
    out property <length> gap: 2 * unit;
    out property <length> grout: 3 * unit;
    out property <length> pad: 5 * unit;
    // Corners: a pane 18, a row or tag inside one 6; controls are pills at half their height.
    out property <length> radius-small: 6px;
    out property <length> radius-row: 6px;
    out property <length> radius: 18px;
    out property <length> radius-large: 18px;
    out property <length> control: 11 * unit;
    out property <length> control-small: 8 * unit;
    // The least a finger is given: a control drawn smaller still takes touches this tall.
    out property <length> touch: 12 * unit;

    // The poster's foot scrim and the dark glass tag on top of a poster.
    out property <color> scrim: #08090beb;
    out property <color> scrim-mid: #08090ba6;
    out property <color> scrim-clear: #08090b00;
    out property <color> chip: #08090bb8;
    out property <color> chip-edge: #ffffff24;
    out property <color> on-poster: #eef2f5;
    out property <color> on-poster-dim: #aab2bb;
    out property <color> track: self.ink.with-alpha(0.16);

    // Posters are 2:3, like the desktop's.
    out property <float> poster-ratio: 1.5;
    // A poster tile is never narrower than this; the grid adds columns as the width allows.
    out property <length> tile-min: 104px;

    // The episode cube colours, by the core's codes (library::cards::cubes): watched and
    // tracked, watched here, on disk, missing, not downloaded, not aired, downloading.
    out property <color> cube-watched: self.ok;
    out property <color> cube-here: self.cyan;
    out property <color> cube-disk: self.dark ? #ffffff : self.text;
    out property <color> cube-missing: self.warn;
    out property <color> cube-none: self.ink.with-alpha(0.16);
    out property <color> cube-downloading: self.purple;

    // The cube colour for a code: 0 w, 1 l, 2 d, 3 m, 4 g, 5 f, 6 t.
    public pure function cube(code: int) -> color {
        if (code == 0) { return self.cube-watched; }
        if (code == 1) { return self.cube-here; }
        if (code == 2) { return self.cube-disk; }
        if (code == 3) { return self.cube-missing; }
        if (code == 6) { return self.cube-downloading; }
        return self.cube-none;
    }
}
