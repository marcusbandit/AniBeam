// The phone's pieces, after the desktop's Downloads page: glass panes with hairline edges,
// pills for every control, tags of dark glass with a coloured dot, and titles in the tall
// display cut with a dim line of fact on their baseline.

import { Theme } from "theme.slint";
import { Tile } from "data.slint";

// Text that wraps onto at most `lines` lines and ends in an ellipsis past that. A Text in
// a layout grows to its wrapped height whatever max-height says, so this one fixes its
// own height and clips.
export component ClampedText inherits Rectangle {
    in property <string> text;
    in property <int> lines: 2;
    in property <length> font-size: Theme.normal;
    in property <string> face: Theme.face;
    in property <color> ink: Theme.text;
    in property <float> leading: 1.22;
    height: Math.min(inner.preferred-height, root.font-size * root.leading * root.lines);
    clip: true;
    inner := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: root.font-size;
        font-family: root.face;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }
}

// A poster, or the title's initials on a plain pane when there is no poster yet.
export component Poster inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <string> initials;
    border-radius: Theme.radius-small + 2px;
    clip: true;
    background: Theme.sunken;
    border-width: root.has-image ? 0 : 1px;
    border-color: Theme.line;
    if root.has-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    if !root.has-image: Text {
        text: root.initials;
        color: Theme.faint;
        font-size: Theme.large;
        font-family: Theme.title-face;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The desktop's episode cubes: one rounded square per episode, coloured by its state. An
// episode still to air is an outline.
export component Cubes inherits Rectangle {
    in property <[int]> codes;
    in property <length> size: 6px;
    in property <length> spacing: 2px;
    property <int> per-row: Math.max(1, Math.floor((self.width + self.spacing) / (self.size + self.spacing)));
    height: self.codes.length == 0 ? 0 : Math.ceil(self.codes.length / self.per-row) * (self.size + self.spacing) - self.spacing;
    for code[i] in root.codes: Rectangle {
        x: Math.mod(i, root.per-row) * (root.size + root.spacing);
        y: Math.floor(i / root.per-row) * (root.size + root.spacing);
        width: root.size;
        height: root.size;
        border-radius: Math.max(1.5px, root.size / 4);
        background: code == 5 ? transparent : Theme.cube(code);
        border-width: code == 5 ? 1px : 0;
        border-color: Theme.line-strong;
    }
}

// A tag on a poster: dark glass, a coloured dot when it names a state, light writing, so it
// reads on any poster.
export component GlassTag inherits Rectangle {
    in property <string> text;
    in property <color> dot: transparent;
    in property <color> ink: Theme.on-poster;
    width: row.preferred-width + 4 * Theme.unit;
    height: 6 * Theme.unit;
    border-radius: Theme.radius-small;
    background: Theme.chip;
    border-width: 1px;
    border-color: Theme.chip-edge;
    row := HorizontalLayout {
        alignment: center;
        spacing: 1.5 * Theme.unit;
        if root.dot != transparent: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 2 * Theme.unit;
            height: self.width;
            border-radius: self.width / 2;
            background: root.dot;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.small - 1px;
            font-family: Theme.figure;
            vertical-alignment: center;
        }
    }
}

// A pill of glass with a hairline: a source, a filter, a fact. `selected` fills it with the
// soft accent; `dimmed` is a switched-off one, faint and unfilled. Tappable when `tappable`.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <color> ink: Theme.text;
    in property <color> dot: transparent;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> selected;
    in property <bool> dimmed;
    in property <bool> tappable;
    in property <bool> small;
    callback clicked();
    height: root.small ? 9 * Theme.unit : 10 * Theme.unit;
    width: row.preferred-width + (root.small ? 5 : 7) * Theme.unit;
    border-radius: self.height / 2;
    background: root.selected ? Theme.accent-soft : touch.pressed ? Theme.pressed : root.dimmed ? transparent : Theme.raised;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-edge : touch.pressed ? Theme.line-strong : Theme.line;
    animate background { duration: 120ms; }
    property <color> label-ink: root.selected ? Theme.accent : root.dimmed ? Theme.faint : root.ink;
    row := HorizontalLayout {
        alignment: center;
        spacing: 1.5 * Theme.unit;
        if root.dot != transparent: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 2 * Theme.unit;
            height: self.width;
            border-radius: self.width / 2;
            background: root.dot;
        }
        if root.has-icon: Image {
            y: (parent.height - self.height) / 2;
            width: 4 * Theme.unit;
            height: self.width;
            source: root.icon;
            colorize: root.label-ink;
        }
        Text {
            text: root.text;
            color: root.label-ink;
            font-size: root.small ? Theme.small : Theme.normal - 1px;
            font-family: Theme.ledger-face;
            vertical-alignment: center;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.faint;
            font-size: Theme.small;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.tappable;
        clicked => { root.clicked(); }
    }
}

// A pill button with a label and an optional glyph before it. `primary` is the white fill
// with ground ink, `danger` the soft red with a red edge; otherwise raised glass.
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> small;
    in property <bool> enabled: true;
    // The widest it grows; a longer label is cut short with an ellipsis.
    in property <length> widest: 10000px;
    callback clicked();
    height: root.small ? Theme.control-small : Theme.control;
    min-width: Math.min(row.preferred-width + (root.small ? 7 : 10) * Theme.unit, root.widest);
    border-radius: self.height / 2;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary ? (touch.pressed ? #c9cdd2 : Theme.accent)
        : root.danger ? (touch.pressed ? #ff7a4d40 : Theme.bad-soft)
        : (touch.pressed ? Theme.pressed : Theme.raised);
    border-width: root.primary ? 0 : 1px;
    border-color: root.danger ? Theme.bad-edge : Theme.line;
    animate background { duration: 120ms; }
    property <color> ink: root.primary ? Theme.on-accent : root.danger ? Theme.bad : Theme.text;
    row := HorizontalLayout {
        alignment: center;
        spacing: 2 * Theme.unit;
        if root.has-icon: Image {
            y: (parent.height - self.height) / 2;
            width: (root.small ? 4 : 4.5) * Theme.unit;
            height: self.width;
            source: root.icon;
            colorize: root.ink;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: root.small ? Theme.small + 0.5px : Theme.normal;
            font-family: Theme.strong-face;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Words that act, quieter than a button: the second choice under a primary one.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.dim;
    callback clicked();
    height: 10 * Theme.unit;
    min-width: label.preferred-width + 6 * Theme.unit;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.raised : transparent;
    label := Text {
        text: root.text;
        color: touch.pressed ? Theme.text : root.ink;
        font-size: Theme.small + 0.5px;
        font-family: Theme.strong-face;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The small pill above a title that goes back where you came from: "Downloads", "Library".
export component BackPill inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 8 * Theme.unit;
    width: row.preferred-width + 6 * Theme.unit;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.pressed : Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    row := HorizontalLayout {
        alignment: center;
        spacing: 1.5 * Theme.unit;
        Image {
            y: (parent.height - self.height) / 2;
            width: 4 * Theme.unit;
            height: self.width;
            source: @image-url("icons/arrow-left.svg");
            colorize: Theme.dim;
        }
        Text {
            text: root.text;
            color: Theme.dim;
            font-size: Theme.small + 0.5px;
            vertical-alignment: center;
        }
    }
    // A finger is bigger than the pill: the touch area reaches past it.
    touch := TouchArea {
        x: -2 * Theme.unit;
        y: -2 * Theme.unit;
        width: parent.width + 4 * Theme.unit;
        height: parent.height + 4 * Theme.unit;
        clicked => { root.clicked(); }
    }
}

// A round glyph-only button of glass.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> spinning;
    in property <bool> danger;
    in property <bool> primary;
    callback clicked();
    width: 11 * Theme.unit;
    height: self.width;
    border-radius: self.width / 2;
    background: root.primary ? (touch.pressed ? #c9cdd2 : Theme.accent)
        : root.danger ? Theme.bad-soft
        : touch.pressed ? Theme.pressed : Theme.raised;
    border-width: root.primary ? 0 : 1px;
    border-color: root.danger ? Theme.bad-edge : Theme.line;
    animate background { duration: 120ms; }
    Image {
        width: 5 * Theme.unit;
        height: self.width;
        source: root.icon;
        colorize: root.primary ? Theme.on-accent : root.danger ? Theme.bad : root.spinning ? Theme.text : Theme.dim;
        transform-rotation: root.spinning ? (animation-tick() / 1000ms) * 360deg : 0deg;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// An on and off switch, the desktop's: a dark pill with a grey knob, white when on.
export component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled();
    width: 12 * Theme.unit;
    height: 7 * Theme.unit;
    border-radius: self.height / 2;
    background: root.on ? Theme.accent : Theme.sunken;
    border-width: root.on ? 0 : 1px;
    border-color: Theme.line-strong;
    animate background { duration: 150ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: parent.height - 8px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.on ? Theme.on-accent : Theme.dim;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        x: -2 * Theme.unit;
        y: -2 * Theme.unit;
        width: parent.width + 4 * Theme.unit;
        height: parent.height + 4 * Theme.unit;
        clicked => { root.toggled(); }
    }
}

// A thin progress line.
export component ProgressLine inherits Rectangle {
    in property <float> progress;
    in property <color> fill: Theme.purple;
    height: 3px;
    border-radius: self.height / 2;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * Math.clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
    }
}

// A title in the display cut with its line of fact: on the title's baseline when both fit
// on one line, as on the desktop, and under it when they do not.
component DisplayHead inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <length> size;
    property <length> note-size: Theme.small + 1px;
    property <length> beside-gap: 3 * Theme.unit;
    property <bool> beside: root.note != "" && head.preferred-width + root.beside-gap + side.preferred-width <= root.width;
    height: root.note == "" || root.beside ? head.preferred-height : head.preferred-height + Theme.unit + below.preferred-height;
    // A title longer than the page, a long search say, wraps instead of running off it.
    head := Text {
        x: 0;
        y: 0;
        width: Math.min(self.preferred-width, root.width);
        height: self.preferred-height;
        wrap: word-wrap;
        text: root.title;
        color: Theme.text;
        font-size: root.size;
        font-family: Theme.display-face;
        letter-spacing: -0.3px;
    }
    // The note sits on the baseline: the display cut's descent is about a fifth of its size.
    side := Text {
        visible: root.beside;
        x: head.preferred-width + root.beside-gap;
        y: head.preferred-height - root.size * 0.24 - self.preferred-height * 0.8;
        width: self.preferred-width;
        height: self.preferred-height;
        text: root.note;
        color: Theme.dim;
        font-size: root.note-size;
    }
    below := Text {
        visible: root.note != "" && !root.beside;
        x: 0;
        y: head.preferred-height + Theme.unit;
        width: root.width;
        height: self.preferred-height;
        text: root.note;
        color: Theme.dim;
        font-size: root.note-size;
        wrap: word-wrap;
    }
}

// A page's head: an optional pill back to where it came from, then the title in the page
// size with its line of fact.
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> note;
    in property <string> back;
    callback go-back();
    spacing: 3 * Theme.unit;
    if root.back != "": HorizontalLayout {
        alignment: start;
        BackPill {
            text: root.back;
            clicked => { root.go-back(); }
        }
    }
    if root.title != "": DisplayHead {
        title: root.title;
        note: root.note;
        size: Theme.page;
    }
}

// A section of a page: the heading in the display cut with its line of fact beside it.
export component SectionHead inherits VerticalLayout {
    in property <string> title;
    in property <string> note;
    padding-top: 3 * Theme.unit;
    DisplayHead {
        title: root.title;
        note: root.note;
        size: Theme.section;
    }
}

// A smaller heading inside a section: the title cut, a faint count after it.
export component ShelfHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    in property <color> dot: transparent;
    spacing: Theme.unit * 2;
    alignment: start;
    if root.dot != transparent: Rectangle {
        y: (parent.height - self.height) / 2;
        width: 2.5 * Theme.unit;
        height: self.width;
        border-radius: self.width / 2;
        background: root.dot;
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.heading;
        font-family: Theme.title-face;
        vertical-alignment: center;
    }
    if root.count != "": Text {
        text: root.count;
        color: Theme.faint;
        font-size: Theme.small;
        font-family: Theme.figure;
        vertical-alignment: center;
    }
}

// A figure on the ground: a number in B612 over its faint caption, the desktop's "0 B/s
// down".
export component Figure inherits VerticalLayout {
    in property <string> value;
    in property <string> caption;
    in property <color> ink: Theme.text;
    spacing: Theme.unit / 2;
    Text {
        text: root.value;
        color: root.ink;
        font-size: Theme.large + 2px;
        font-family: Theme.figure;
    }
    Text {
        text: root.caption;
        color: Theme.faint;
        font-size: Theme.small;
        wrap: word-wrap;
    }
}

// One line of a fact list: a faint label in a fixed column and its value, the desktop's
// "Release / From / Saving to".
export component Fact inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <length> label-width: 20 * Theme.unit;
    in property <bool> figure;
    spacing: 2 * Theme.unit;
    Text {
        width: root.label-width;
        text: root.label;
        color: Theme.faint;
        font-size: Theme.small;
        vertical-alignment: top;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.text;
        font-size: root.figure ? Theme.small : Theme.small + 1px;
        font-family: root.figure ? Theme.figure : Theme.face;
        wrap: word-wrap;
    }
}

// One row of a settings pane: a label, a dim helper line, and at the right a switch when
// `switch` is set, a value when `value` is, or a chevron when it opens something.
export component ListRow inherits Rectangle {
    in property <string> label;
    in property <string> helper;
    in property <string> value;
    in property <bool> last;
    in property <bool> tappable;
    in property <bool> chevron;
    in property <bool> switch;
    in property <bool> on;
    in property <color> helper-ink: Theme.dim;
    callback clicked();
    callback toggled();
    property <length> trailing: root.switch ? 15 * Theme.unit : root.chevron ? 9 * Theme.unit : root.value != "" ? value-text.preferred-width + 4 * Theme.unit : 0;
    height: Math.max(15 * Theme.unit, texts.preferred-height + 7 * Theme.unit);
    background: touch.pressed && (root.tappable || root.switch) ? Theme.raised : transparent;
    texts := VerticalLayout {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad - root.trailing;
        alignment: center;
        spacing: Theme.unit;
        Text {
            text: root.label;
            color: Theme.text;
            font-family: Theme.strong-face;
            wrap: word-wrap;
        }
        if root.helper != "": Text {
            text: root.helper;
            color: root.helper-ink;
            font-size: Theme.small;
            wrap: word-wrap;
        }
    }
    // A switch row flips from anywhere on it, its words included.
    touch := TouchArea {
        enabled: root.tappable || root.switch;
        clicked => {
            if (root.switch) {
                root.toggled();
            } else {
                root.clicked();
            }
        }
    }
    if root.switch: Switch {
        x: parent.width - Theme.pad - self.width;
        y: (parent.height - self.height) / 2;
        on: root.on;
        toggled => { root.toggled(); }
    }
    value-text := Text {
        visible: root.value != "" && !root.switch;
        x: parent.width - Theme.pad - self.width - (root.chevron ? 6 * Theme.unit : 0);
        height: parent.height;
        text: root.value;
        color: Theme.dim;
        font-size: Theme.small;
        font-family: Theme.figure;
        vertical-alignment: center;
    }
    if root.chevron: Image {
        x: parent.width - Theme.pad - self.width;
        y: (parent.height - self.height) / 2;
        width: 5 * Theme.unit;
        height: self.width;
        source: @image-url("icons/chevron-right.svg");
        colorize: Theme.faint;
    }
    if !root.last: Rectangle {
        x: Theme.pad;
        y: parent.height - 1px;
        width: parent.width - 2 * Theme.pad;
        height: 1px;
        background: Theme.line;
    }
}

// A pane of glass: the resting fill, a hairline edge, the tile's corner.
export component Pane inherits Rectangle {
    in property <bool> lit;
    background: root.lit ? Theme.raised : Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.lit ? Theme.line-strong : Theme.line;
}

// A group of ListRows in one pane.
export component ListGroup inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    height: rows.preferred-height;
    rows := VerticalLayout {
        @children
    }
}

// A segmented switch, the desktop's Seg: cells in a glass pill, the picked one carried by a
// thumb of soft accent with an accent edge.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> picked;
    callback pick(int);
    height: 10 * Theme.unit;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    property <length> cell: (self.width - 2 * 3px) / Math.max(1, self.options.length);
    thumb := Rectangle {
        x: 3px + root.picked * root.cell;
        y: 3px;
        width: root.cell;
        height: parent.height - 6px;
        border-radius: self.height / 2;
        background: Theme.accent-soft;
        border-width: 1px;
        border-color: Theme.accent-edge;
        animate x { duration: 180ms; easing: ease-out; }
    }
    for option[i] in root.options: Rectangle {
        x: 3px + i * root.cell;
        y: 3px;
        width: root.cell;
        height: parent.height - 6px;
        Text {
            width: parent.width - 2 * Theme.unit;
            text: option;
            color: i == root.picked ? Theme.accent : Theme.dim;
            font-size: Theme.small + 0.5px;
            font-family: i == root.picked ? Theme.strong-face : Theme.face;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea { clicked => { root.pick(i); } }
    }
}

// The page's search: one wide field of glass, the desktop's, with its glyph and a large
// placeholder.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in property <string> hint;
    in-out property <string> text;
    callback edited(string);
    callback accepted(string);
    height: 14 * Theme.unit;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.line-strong : Theme.line;
    Image {
        x: Theme.unit * 4.5;
        width: 5 * Theme.unit;
        height: self.width;
        source: @image-url("icons/search.svg");
        colorize: Theme.dim;
    }
    property <length> text-x: Theme.unit * 12.5;
    if root.text == "": Text {
        x: root.text-x;
        width: parent.width - self.x - Theme.pad;
        height: parent.height;
        text: root.placeholder;
        color: Theme.faint;
        font-size: Theme.heading;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> clear-size: 12 * Theme.unit;
    input := TextInput {
        x: root.text-x;
        width: parent.width - self.x - (root.text != "" ? root.clear-size : Theme.pad);
        height: parent.height;
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.heading;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
    // Clears the search in one tap.
    if root.text != "": Rectangle {
        x: parent.width - self.width - Theme.unit;
        y: (parent.height - self.height) / 2;
        width: root.clear-size;
        height: self.width;
        border-radius: self.width / 2;
        background: clear.pressed ? Theme.pressed : transparent;
        Image {
            width: 4.5 * Theme.unit;
            height: self.width;
            source: @image-url("icons/x.svg");
            colorize: Theme.dim;
        }
        clear := TouchArea {
            clicked => {
                root.text = "";
                root.edited("");
            }
        }
    }
}

// A plain one-line field of glass.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> figure;
    // Typed as dots: a token, a password.
    in property <bool> secret;
    callback accepted(string);
    callback edited(string);
    height: 12 * Theme.unit;
    border-radius: Theme.radius-row + 4px;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.line-strong : Theme.line;
    if root.text == "": Text {
        x: Theme.unit * 4;
        width: parent.width - 8 * Theme.unit;
        height: parent.height;
        text: root.placeholder;
        color: Theme.faint;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: Theme.unit * 4;
        width: parent.width - 8 * Theme.unit;
        height: parent.height;
        text <=> root.text;
        color: Theme.text;
        font-family: root.figure ? Theme.figure : Theme.face;
        vertical-alignment: center;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

// One destination in the bottom bar (portrait) or the side rail (landscape), the desktop's
// rail: the glyph over its label, the current one in a disc of raised glass.
export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    Rectangle {
        width: 11 * Theme.unit;
        height: self.width;
        y: (parent.height - self.height - 5 * Theme.unit) / 2;
        border-radius: self.width / 2;
        background: root.active ? Theme.raised : transparent;
        border-width: root.active ? 1px : 0;
        border-color: Theme.line-strong;
        animate background { duration: 120ms; }
        Image {
            width: 5.5 * Theme.unit;
            height: self.width;
            source: root.icon;
            colorize: root.active ? Theme.accent : Theme.dim;
        }
    }
    Text {
        y: (parent.height + 7 * Theme.unit) / 2;
        width: parent.width;
        text: root.label;
        color: root.active ? Theme.accent : Theme.dim;
        font-size: Theme.small;
        font-family: root.active ? Theme.strong-face : Theme.face;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A poster tile, the desktop's ShowCard: the poster full-bleed in a rounded pane, the title
// and one ledger line on the scrim at its foot, the cubes under them, and tags of dark glass
// on the top corners.
export component PosterTile inherits Rectangle {
    in property <Tile> data;
    callback open(int);
    // Held down: the series and its title, for a menu.
    callback held(int, string);
    border-radius: Theme.radius;
    clip: true;
    background: Theme.surface;
    border-width: root.data.has-poster ? 0 : 1px;
    border-color: Theme.line;

    if root.data.has-poster: Image {
        width: parent.width;
        height: parent.height;
        source: root.data.poster;
        image-fit: cover;
    }
    if !root.data.has-poster: Text {
        y: parent.height * 0.3;
        width: parent.width;
        text: root.data.initials;
        color: Theme.faint;
        font-size: Theme.large;
        font-family: Theme.title-face;
        horizontal-alignment: center;
    }
    Rectangle {
        y: parent.height * 0.45;
        width: parent.width;
        height: parent.height * 0.55;
        background: @linear-gradient(180deg, Theme.scrim-clear 0%, Theme.scrim-mid 45%, Theme.scrim 100%);
    }
    if root.data.badge != "": GlassTag {
        x: Theme.unit * 2;
        y: Theme.unit * 2;
        text: root.data.badge;
        dot: root.data.ledger-tone == 1 ? Theme.accent : transparent;
    }
    if root.data.flag != "": GlassTag {
        x: parent.width - self.width - Theme.unit * 2;
        y: Theme.unit * 2;
        text: root.data.flag;
        dot: Theme.purple;
    }
    foot := VerticalLayout {
        x: 0;
        y: parent.height - self.preferred-height;
        width: parent.width;
        padding: Theme.unit * 2.5;
        spacing: Theme.unit;
        ClampedText {
            text: root.data.title;
            font-size: Theme.small + 1.5px;
            face: Theme.title-face;
            ink: Theme.on-poster;
            leading: 1.1;
        }
        if root.data.ledger != "": Text {
            text: root.data.ledger;
            color: root.data.ledger-tone == 1 ? Theme.accent : root.data.ledger-tone == 2 ? Theme.warn : root.data.ledger-tone == 3 ? Theme.ok : Theme.on-poster-dim;
            font-size: Theme.small - 1.5px;
            font-family: Theme.ledger-face;
            overflow: elide;
        }
        if root.data.cubes.length > 0: Cubes {
            codes: root.data.cubes;
            size: 5px;
            spacing: 2px;
        }
    }
    property <bool> was-held;
    hold := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.was-held = true;
            root.held(root.data.id, root.data.title);
        }
    }
    touch := TouchArea {
        enabled: root.data.id >= 0;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.was-held = false;
                hold.running = true;
            } else if (e.kind != PointerEventKind.move) {
                hold.running = false;
            }
        }
        // A finger that moves is a scroll, not a hold.
        moved => {
            if (Math.abs(self.mouse-x - self.pressed-x) > 3 * Theme.unit || Math.abs(self.mouse-y - self.pressed-y) > 3 * Theme.unit) {
                hold.running = false;
            }
        }
        clicked => {
            if (!root.was-held) {
                root.open(root.data.id);
            }
        }
    }
}

// Tiles in as many columns as the width holds: three on a phone held upright, seven or
// more sideways.
export component TileGrid inherits Rectangle {
    in property <[Tile]> tiles;
    in property <length> tile-min: Theme.tile-min;
    callback open(int);
    callback held(int, string);
    property <int> columns: Math.max(1, Math.floor((self.width + Theme.gap) / (self.tile-min + Theme.gap)));
    property <length> tile-width: (self.width - (self.columns - 1) * Theme.gap) / self.columns;
    property <length> tile-height: self.tile-width * Theme.poster-ratio;
    height: Math.max(0, Math.ceil(self.tiles.length / self.columns) * (self.tile-height + Theme.gap) - Theme.gap);

    for tile[i] in root.tiles: PosterTile {
        x: Math.mod(i, root.columns) * (root.tile-width + Theme.gap);
        y: Math.floor(i / root.columns) * (root.tile-height + Theme.gap);
        width: root.tile-width;
        height: root.tile-height;
        data: tile;
        open(id) => { root.open(id); }
        held(id, title) => { root.held(id, title); }
    }
}

// One row of tiles that scrolls sideways, for Home's shelves.
export component TileRow inherits Rectangle {
    in property <[Tile]> tiles;
    in property <length> tile-width: 116px;
    callback open(int);
    callback held(int, string);
    height: self.tile-width * Theme.poster-ratio;
    Flickable {
        content-width: Math.max(self.width, root.tiles.length * (root.tile-width + Theme.gap) - Theme.gap);
        for tile[i] in root.tiles: PosterTile {
            x: i * (root.tile-width + Theme.gap);
            width: root.tile-width;
            height: root.height;
            data: tile;
            open(id) => { root.open(id); }
            held(id, title) => { root.held(id, title); }
        }
    }
}

// What an empty place says, the desktop's "Pick a provider" pane: a heading in the display
// cut and a dim line saying what to do.
export component EmptyNote inherits Rectangle {
    in property <string> title;
    in property <string> body;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    height: column.preferred-height;
    column := VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.unit * 2;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.section - 3px;
            font-family: Theme.display-face;
            wrap: word-wrap;
        }
        if root.body != "": Text {
            text: root.body;
            color: Theme.dim;
            font-size: Theme.small + 1px;
            wrap: word-wrap;
        }
        @children
    }
}

// A slider for an amount between `minimum` and `maximum`, the desktop's: a thin track, the
// filled part in the accent, and a round thumb. Drag or tap anywhere on it.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    callback moved(float);
    height: 11 * Theme.unit;
    property <length> thumb: 6 * Theme.unit;
    property <length> track-width: self.width - self.thumb;
    property <float> share: self.maximum > self.minimum ? Math.clamp((self.value - self.minimum) / (self.maximum - self.minimum), 0, 1) : 0;
    Rectangle {
        x: root.thumb / 2;
        width: root.track-width;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
    }
    Rectangle {
        x: root.thumb / 2;
        width: root.track-width * root.share;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: root.track-width * root.share;
        width: root.thumb;
        height: root.thumb;
        border-radius: root.thumb / 2;
        background: Theme.accent;
        border-width: touch.pressed ? 3px : 0;
        border-color: Theme.accent-soft;
    }
    function at(px: length) {
        root.moved(root.minimum + Math.clamp((px - root.thumb / 2) / root.track-width, 0, 1) * (root.maximum - root.minimum));
    }
    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.at(self.mouse-x);
            }
        }
        moved => { root.at(self.mouse-x); }
    }
}
