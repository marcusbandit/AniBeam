import { Theme } from "theme.slint";
import { Tile } from "data.slint";

// A poster with round corners, or the title's initials on a plain tile when the host
// has no poster for it.
export component Poster inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <string> initials;
    border-radius: Theme.radius;
    clip: true;
    background: Theme.raised;
    if root.has-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    if !root.has-image: Text {
        text: root.initials;
        color: Theme.faint;
        font-size: Theme.large;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Text that wraps onto at most `lines` lines and ends in an ellipsis past that. A Text in
// a layout grows to its wrapped height whatever max-height says, so this one fixes its
// own height and clips.
export component ClampedText inherits Rectangle {
    in property <string> text;
    in property <int> lines: 2;
    in property <length> font-size: Theme.normal;
    in property <int> font-weight: 400;
    in property <color> ink: Theme.text;
    // Roboto's ascent plus descent is 1.17 em; 1.25 leaves room without fitting a third line.
    height: Math.min(inner.preferred-height, root.font-size * 1.25 * root.lines);
    clip: true;
    inner := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }
}

// A small label: what a row is (subscribed, not on disk), never a button.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.dim;
    in property <bool> mono;
    height: 6 * Theme.unit;
    min-width: label.preferred-width + 5 * Theme.unit;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.line-strong;
    label := Text {
        text: root.text;
        color: root.ink;
        font-size: Theme.small;
        font-family: root.mono ? Theme.mono : "";
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// A status dot: green for a host that answered, orange for one that did not.
export component Dot inherits Rectangle {
    in property <color> tone;
    width: 2 * Theme.unit;
    height: self.width;
    border-radius: self.width / 2;
    background: root.tone;
}

// A button with a label, filled when it is the main action of its section.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 12 * Theme.unit;
    min-width: label.preferred-width + 10 * Theme.unit;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.surface
        : root.primary ? (touch.pressed ? Theme.dim : Theme.accent)
        : (touch.pressed ? Theme.pressed : Theme.raised);
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.line-strong;
    animate background { duration: 120ms; }
    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.faint : root.primary ? Theme.on-accent : Theme.text;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A round icon-only button, for the header's refresh.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> spinning;
    callback clicked();
    width: 12 * Theme.unit;
    height: self.width;
    border-radius: self.width / 2;
    background: touch.pressed ? Theme.pressed : Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    animate background { duration: 120ms; }
    Image {
        width: 5 * Theme.unit;
        height: self.width;
        source: root.icon;
        colorize: root.spinning ? Theme.text : Theme.dim;
        // One turn a second while a sync runs.
        transform-rotation: root.spinning ? (animation-tick() / 1000ms) * 360deg : 0deg;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A thin progress line for torrents.
export component ProgressLine inherits Rectangle {
    in property <float> progress;
    in property <color> fill: Theme.accent;
    height: Theme.unit;
    border-radius: self.height / 2;
    background: Theme.line-strong;
    Rectangle {
        x: 0;
        width: parent.width * Math.clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
    }
}

// A small upper-case section label.
export component SectionLabel inherits Text {
    color: Theme.faint;
    font-size: Theme.small;
    font-weight: 700;
    letter-spacing: 1.2px;
}

// One destination in the bottom bar (portrait) or the side rail (landscape).
export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    Rectangle {
        width: 16 * Theme.unit;
        height: 8 * Theme.unit;
        y: (parent.height - self.height - 5 * Theme.unit) / 2;
        border-radius: self.height / 2;
        background: root.active ? Theme.pressed : transparent;
        animate background { duration: 120ms; }
        Image {
            width: 6 * Theme.unit;
            height: self.width;
            source: root.icon;
            colorize: root.active ? Theme.accent : Theme.dim;
        }
    }
    Text {
        y: (parent.height + 3 * Theme.unit) / 2;
        width: parent.width;
        text: root.label;
        color: root.active ? Theme.accent : Theme.dim;
        font-size: Theme.small;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A poster tile, as on the desktop: the title sits on the poster over a fade from the
// foot, an episode code or air time rides the top-left corner, and a thin strip along the
// bottom says how much is watched.
export component PosterTile inherits Rectangle {
    in property <Tile> data;
    callback open(int);
    border-radius: Theme.radius;
    clip: true;
    background: Theme.raised;

    if root.data.has-poster: Image {
        width: parent.width;
        height: parent.height;
        source: root.data.poster;
        image-fit: cover;
    }
    if !root.data.has-poster: Text {
        y: parent.height * 0.3;
        width: parent.width;
        text: root.data.initials;
        color: Theme.faint;
        font-size: Theme.large;
        font-weight: 700;
        horizontal-alignment: center;
    }
    Rectangle {
        y: parent.height * 0.4;
        width: parent.width;
        height: parent.height * 0.6;
        background: @linear-gradient(180deg, Theme.scrim-clear 0%, Theme.scrim-mid 45%, Theme.scrim 100%);
    }
    if root.data.badge != "": Rectangle {
        x: Theme.unit * 1.5;
        y: Theme.unit * 1.5;
        width: badge.preferred-width + Theme.unit * 3;
        height: Theme.unit * 5.5;
        border-radius: Theme.radius-small;
        background: Theme.chip;
        border-width: 1px;
        border-color: Theme.line-strong;
        badge := Text {
            text: root.data.badge;
            color: Theme.text;
            font-size: Theme.small;
            font-family: Theme.mono;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    foot := VerticalLayout {
        x: 0;
        y: parent.height - self.preferred-height - (root.data.progress >= 0 ? Theme.unit : 0);
        width: parent.width;
        padding: Theme.unit * 2;
        spacing: Theme.unit / 2;
        ClampedText {
            text: root.data.title;
            font-size: Theme.small;
            font-weight: 700;
        }
        if root.data.ledger != "": Text {
            text: root.data.ledger;
            color: root.data.ledger-tone == 1 ? Theme.accent : root.data.ledger-tone == 2 ? Theme.warn : root.data.ledger-tone == 3 ? Theme.ok : Theme.dim;
            font-size: Theme.small;
            font-family: Theme.mono;
            font-weight: root.data.ledger-tone == 1 ? 700 : 400;
            overflow: elide;
        }
    }
    if root.data.progress >= 0: Rectangle {
        y: parent.height - Theme.unit;
        width: parent.width;
        height: Theme.unit;
        background: Theme.track;
        Rectangle {
            x: 0;
            width: parent.width * Math.clamp(root.data.progress, 0, 1);
            height: parent.height;
            background: Theme.accent;
        }
    }
    TouchArea {
        enabled: root.data.id >= 0;
        clicked => { root.open(root.data.id); }
    }
}

// Tiles in as many columns as the width holds: three on a phone held upright, seven or
// more sideways.
export component TileGrid inherits Rectangle {
    in property <[Tile]> tiles;
    in property <length> tile-min: Theme.tile-min;
    callback open(int);
    property <int> columns: Math.max(1, Math.floor((self.width + Theme.gap) / (self.tile-min + Theme.gap)));
    property <length> tile-width: (self.width - (self.columns - 1) * Theme.gap) / self.columns;
    property <length> tile-height: self.tile-width * Theme.poster-ratio;
    height: Math.max(0, Math.ceil(self.tiles.length / self.columns) * (self.tile-height + Theme.gap) - Theme.gap);

    for tile[i] in root.tiles: PosterTile {
        x: Math.mod(i, root.columns) * (root.tile-width + Theme.gap);
        y: Math.floor(i / root.columns) * (root.tile-height + Theme.gap);
        width: root.tile-width;
        height: root.tile-height;
        data: tile;
        open(id) => { root.open(id); }
    }
}

// A shelf's heading: its name, and a faint count beside it.
export component ShelfHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    // 0: plain, 1: accent, 2: warning.
    in property <int> tone;
    spacing: Theme.unit * 2;
    alignment: start;
    Text {
        text: root.title;
        color: root.tone == 1 ? Theme.accent : root.tone == 2 ? Theme.warn : Theme.text;
        font-weight: 700;
    }
    Text {
        text: root.count;
        color: Theme.faint;
        font-family: Theme.mono;
    }
}
