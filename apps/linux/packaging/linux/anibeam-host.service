# AniBeam's host service: the library, downloads and the tailnet API for your other
# devices, with no window. The desktop app takes the library over while it is open and
# hands it back when it closes.
#
#   systemctl --user enable --now anibeam-host
#
# A build outside /usr/bin points ExecStart at its own binary with a drop-in:
#   systemctl --user edit anibeam-host
#   [Service]
#   ExecStart=
#   ExecStart=/path/to/anibeam serve

[Unit]
Description=AniBeam host service for other devices

[Service]
Type=simple
ExecStart=/usr/bin/anibeam serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
