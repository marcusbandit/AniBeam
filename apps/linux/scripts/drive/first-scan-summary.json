[
  {"log": "Run against an empty ANIBEAM_ROOT with the network up. Pass the folder to add as --props '{\"folder\":\"...\"}': show folders with dummy .mkv files, two of them named so no provider knows them."},
  {"until": "frame.item.knownSources !== null", "timeout": 10000},
  {"eval": "var r = Door.addSource(JSON.parse(Shell.props).folder); r.error ? JSON.stringify(r.error) : 'ok'", "expect": "ok"},
  {"until": "frame.item.scanSummaryPanel.visible", "timeout": 300000},
  {"wait": 600},
  {"eval": "var s = frame.item.scanSummaryPanel.summary; JSON.stringify([s.shows, s.recognised, s.need_you.length, s.episodes])"},
  {"eval": "frame.item.scanSummaryPanel.summary.need_you.length > 0", "expect": true},
  {"shot": "scan-1-summary"},
  {"click": "scan-summary-go"},
  {"until": "frame.item.nav.current.page === 'metadata' && driver.item.findItem('match-panel') !== null && driver.item.findItem('match-panel').visible", "timeout": 10000},
  {"eval": "driver.item.findItem('match-panel').walkLine", "expect": "1 of 2"},
  {"wait": 1500},
  {"shot": "scan-2-walk-first"},
  {"click": "match-skip"},
  {"until": "driver.item.findItem('match-panel').walkLine === '2 of 2'", "timeout": 5000},
  {"wait": 1500},
  {"shot": "scan-3-walk-second"},
  {"click": "match-skip"},
  {"until": "driver.item.findItem('match-panel') === null || !driver.item.findItem('match-panel').visible", "timeout": 5000},
  {"eval": "frame.item.pageItem.walkAt", "expect": -1},
  {"wait": 300},
  {"shot": "scan-4-walk-done"}
]
