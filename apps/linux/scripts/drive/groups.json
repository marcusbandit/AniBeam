[
  {"eval": "frame.item.nav.current.page", "expect": "library"},
  {"until": "driver.item.findItem('library-page') !== null && driver.item.findItem('library-page').boxes().length > 0"},
  {"eval": "driver.item.findItem('library-page').groupFranchises", "expect": true},
  {"eval": "driver.item.findItem('library-page').boxes().map(function(b){return b.title+':'+b.ids.length}).join(' | ')", "as": "on"},
  {"shot": "lib-groups-on"},
  {"click": "group-franchises"},
  {"until": "driver.item.findItem('library-page').groupFranchises === false"},
  {"eval": "driver.item.findItem('library-page').groupFranchises", "expect": false},
  {"eval": "Door.preferences.library_group_franchises", "expect": false},
  {"eval": "driver.item.findItem('library-page').boxes().map(function(b){return b.title+':'+b.ids.length}).join(' | ')", "as": "off"},
  {"shot": "lib-groups-off"},
  {"click": "group-franchises"},
  {"until": "driver.item.findItem('library-page').groupFranchises === true"},
  {"eval": "driver.item.findItem('library-page').groupFranchises", "expect": true},
  {"click": "arrange-menu"},
  {"click": "arrange-menu-option-1"},
  {"until": "Door.preferences.library_arrange === 'Type'"},
  {"eval": "Door.preferences.library_arrange", "expect": "Type"},
  {"eval": "driver.item.findItem('library-page').boxes().map(function(b){return b.title+':'+b.ids.length}).join(' | ')", "as": "type"},
  {"click": "arrange-menu"},
  {"click": "arrange-menu-option-0"},
  {"until": "Door.preferences.library_arrange === 'Season'"},
  {"eval": "Door.preferences.library_arrange", "expect": "Season"}
]
