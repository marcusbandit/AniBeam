[
  {"log": "home: Down from the page lands on the hero's Resume button, the top of the key order"},
  {"eval": "frame.item.nav.current.page", "expect": "home"},
  {"eval": "window.activeFocusItem.objectName", "expect": "home-page"},
  {"eval": "driver.item.findItem('home-page').continueList.length >= 3", "expect": true},
  {"eval": "driver.item.findItem('home-page').week.some(function(d) { return d.cards.length > 0 })", "expect": true},
  {"key": "Down"},
  {"eval": "window.activeFocusItem.objectName", "expect": "home-resume"},

  {"log": "Down again: the Continue card whose centre is nearest the button's x; Right: the next one in the row"},
  {"eval": "driver.item.findItem('home-page').continueList.slice(1).map(function(e) { return 'card-' + e.card.id })", "as": "row"},
  {"eval": "(function() { var r = driver.item.findItem('home-resume'); var rx = r.mapToItem(null, r.width / 2, 0).x; var best = null, bd = 1e9; vars.row.forEach(function(n) { var c = driver.item.findItem(n); if (!c) return; var d = Math.abs(c.mapToItem(null, c.width / 2, 0).x - rx); if (d < bd) { bd = d; best = n } }); return best })()", "as": "first"},
  {"key": "Down"},
  {"eval": "window.activeFocusItem.objectName === vars.first", "expect": true},
  {"eval": "vars.row.indexOf(vars.first)", "as": "at"},
  {"eval": "vars.at + 1 < vars.row.length", "expect": true},
  {"key": "Right"},
  {"eval": "window.activeFocusItem.objectName === vars.row[vars.at + 1]", "expect": true},
  {"wait": 500},
  {"shot": "keys-01-home-focus"},

  {"log": "Down crosses from the Continue row into the week's first row"},
  {"key": "Down"},
  {"eval": "/^(week-|home-week-next)/.test(window.activeFocusItem.objectName)", "expect": true},
  {"eval": "window.activeFocusItem.objectName", "as": "week"},
  {"log": "Up comes back to the Continue row at the nearest x, Left one card back along it"},
  {"key": "Up"},
  {"eval": "vars.row.indexOf(window.activeFocusItem.objectName) >= 0", "expect": true},
  {"eval": "vars.row.indexOf(window.activeFocusItem.objectName)", "as": "back"},
  {"key": "Left"},
  {"eval": "vars.row.indexOf(window.activeFocusItem.objectName) === Math.max(0, vars.back - 1)", "expect": true},

  {"log": "Escape drops the focus from the card without leaving the page; Down picks it up again"},
  {"key": "Escape"},
  {"eval": "window.activeFocusItem.gridStop === true", "expect": false},
  {"eval": "frame.item.nav.current.page", "expect": "home"},
  {"key": "Down"},
  {"eval": "window.activeFocusItem.objectName", "expect": "home-resume"},
  {"key": "Down"},
  {"eval": "window.activeFocusItem.objectName === vars.first", "expect": true},

  {"log": "Return opens the focused series; Back returns home"},
  {"eval": "window.activeFocusItem.item.id", "as": "openedId"},
  {"key": "Return"},
  {"until": "driver.item.pageReady('series')"},
  {"eval": "frame.item.nav.current.page", "expect": "series"},
  {"eval": "frame.item.nav.current.props.id === vars.openedId", "expect": true},
  {"eval": "frame.item.nav.back()"},
  {"until": "driver.item.pageReady('home') && driver.item.findItem('home-resume') !== null"},
  {"eval": "frame.item.nav.current.page", "expect": "home"},

  {"log": "Space on a focused card plays its next episode"},
  {"key": "Down"},
  {"key": "Down"},
  {"eval": "window.activeFocusItem.objectName === vars.first", "expect": true},
  {"key": "Space"},
  {"until": "driver.item.pageReady('player')"},
  {"eval": "frame.item.nav.current.page", "expect": "player"},
  {"eval": "frame.item.nav.back()"},
  {"until": "driver.item.pageReady('home') && driver.item.findItem('home-resume') !== null"},
  {"eval": "frame.item.nav.current.page", "expect": "home"},

  {"log": "library: Down from the page lands on the first card of the first section"},
  {"page": "library"},
  {"until": "driver.item.findItem('library-page') !== null && driver.item.findItem('library-page').sections.length >= 2"},
  {"eval": "frame.item.nav.current.page", "expect": "library"},
  {"eval": "driver.item.findItem('library-page').sections.length >= 2", "expect": true},
  {"eval": "driver.item.findItem('library-page').sections[0].ids.length >= 2", "expect": true},
  {"eval": "driver.item.findItem('library-page').sections[1].ids.length >= 2", "expect": true},
  {"key": "Down"},
  {"eval": "window.activeFocusItem.objectName === 'tile-' + driver.item.findItem('library-page').sections[0].ids[0]", "expect": true},
  {"key": "Right"},
  {"eval": "window.activeFocusItem.objectName === 'tile-' + driver.item.findItem('library-page').sections[0].ids[1]", "expect": true},
  {"eval": "driver.item.findItem('library-page').boxOf(window.activeFocusItem.item.id)", "as": "box0"},

  {"log": "Down from the first section's last row crosses into the next section at the same column"},
  {"log": "(the first section is one row here, so column 1 of it sits over column 1 of the next)"},
  {"eval": "(function() { var p = driver.item.findItem('library-page'); return Math.ceil(p.sections[0].ids.length / p.cols) })()", "expect": 1},
  {"eval": "'tile-' + driver.item.findItem('library-page').sections[1].ids[1]", "as": "across"},
  {"key": "Down"},
  {"eval": "window.activeFocusItem.objectName === vars.across", "expect": true},
  {"eval": "driver.item.findItem('library-page').boxOf(window.activeFocusItem.item.id) !== vars.box0", "expect": true},
  {"wait": 500},
  {"shot": "keys-02-library-focus"},
  {"log": "Up crosses back"},
  {"key": "Up"},
  {"eval": "driver.item.findItem('library-page').boxOf(window.activeFocusItem.item.id) === vars.box0", "expect": true},
  {"key": "Left"},
  {"eval": "window.activeFocusItem.objectName === 'tile-' + driver.item.findItem('library-page').sections[0].ids[0]", "expect": true},

  {"log": "the slash still reaches the search from a focused card"},
  {"key": "/"},
  {"wait": 200},
  {"eval": "String(window.activeFocusItem).indexOf('QQuickTextInput')", "expect": 0}
]
