[
  {"log": "Run against an empty ANIBEAM_ROOT. Pass two folders as --props '{\"empty\":\"...\",\"shows\":\"...\"}': one with nothing in it, one with show folders of dummy .mkv files."},
  {"page": "home"},
  {"until": "driver.item.findItem('home-empty') !== null", "timeout": 10000},
  {"eval": "driver.item.findItem('home-empty').mode", "expect": "none"},
  {"log": "No rows of shows that have nothing to do with the library (#1006)"},
  {"eval": "driver.item.findItem('home-fresh-install') === null && driver.item.findItem('home-out-now') === null", "expect": true},
  {"wait": 500},
  {"shot": "empty-1-home-no-folder"},
  {"page": "library"},
  {"until": "driver.item.findItem('library-empty') !== null", "timeout": 10000},
  {"eval": "driver.item.findItem('library-empty').mode", "expect": "none"},
  {"wait": 500},
  {"shot": "empty-2-library-no-folder"},
  {"eval": "var r = Door.addSource(JSON.parse(Shell.props).empty); r.error ? JSON.stringify(r.error) : 'ok'", "expect": "ok"},
  {"until": "driver.item.findItem('library-empty').mode === 'nothing' && driver.item.findItem('library-empty').sources.length === 1", "timeout": 30000},
  {"wait": 800},
  {"shot": "empty-3-library-empty-folder"},
  {"page": "home"},
  {"until": "driver.item.findItem('home-empty') !== null && driver.item.findItem('home-empty').mode === 'nothing'", "timeout": 10000},
  {"wait": 800},
  {"shot": "empty-4-home-empty-folder"},
  {"eval": "var r = Door.addSource(JSON.parse(Shell.props).shows); r.error ? JSON.stringify(r.error) : 'ok'", "expect": "ok"},
  {"until": "!frame.item.pageItem.libraryEmpty", "timeout": 120000},
  {"eval": "driver.item.findItem('home-empty') === null", "expect": true},
  {"wait": 3000},
  {"shot": "empty-5-home-filled"},
  {"page": "library"},
  {"until": "!frame.item.pageItem.libraryEmpty && frame.item.pageItem.tileCount() > 0", "timeout": 30000},
  {"eval": "driver.item.findItem('library-empty') === null", "expect": true},
  {"wait": 1500},
  {"shot": "empty-6-library-filled"}
]
