[
  {"log": "metadata filtered to one complete series: it is one tile under Complete, the page's first"},
  {"page": "metadata", "props": {"q": "Dandadan"}},
  {"wait": 900},
  {"eval": "frame.item.nav.current.page", "expect": "metadata"},
  {"eval": "driver.item.findItem('metadata-page').sections.length", "expect": 1},
  {"eval": "driver.item.findItem('metadata-page').sections[0].key", "expect": "complete"},
  {"eval": "driver.item.findItem('row-match') !== null", "expect": true},
  {"eval": "driver.item.findItem('row-refresh') !== null", "expect": true},
  {"shot": "meta-grid-drive-01-rest"},
  {"log": "a click on the tile (row-match falls through to its MouseArea) opens the match panel; Escape closes it"},
  {"click": "row-match"},
  {"wait": 500},
  {"eval": "driver.item.findItem('match-panel') !== null", "expect": true},
  {"key": "Escape"},
  {"wait": 300},
  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},
  {"log": "the Refresh glyph on the tile's foot is its own button, not the tile's click"},
  {"click": "row-refresh"},
  {"wait": 400},
  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},
  {"log": "the tile keeps its meta-row-<id> name"},
  {"eval": "driver.item.findItem('metadata-page').rows[0].series.id", "as": "id"},
  {"eval": "driver.item.findItem('meta-row-' + vars.id) !== null", "expect": true}
]
