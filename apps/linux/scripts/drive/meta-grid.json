[
  {"log": "metadata filtered to one complete series: it is one tile under Complete, the page's first"},
  {"page": "metadata", "props": {"q": "Dandadan"}},
  {"wait": 900},
  {"eval": "frame.item.nav.current.page", "expect": "metadata"},
  {"eval": "driver.item.findItem('metadata-page').sections.length", "expect": 1},
  {"eval": "driver.item.findItem('metadata-page').sections[0].key", "expect": "complete"},
  {"eval": "driver.item.findItem('row-match') !== null", "expect": true},
  {"eval": "driver.item.findItem('row-refresh') !== null", "expect": true},
  {"log": "the Complete heading carries its sort, on Added by default"},
  {"eval": "driver.item.findItem('complete-sort') !== null", "expect": true},
  {"eval": "driver.item.findItem('metadata-page').completeSort", "expect": "Added"},
  {"log": "the state line is one short line: twelve on disk against the record's twelve"},
  {"eval": "driver.item.findItem('metadata-page').stateOf(driver.item.findItem('metadata-page').rows[0])", "expect": "12 of 12"},
  {"shot": "meta-grid-drive-01-rest"},
  {"log": "a click on a matched tile (row-match falls through to its MouseArea) opens the episodes pane, not the match panel"},
  {"click": "row-match"},
  {"wait": 500},
  {"eval": "driver.item.findItem('episodes-pane') !== null", "expect": true},
  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 1},
  {"log": "the pane shows the twelve chips, every one present, and no extras line"},
  {"eval": "driver.item.findItem('episodes-pane').expected", "expect": 12},
  {"eval": "driver.item.findItem('episodes-pane').seasonRows.length", "expect": 1},
  {"eval": "driver.item.findItem('episodes-pane').seasonRows[0].count", "expect": 12},
  {"eval": "driver.item.findItem('episodes-chip-0-12') !== null", "expect": true},
  {"eval": "driver.item.findItem('episodes-chip-0-12').present", "expect": true},
  {"eval": "driver.item.findItem('episodes-chip-0-13') === null", "expect": true},
  {"eval": "driver.item.findItem('episodes-extras') === null", "expect": true},
  {"shot": "meta-episodes-pane"},
  {"log": "Escape closes it through the escape stack"},
  {"key": "Escape"},
  {"wait": 300},
  {"eval": "driver.item.findItem('episodes-pane') === null", "expect": true},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 0},
  {"log": "a press on its shield closes it too"},
  {"click": "row-match"},
  {"wait": 500},
  {"eval": "driver.item.findItem('episodes-pane') !== null", "expect": true},
  {"click": [200, 900]},
  {"wait": 300},
  {"eval": "driver.item.findItem('episodes-pane') === null", "expect": true},
  {"log": "Change match closes the pane and opens the match panel for the same series"},
  {"click": "row-match"},
  {"wait": 500},
  {"click": "episodes-change-match"},
  {"wait": 500},
  {"eval": "driver.item.findItem('episodes-pane') === null", "expect": true},
  {"eval": "driver.item.findItem('match-panel') !== null", "expect": true},
  {"eval": "driver.item.findItem('match-panel').seriesId === driver.item.findItem('metadata-page').rows[0].series.id", "expect": true},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 1},
  {"key": "Escape"},
  {"wait": 300},
  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},
  {"log": "the Refresh glyph on the tile's foot is its own button, not the tile's click"},
  {"click": "row-refresh"},
  {"wait": 400},
  {"eval": "driver.item.findItem('episodes-pane') === null", "expect": true},
  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},
  {"log": "the sort cells are named for a drive and a pick is kept on the page"},
  {"click": "complete-sort-atoz"},
  {"wait": 300},
  {"eval": "driver.item.findItem('metadata-page').completeSort", "expect": "A to Z"},
  {"click": "complete-sort-added"},
  {"wait": 300},
  {"eval": "driver.item.findItem('metadata-page').completeSort", "expect": "Added"},
  {"log": "the tile keeps its meta-row-<id> name"},
  {"eval": "driver.item.findItem('metadata-page').rows[0].series.id", "as": "id"},
  {"eval": "driver.item.findItem('meta-row-' + vars.id) !== null", "expect": true}
]
