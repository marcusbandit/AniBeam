[
  {"log": "needs a library with a hero and a watched series (a tracker entry marked completed); the real copy has neither tracker entries nor views, so seed a scratch copy"},
  {"log": "the library opens as one packed wall, no two tiles sharing a cell"},
  {"eval": "frame.item.nav.current.page", "expect": "library"},
  {"wait": 800},
  {"eval": "driver.item.findItem('library-page').packedOverlaps()", "expect": false},
  {"eval": "driver.item.findItem('library-page').tileCount() > 0", "expect": true},
  {"eval": "driver.item.findItem('library-page').heroCount()", "as": "heroes"},
  {"shot": "mosaic-01-wall"},
  {"log": "a hero's Play reaches the player or, with nothing next, the series page"},
  {"eval": "driver.item.findItem('library-page').revealFirst('hero')", "expect": true},
  {"wait": 400},
  {"click": "hero-play"},
  {"wait": 600},
  {"eval": "['player', 'series'].indexOf(frame.item.nav.current.page) >= 0", "expect": true},
  {"shot": "mosaic-02-played"},
  {"eval": "frame.item.nav.back()"},
  {"wait": 600},
  {"eval": "frame.item.nav.current.page", "expect": "library"},
  {"log": "scroll, open a small tile, come back to the same place"},
  {"wheel": [800, 600, -240]},
  {"wait": 1500},
  {"eval": "Math.round(frame.item.leavingScroll())", "as": "scrolled"},
  {"eval": "vars.scrolled > 300", "expect": true},
  {"click": "small-tile"},
  {"wait": 500},
  {"eval": "frame.item.nav.current.page", "expect": "series"},
  {"shot": "mosaic-03-series"},
  {"key": "Alt+Left"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page", "expect": "library"},
  {"eval": "Math.abs(Math.round(frame.item.leavingScroll()) - vars.scrolled) <= 2", "expect": true},
  {"shot": "mosaic-04-back"},
  {"log": "the active sort flips its direction, and back"},
  {"eval": "driver.item.findItem('library-page').sort", "as": "sort"},
  {"eval": "driver.item.findItem('library-page').direction", "as": "dir"},
  {"eval": "driver.item.findItem('library-page').focusSearch(); 'to the top, where the header tiles are'"},
  {"key": "Escape"},
  {"wait": 300},
  {"click": "sort-Alpha"},
  {"wait": 400},
  {"eval": "driver.item.findItem('library-page').sort", "expect": "Alpha"},
  {"eval": "driver.item.findItem('library-page').direction", "as": "flipped"},
  {"click": "sort-Alpha"},
  {"wait": 400},
  {"eval": "driver.item.findItem('library-page').direction !== vars.flipped", "expect": true},
  {"eval": "var p = driver.item.findItem('library-page'); if (p.sort !== vars.sort) p.pickSort(vars.sort); if (p.direction !== vars.dir) p.flipDirection(); p.sort + ' ' + p.direction"},
  {"shot": "mosaic-05-sorted"},
  {"log": "Show watched joins the watched series back in, and out"},
  {"eval": "driver.item.findItem('library-page').tileCount()", "as": "before"},
  {"eval": "driver.item.findItem('library-page').watchedExist", "as": "anyWatched"},
  {"click": "show-watched"},
  {"wait": 800},
  {"eval": "Door.preferences.library_show_watched", "expect": true},
  {"eval": "vars.anyWatched ? driver.item.findItem('library-page').tileCount() !== vars.before : true", "expect": true},
  {"shot": "mosaic-06-watched"},
  {"click": "show-watched"},
  {"wait": 800},
  {"eval": "driver.item.findItem('library-page').tileCount() === vars.before", "expect": true},
  {"log": "search narrows the wall"},
  {"click": "library-search"},
  {"type": "zombie"},
  {"wait": 700},
  {"eval": "driver.item.findItem('library-page').tileCount() < vars.before", "expect": true},
  {"eval": "driver.item.findItem('library-page').packedOverlaps()", "expect": false},
  {"shot": "mosaic-07-search"},
  {"key": "Escape"},
  {"wait": 500},
  {"eval": "driver.item.findItem('library-page').tileCount() === vars.before", "expect": true}
]
