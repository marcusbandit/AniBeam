[
  {"log": "Needs /tmp/ob-anime: a few show folders with dummy .mkv files, e.g. Frieren/Frieren - 01.mkv. Run against an empty ANIBEAM_ROOT."},
  {"eval": "frame.item.openOnboarding(0); true"},
  {"wait": 400},
  {"shot": "ob-1-welcome"},
  {"click": "onboarding-continue"},
  {"wait": 300},
  {"shot": "ob-2-library-empty"},
  {"eval": "frame.item.onboardingPanel.addFolder('file:///tmp/ob-anime'); true"},
  {"until": "frame.item.onboardingPanel.scanJob !== null", "timeout": 20000},
  {"wait": 1500},
  {"shot": "ob-3a-library-scanning"},
  {"eval": "JSON.stringify(Door.runningJobs.map(function(j) { return j.kind + ':' + j.label }))"},
  {"until": "frame.item.onboardingPanel.shelfCards.filter(function(c) { return c.poster }).length >= 4", "timeout": 240000},
  {"wait": 1500},
  {"shot": "ob-3-library-found"},
  {"click": "onboarding-continue"},
  {"wait": 300},
  {"shot": "ob-4-list"},
  {"click": "onboarding-skip"},
  {"wait": 300},
  {"shot": "ob-5-downloads"},
  {"click": "onboarding-mode-Existing"},
  {"wait": 300},
  {"shot": "ob-6-downloads-own"},
  {"click": "onboarding-mode-Auto"},
  {"click": "onboarding-continue"},
  {"wait": 300},
  {"shot": "ob-7-ready"},
  {"click": "onboarding-continue"},
  {"wait": 800},
  {"eval": "frame.item.onboardingPanel.visible", "expect": false},
  {"shot": "ob-8-after"}
]
