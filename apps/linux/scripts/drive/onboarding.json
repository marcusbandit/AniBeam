[
  {"log": "Run against an empty ANIBEAM_ROOT. Needs OB_SHOWS: a folder of show folders with dummy .mkv files (Frieren/Frieren - 01.mkv), and OB_VIDEOS: an empty folder standing in for the videos folder. Pass both as --props '{\"shows\":\"...\",\"videos\":\"...\"}'."},
  {"eval": "Shell.firstRun(false, '', false, false)", "expect": "open"},
  {"eval": "Shell.firstRun(false, '2.3.0', false, false)", "expect": "settle"},
  {"eval": "frame.item.openOnboarding(0); true"},
  {"wait": 400},
  {"shot": "ob-1-welcome"},
  {"click": "onboarding-continue"},
  {"wait": 300},
  {"shot": "ob-2-library-empty"},
  {"eval": "frame.item.onboardingPanel.videosDir = JSON.parse(Shell.props).videos; true"},
  {"click": "onboarding-make-folder"},
  {"until": "frame.item.onboardingPanel.starterOnly", "timeout": 5000},
  {"until": "frame.item.onboardingPanel.scanJob === null && !frame.item.onboardingPanel.scanLine.startsWith('Reading')", "timeout": 30000},
  {"shot": "ob-3-library-made"},
  {"eval": "frame.item.onboardingPanel.addFolder(JSON.parse(Shell.props).shows)", "expect": true},
  {"until": "frame.item.onboardingPanel.scanJob !== null", "timeout": 20000},
  {"wait": 1500},
  {"shot": "ob-4-library-scanning"},
  {"until": "frame.item.onboardingPanel.shelfCards.filter(function(c) { return c.poster }).length >= 6", "timeout": 240000},
  {"wait": 1500},
  {"shot": "ob-5-library-found"},
  {"click": "onboarding-continue"},
  {"wait": 600},
  {"shot": "ob-6-list"},
  {"click": "onboarding-skip"},
  {"wait": 300},
  {"shot": "ob-7-downloads"},
  {"click": "onboarding-mode-Existing"},
  {"wait": 300},
  {"shot": "ob-8-downloads-own"},
  {"click": "onboarding-mode-Auto"},
  {"until": "Door.getDownloads().reply.status.settings.torrent_mode", "expect": "Auto", "timeout": 5000},
  {"click": "onboarding-add-sources"},
  {"click": "onboarding-continue"},
  {"wait": 300},
  {"shot": "ob-9-ready"},
  {"click": "onboarding-continue"},
  {"wait": 800},
  {"eval": "frame.item.onboardingPanel.visible", "expect": false},
  {"eval": "frame.item.nav.current.page", "expect": "settings"},
  {"shot": "ob-10-after"},
  {"page": "settings", "props": {"tab": "about"}},
  {"wait": 600},
  {"shot": "ob-11-about"}
]
