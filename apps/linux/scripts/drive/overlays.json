[
  {"log": "overlays: escape stack, input shields, focus. Points are for W=2560 H=1440 on a real library"},
  {"eval": "frame.item.nav.current.page", "expect": "library"},
  {"wait": 800},
  {"log": "control: with nothing open, a wheel over the page does scroll it (so the no-scroll checks below have teeth)"},
  {"wheel": [1300, 700, -360]}, {"wait": 600},
  {"eval": "frame.item.leavingScroll() > 0", "expect": true},
  {"eval": "frame.item.pageItem.scrollY = 0"}, {"wait": 300},
  {"eval": "frame.item.leavingScroll()", "expect": 0},

  {"log": "S1: a menu opened over the open drawer draws over it, and Escape closes the menu first"},
  {"key": "Ctrl+L"}, {"wait": 600},
  {"eval": "frame.item.drawerPanel.open", "expect": true},
  {"eval": "frame.item.openMenu(1300, 900, [{ text: 'Back', icon: 'arrow-left' }, { text: 'Second row' }])"},
  {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": true},
  {"eval": "frame.item.escapeStack.top().closer === frame.item.menuPanel", "expect": true},
  {"shot": "overlays-01-menu-over-drawer"},
  {"key": "Escape"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": false},
  {"eval": "frame.item.drawerPanel.open", "expect": true},

  {"log": "S8: the drawer body takes right-click and wheel; neither reaches the page"},
  {"eval": "frame.item.leavingScroll()", "as": "s0"},
  {"click": [1300, 1300], "button": "right"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": false},
  {"click": [2000, 643], "button": "right"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": false},
  {"wheel": [2000, 643, -360]}, {"wait": 600},
  {"eval": "frame.item.leavingScroll() === vars.s0", "expect": true},
  {"shot": "overlays-02-drawer"},

  {"log": "S2: Escape closes the drawer and the page gets key focus back"},
  {"eval": "window.activeFocusItem === frame.item.pageItem", "expect": false},
  {"key": "Escape"}, {"wait": 300},
  {"eval": "frame.item.drawerPanel.open", "expect": false},
  {"eval": "window.activeFocusItem === frame.item.pageItem", "expect": true},

  {"log": "frame menu: right-click opens it, Escape closes it, focus goes back"},
  {"click": [800, 400], "button": "right"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": true},
  {"shot": "overlays-03-menu"},
  {"key": "Escape"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": false},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 0},
  {"eval": "window.activeFocusItem === frame.item.pageItem", "expect": true},

  {"log": "frame menu: a press in its padding keeps it, a press outside closes it"},
  {"click": [800, 400], "button": "right"}, {"wait": 200},
  {"click": [802, 402]}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": true},
  {"click": [802, 402], "button": "right"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": true},
  {"click": [1800, 900]}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": false},
  {"click": [800, 400], "button": "right"}, {"wait": 200},
  {"click": [1800, 900], "button": "right"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": false},

  {"log": "frame menu: wheel over the open menu, or beside it, does not scroll the page"},
  {"eval": "frame.item.leavingScroll()", "as": "s1"},
  {"click": [800, 400], "button": "right"}, {"wait": 200},
  {"wheel": [830, 420, -360]}, {"wait": 600},
  {"wheel": [1800, 900, -360]}, {"wait": 600},
  {"eval": "frame.item.leavingScroll() === vars.s1", "expect": true},
  {"eval": "frame.item.menuPanel.open", "expect": true},
  {"key": "Escape"}, {"wait": 200},

  {"log": "frame menu: keyboard. Down, Down, Home, End, Up, Return picks"},
  {"eval": "vars.picked = 0; frame.item.openMenu(800, 400, [{ text: 'One', action: function() { vars.picked = 1 } }, { text: 'Two', action: function() { vars.picked = 2 } }, { text: 'Three', action: function() { vars.picked = 3 } }])"},
  {"wait": 200},
  {"eval": "driver.item.findItem('frame-menu-row-0').highlighted", "expect": false},
  {"key": "Down"}, {"wait": 50},
  {"eval": "driver.item.findItem('frame-menu-row-0').highlighted", "expect": true},
