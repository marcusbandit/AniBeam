  {"wheel": [300, 700, -360]}, {"wait": 600},
  {"eval": "frame.item.leavingScroll() === vars.s2", "expect": true},
  {"hover": "tile-18"}, {"wait": 1200},
  {"eval": "frame.item.tipShown", "expect": false},
  {"eval": "vars.tipBare", "expect": true},
  {"click": [10, 10]}, {"wait": 200},
  {"eval": "frame.item.sheetPanel.visible", "expect": false},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 0},

