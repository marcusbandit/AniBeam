  {"eval": "frame.item.menuPanel.open", "expect": false},
  {"eval": "window.activeFocusItem === frame.item.pageItem", "expect": true},

  {"log": "frame menu: the clamps never go negative"},
  {"eval": "frame.item.openMenu(-500, -500, [{ text: 'Back' }])"}, {"wait": 100},
  {"eval": "(function() { var p = driver.item.findItem('frame-menu-panel'); return p.x >= 0 && p.y >= 0 })()", "expect": true},
  {"key": "Escape"}, {"wait": 100},

  {"log": "S7: Escape in the search field with a menu open closes the menu and keeps the query"},
  {"key": "/"}, {"wait": 200},
  {"type": "abc"}, {"wait": 200},
  {"eval": "frame.item.openMenu(800, 400, [{ text: 'Back' }])"}, {"wait": 100},
  {"eval": "frame.item.pageItem.focusSearch()"}, {"wait": 100},
  {"key": "Escape"}, {"wait": 200},
  {"eval": "frame.item.menuPanel.open", "expect": false},
  {"eval": "driver.item.findItem('library-search').text", "expect": "abc"},
  {"log": "with nothing open, Escape clears it as before"},
  {"key": "Escape"}, {"wait": 600},
  {"eval": "driver.item.findItem('library-search').text", "expect": ""},

