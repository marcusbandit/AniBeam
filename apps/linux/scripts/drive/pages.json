  {"shot": "pages-05b-match-panel-tvmaze"},
  {"click": "match-provider-anilist"},
  {"wait": 300},
  {"eval": "driver.item.findItem('match-search').placeholder", "expect": "Search AniList"},
  {"log": "a click inside the panel leaves it open"},
