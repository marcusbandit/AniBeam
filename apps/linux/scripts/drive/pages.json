[
  {"log": "the series page: a bento, Continue plays, an episode row plays, back returns"},
  {"page": "series", "props": {"id": 1}},
  {"wait": 900},
  {"eval": "frame.item.nav.current.page", "expect": "series"},
  {"eval": "driver.item.findItem('series-back') !== null", "expect": true},
  {"eval": "driver.item.findItem('series-continue') !== null", "expect": true},
  {"shot": "pages-01-series"},
