  {"eval": "frame.item.nav.back()"},
  {"wait": 900},
  {"eval": "frame.item.nav.current.page", "expect": "series"},
  {"click": "episode-row-0"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page", "expect": "player"},
  {"eval": "frame.item.nav.back()"},
  {"wait": 900},
  {"eval": "frame.item.nav.current.page", "expect": "series"},
  {"log": "the score fact opens the picker; Escape closes it"},
  {"click": "fact-mine"},
  {"wait": 300},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 1},
  {"key": "Escape"},
  {"wait": 300},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 0},
  {"log": "the back tile returns along the trail"},
  {"click": "series-back"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page !== 'series'", "expect": true},

  {"log": "a film opens on the same bento"},
  {"page": "series", "props": {"id": 24}},
  {"wait": 900},
  {"eval": "driver.item.findItem('series-continue') !== null", "expect": true},
  {"shot": "pages-03-film"},

  {"log": "metadata: the wall, the match panel and its shield"},
