  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},
  {"eval": "frame.item.escapeStack.entries.length", "expect": 0},
  {"log": "a press on the shield closes it too"},
  {"click": "row-match"},
  {"wait": 500},
  {"eval": "driver.item.findItem('match-panel') !== null", "expect": true},
  {"click": [200, 900]},
  {"wait": 300},
  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},
  {"log": "Refresh on a row is its own button, not the row's match click"},
  {"click": "row-refresh"},
  {"wait": 400},
  {"eval": "driver.item.findItem('match-panel') === null", "expect": true},

