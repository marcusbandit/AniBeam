[
  {"log": "the mosaic walls (Feed, Watching, Subscriptions): Back restores the wall's own scroll, not a shadow property"},
  {"click": "rail-feed"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page", "expect": "feed"},
  {"shot": "walls-01-feed"},
  {"wheel": [1600, 900, -240]},
  {"wait": 1500},
  {"eval": "Math.round(frame.item.leavingScroll())", "as": "scrolled"},
  {"eval": "vars.scrolled > 300", "expect": true},
  {"eval": "Math.round(driver.item.findItem('wall-flick').contentY) === vars.scrolled", "expect": true},
  {"click": "small-tile"},
  {"wait": 500},
  {"eval": "frame.item.nav.current.page", "expect": "series"},
  {"key": "Alt+Left"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page", "expect": "feed"},
  {"eval": "Math.abs(Math.round(driver.item.findItem('wall-flick').contentY) - vars.scrolled) <= 2", "expect": true},
  {"shot": "walls-02-feed-back"},

  {"log": "Coming soon: the scheduled head as its own labelled section"},
  {"click": "feed-sort-upcoming"},
  {"wait": 600},
  {"shot": "walls-03-feed-upcoming"},
  {"click": "feed-sort-recent"},
  {"wait": 600},

  {"log": "Watching: a scroll position survives a trip away and Back"},
  {"click": "rail-watching"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page", "expect": "watching"},
  {"shot": "walls-04-watching"},
  {"eval": "driver.item.findItem('watching-page').scrollY = 37; Math.round(frame.item.leavingScroll())", "expect": 37},
  {"click": "rail-settings"},
  {"wait": 600},
  {"key": "Alt+Left"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page", "expect": "watching"},
  {"eval": "Math.round(driver.item.findItem('wall-flick').contentY)", "expect": 37},

  {"log": "Subscriptions: the same"},
  {"eval": "frame.item.go('subscriptions'); 'go'"},
  {"wait": 1000},
  {"eval": "frame.item.nav.current.page", "expect": "subscriptions"},
  {"shot": "walls-05-subscriptions"},
  {"eval": "driver.item.findItem('subscriptions-page').scrollY = 41; Math.round(frame.item.leavingScroll())", "expect": 41},
  {"click": "rail-settings"},
  {"wait": 600},
  {"key": "Alt+Left"},
  {"wait": 800},
  {"eval": "frame.item.nav.current.page", "expect": "subscriptions"},
  {"eval": "Math.round(driver.item.findItem('wall-flick').contentY)", "expect": 41}
]
