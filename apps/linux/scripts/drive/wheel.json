[
  {"log": "one wheel notch over the library glides three base steps (~360 px)"},
  {"eval": "frame.item.nav.current.page", "expect": "library"},
  {"wait": 500},
  {"wheel": [1200, 700, -120]},
  {"wait": 1500},
  {"eval": "Math.round(frame.item.leavingScroll())", "as": "one"},
  {"eval": "vars.one > 300 && vars.one < 420", "expect": true},
  {"log": "a second notch goes as far again"},
  {"wheel": [1200, 700, -120]},
  {"wait": 1500},
  {"eval": "Math.round(frame.item.leavingScroll()) - vars.one > 300", "expect": true},
  {"shot": "wheel-after"}
]
