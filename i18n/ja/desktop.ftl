## Readouts (apps/linux/src/format.rs): times, countdowns and lengths

fmt-just-now = たった今
fmt-now = 今
fmt-ago = { $span }前
fmt-in = { $span }後
fmt-seconds-short = { $n }秒
fmt-minutes-short = { $n }分
fmt-hours-short = { $n }時間
fmt-days-short = { $n }日
fmt-months-short = { $n }か月
fmt-years-short = { $n }年
